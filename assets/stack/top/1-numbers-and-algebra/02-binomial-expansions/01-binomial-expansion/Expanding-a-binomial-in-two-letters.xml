<quiz>
<question type="stack">
  <name><text>Expanding a binomial in two letters</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>Expand \({@brs@}\).</p><div>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>The pattern of \((a + b)^{@n@}\) holds whatever \(a\) and \(b\) are. The coefficients for power \({@n@}\) are {@crow@}. Put \(a = {@px@}\) and \(b = {@qy@}\) into each term, with brackets:</p><p>\[{@patt@}\]</p><p>Working out each term gives \({@tad@}\).</p><p>Check: putting \(x = y = 1\) gives \(({@p1q@})^{@n@} = {@chk@}\) on both sides.</p>]]></text>
  </generalfeedback>
  <defaultgrade>1</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_xy(ex) := if every(lambda([v], member(v,[x,y])), listofvars(ex)) then "" else "Use only the letters x and y.";
/* Design: expand a binomial in two letters. Source: original (compare SMP AS/A2 Core 2, Chapter 5, Section A). */
L: [[2,1,3],[1,-2,4],[3,-1,3],[1,3,3],[2,-1,4],[3,2,3],[1,-3,4],[2,3,3],[3,-2,3],[1,2,4]];
ix: 1+rand(10);
p: L[ix][1];
q: L[ix][2];
n: L[ix][3];
np1: n+1;
ta: expand((p*x+q*y)^n);
fresh: p^n*x^n+q^n*y^n;
notpow: sum(binomial(n,r)*(if r<n then p else 1)*(if r>0 then q else 1)*x^(n-r)*y^r,r,0,n);
flip: expand((p*x-q*y)^n);
chk: (p+q)^n;
crow: if n=3 then "1, 3, 3, 1" else "1, 4, 6, 4, 1";
px: p*x; qy: q*y; pxqy: p*x+q*y;
q2y2: q^2*y^2; qy2: q*y^2;
/* example for the "not powered" feedback. With q = 1 the y term shows nothing ((y)^2 = y^2), so the x term is used. */
npb: if q=1 then p*x else q*y; npr: if q=1 then p^2*x^2 else q^2*y^2; npw: if q=1 then p*x^2 else q*y^2;
p1q: p+q;
pxs: if p=1 then "x" else sconcat(p,"x");
qys: if q=1 then "y" else if q=-1 then "-y" else sconcat(q,"y");
brs: sconcat("\\left(",pxs,if q>0 then "+" else "",qys,"\\right)^{",n,"}");
bpw(s,k) := if k=0 then "" else if s="x" or s="y" then (if k=1 then s else sconcat(s,"^{",k,"}")) else if k=1 then sconcat("\\left(",s,"\\right)") else sconcat("\\left(",s,"\\right)^{",k,"}");
patt: simplode(makelist(sconcat(if r=0 or r=n then "" else string(binomial(n,r)),bpw(pxs,n-r),bpw(qys,r)),r,0,n)," + ");
xymon(i,j) := sconcat(if i=0 then "" else if i=1 then "x" else sconcat("x^{",i,"}"), if j=0 then "" else if j=1 then "y" else sconcat("y^{",j,"}"));
tad: simplode(makelist(block([c], c: binomial(n,r)*p^(n-r)*q^r, sconcat(if r=0 then (if c<0 then "-" else "") else (if c<0 then " - " else " + "), if abs(c)=1 then "" else string(abs(c)), xymon(n-r,r))),r,0,n),"");]]></text>
  </questionvariables>
