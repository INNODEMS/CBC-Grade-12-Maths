  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_x(ex) := if every(lambda([v], is(v=x)), listofvars(ex)) then "" else "Use only the letter x.";
/* Design: expand small powers of a binomial. Source: adapted from SMP AS/A2 Core 2, Chapter 5, Exercise A, question 1. */
L: [[3,2],[4,-3],[3,-4],[4,5],[3,7],[4,-2],[3,-3],[4,3],[4,-5],[3,-2]];
ix: 1+rand(10);
n: L[ix][1];
b: L[ix][2];
ta: expand((x+b)^n);
fresh: x^n+b^n;
nocoef: sum(b^r*x^(n-r),r,0,n);
flip: expand((x-b)^n);
chk: (1+b)^n;
crow: if n=3 then "1, 3, 3, 1" else "1, 4, 6, 4, 1";
br: x+b;
brn: (x+b)^n;
sq: expand((x+b)^2);
cu: expand((x+b)^3);
t2: 2*b*x;
b2: b^2;
t3: 3*b*x^2;
t4: 3*b^2*x;
b3: b^3;]]></text>
  </questionvariables>
