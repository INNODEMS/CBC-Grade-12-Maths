  <questionvariables>
    <text><![CDATA[/* Design: area of a plot from a map grid: count squares, then use a ratio scale (1 cm stands for S cm). Entries [place, S, F, P]. No entry has a hectare value whose third decimal is 5 (both roundings would pass the 0.00501 tolerance). Source: adapted from SMP GCSE Foundation 2, Chapter 21, Section A, combined with counting squares. */
L: [[0,1000,32,18],[1,2000,24,14],[2,5000,38,22],[3,12000,27,19],[4,30000,41,24],[5,4000,30,21],[6,10000,45,26],[0,1500,28,23],[1,2000,35,17],[2,6000,29,25]];
ix: 1+rand(10);
pl: L[ix][1]; S: L[ix][2]; F: L[ix][3]; P: L[ix][4];
nm: rand(["Wafula","Achieng","Kiprono","Wanjiku"]);
est: F+P/2;
side: S/100;
sq: side^2;
ha: est*sq/10000;
ha2: floor(100*ha+1/2)/100;
/* diagnostics */
eFP: F+P; eF: F; eH: (F+P)/2;
sS: S; s1000: S/1000; s10: S/10;
qside: side; qper: 4*side; q2: 2*side;
hm2: est*sq; h1000: est*sq/1000; h100: est*sq/100; hside: est*side/10000; hpart: (F+P)*sq/10000;
g3(v) := block([q,r], if v < 1000 then string(v) else (q: floor(v/1000), r: v - 1000*q, sconcat(g3(q), "\\,", if r < 10 then "00" elseif r < 100 then "0" else "", string(r))));
thou(v) := if v < 10000 then string(v) else g3(v);
Sd: thou(S); sqd: thou(sq); hm2d: thou(hm2);]]></text>
  </questionvariables>
