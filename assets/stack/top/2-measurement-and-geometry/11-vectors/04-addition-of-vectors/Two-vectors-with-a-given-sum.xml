  <input><name>ans2</name><type>matrix</type><tans>q1t</tans><boxsize>3</boxsize><strictsyntax>1</strictsyntax><insertstars>0</insertstars><syntaxhint></syntaxhint><syntaxattribute>0</syntaxattribute><forbidwords></forbidwords><allowwords></allowwords><forbidfloat>0</forbidfloat><requirelowestterms>0</requirelowestterms><checkanswertype>0</checkanswertype><mustverify>0</mustverify><showvalidation>3</showvalidation><options>validator:validate_numeric</options></input>

  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[Pv: float([ans1[1,1], ans1[2,1]]); Qv: float([ans2[1,1], ans2[2,1]]);
zz(v) := is(abs(v[1]) < 10^-9 and abs(v[2]) < 10^-9);
sumok: zz(Pv+Qv-cv);
nz: is(abs(Pv[1]) > 10^-9 and abs(Pv[2]) > 10^-9 and abs(Qv[1]) > 10^-9 and abs(Qv[2]) > 10^-9);
subok: is(zz(Pv-Qv-cv) or zz(Qv-Pv-cv));
sm: ev(ans1+ans2, simp);
/* the example pair must not be the learner's own pair (1, 1) with c - (1, 1) */
zown: zz(Pv-[1,1]) or zz(Qv-[1,1]);
zq: if zown then matrix([-1],[-1]) else q1t; zp: if zown then col([c1+1,c2+1]) else p1t;
]]></text></feedbackvariables>
