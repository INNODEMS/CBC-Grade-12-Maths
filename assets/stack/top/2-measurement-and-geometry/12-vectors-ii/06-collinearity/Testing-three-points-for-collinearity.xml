<quiz>
<question type="stack">
  <name><text>Testing three points for collinearity</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>\(A({@A[1]@},\,{@A[2]@},\,{@A[3]@})\), \(B({@B[1]@},\,{@B[2]@},\,{@B[3]@})\) and \(C({@C[1]@},\,{@C[2]@},\,{@C[3]@})\).</p><div>(a) \(\overrightarrow{AB} =\) [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><div>(b) \(\overrightarrow{BC} =\) [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]</div><p>(c) Choose the correct statement.</p><div>[[input:ans3]] [[validation:ans3]] [[feedback:prt3]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>(a) \(\overrightarrow{AB} = \mathbf{b} - \mathbf{a} = {@tAB@}\). (b) \(\overrightarrow{BC} = \mathbf{c} - \mathbf{b} = {@vBC@}\).</p><p>(c) Divide each component of \(\overrightarrow{BC}\) by the matching component of \(\overrightarrow{AB}\): \({@rt[1]@}\), \({@rt[2]@}\), \({@rt[3]@}\). [[if test="is(flag = 1)"]]They are all \({@kc@}\), so \(\overrightarrow{BC} = [[if test="is(kc = 1)"]][[else]][[if test="is(kc = -1)"]]-[[else]]{@kc@}[[/if]][[/if]]\,\overrightarrow{AB}\). The vectors are parallel and share the point B, so A, B and C are collinear.[[else]]They are not all equal, so \(\overrightarrow{BC}\) is not a multiple of \(\overrightarrow{AB}\) and A, B and C are not collinear.[[/if]]</p>]]></text>
  </generalfeedback>
  <defaultgrade>3</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Type a number in each box, not a letter.");
cv3(v) := matrix([v[1]],[v[2]],[v[3]]);
e1: matrix([1],[0],[0]); badm: matrix([q],[1],[2]);
/* Design: testing three points for collinearity; five collinear (BC = k AB, k in {2, 3, -1, 1/2, -2}) and five not, alternating. Source: adapted from SMP AS/A2 Core 4, Chapter 9, Exercise D, Q7. */
clist: [[[4,1,-1],[2,3,-5],[6,-1,3],1],[[1,-1,0],[-2,-2,2],[3,0,-2],0],[[-1,-3,-3],[-2,0,-5],[-4,6,-9],1],[[-4,-2,0],[-2,1,-1],[-4,-3,0],0],[[-1,-2,1],[2,2,4],[-4,-6,-2],1],[[2,-4,-1],[4,0,-3],[8,7,-7],0],[[-1,5,4],[-5,9,3],[-13,17,1],1],[[4,-4,0],[0,-3,-1],[4,-4,-1],0],[[-4,-2,2],[-1,-3,3],[5,-5,5],1],[[2,3,5],[3,7,2],[2,3,6],0]];
ix: 1+rand(10);
A: clist[ix][1]; B: clist[ix][2]; C: clist[ix][3]; flag: clist[ix][4];
tAB: cv3(B-A); vBC: cv3(C-B); rAB: cv3(A-B); rBC: cv3(B-C);
kc: (C[1]-B[1])/(B[1]-A[1]);
rt: [(C[1]-B[1])/(B[1]-A[1]), (C[2]-B[2])/(B[2]-A[2]), (C[3]-B[3])/(B[3]-A[3])];
opts: [["draw", false, "You cannot tell without drawing the points accurately."], ["col", is(flag=1), "A, B and C are collinear: BC is a multiple of AB and they share the point B."], ["not", is(flag=0), "A, B and C are not collinear: BC is not a multiple of AB."]];
ta3: first(mcq_correct(opts));
wr3: if flag = 1 then "not" else "col";
wAB: tAB+e1; wBC: vBC+e1;
]]></text>
  </questionvariables>
  <specificfeedback format="html"><text><![CDATA[]]></text></specificfeedback>
