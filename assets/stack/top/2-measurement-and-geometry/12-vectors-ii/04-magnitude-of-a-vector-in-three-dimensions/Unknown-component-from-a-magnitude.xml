  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[L: map(lambda([t], floor(1000*t+1/2)/1000), [ans1, ans2]);
SL: setify(L);
one: is(length(SL) = 1 and subsetp(SL, roots));
half: is(length(intersection(SL, roots)) = 1);
gd: if half then first(listify(intersection(SL, roots))) else 0;
]]></text></feedbackvariables>
