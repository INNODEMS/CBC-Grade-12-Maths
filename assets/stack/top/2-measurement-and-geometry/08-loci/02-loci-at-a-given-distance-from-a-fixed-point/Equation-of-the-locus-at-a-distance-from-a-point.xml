  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[dsx: sconcat("(x",sg(-a),")^2");
/* a point of the true locus that the learner's equation misses (polynomial equations only, so the substitution cannot fail) */
dfe: lhs(ans1)-rhs(ans1);
pol: polynomialp(dfe, [x,y]);
tpl: [[a+r,b],[a-r,b],[a,b+r],[a,b-r]];
fl: if pol then sublist(tpl, lambda([q], is(ev(subst([x=q[1],y=q[2]], dfe), simp)#0))) else [];
tst: is(length(fl)>0);
tp0: if tst then first(fl) else tpl[1];
lv0: if tst then ev(subst([x=tp0[1],y=tp0[2]], lhs(ans1)), simp) else 0;
rv0: if tst then ev(subst([x=tp0[1],y=tp0[2]], rhs(ans1)), simp) else 0;]]></text></feedbackvariables>
    <node><name>0</name><description>Equation of the circle</description><answertest>AlgEquiv</answertest><sans>ans1</sans><tans>ta1</tans><testoptions></testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>1.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-1-T</trueanswernote><truefeedback format="html"><text><![CDATA[]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>1</falsenextnode><falseanswernote>prt1-1-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>1</name><description>Radius not squared</description><answertest>AlgEquiv</answertest><sans>ans1</sans><tans>dr</tans><testoptions></testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-2-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>Your equation is a circle with centre \(({@a@}, {@b@})\), but its radius is [[if test="integerp(sqrt(r))"]]\(\sqrt{ {@r@} } = {@sqrt(r)@}\)[[else]]\(\sqrt{ {@r@} }\), about \({@dispdp(float(floor(10^1*(sqrt(r))+1/2)/10^1),1)@}\)[[/if]], not \({@r@}\). The right-hand side of the equation is the square of the distance, not the distance.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>2</falsenextnode><falseanswernote>prt1-2-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
