    <text><![CDATA[plist: [[0,22,17,9],[1,3.8,3.1,2],[2,6,7,9],[3,6.4,3.6,2.4],[0,17,11,23],[1,5.9,6.6,3.2],[2,6,13,5],[3,7.8,4.8,2.6],[0,14,15,16],[1,7.1,8,2.8]];
/* Design: base diagonal, sloping edge and slant height of a pyramid with a rectangular base. OA, VA and VM are distinct on every entry. Source: adapted from SMP GCSE Higher 2, Chapter 34, B12, and SMP Book 5 (Metric), Chapter 7, section 2. */
CT: [["A model pyramid","cm"],["The roof of a gazebo","m"],["A paperweight","cm"],["A tent","m"]];
ix: 1+rand(10); PP: plist[ix];
ctx: CT[PP[1]+1][1]; un: CT[PP[1]+1][2]; ll: PP[2]; ww: PP[3]; hh: PP[4];
LS: "ABCDVOMN"; LT: [[0,0,0],[ll,0,0],[ll,ww,0],[0,ww,0],[ll/2,ww/2,hh],[ll/2,ww/2,0],[ll,ww/2,0],[ll/2,0,0]];
pt(c) := LT[ssearch(c, LS)];
vv(s) := pt(charat(s,2)) - pt(charat(s,1));
sq(s) := vv(s) . vv(s);
dst(s) := float(sqrt(sq(s)));
angd(s) := block([u,w], u: pt(charat(s,1))-pt(charat(s,2)), w: pt(charat(s,3))-pt(charat(s,2)), float(acos((u . w)/sqrt((u . u)*(w . w)))*180/%pi));
r1(v) := float(floor(10*v+1/2)/10); r2(v) := float(floor(100*v+1/2)/100);
d1(v) := dispdp(r1(v),1); d2(v) := dispdp(r2(v),2); d4(v) := dispdp(float(floor(10000*v+1/2)/10000),4);
NA: -999; NB: -888; NC: -777;
nf(v) := if integerp(v) then v else float(v);
r4(v) := float(floor(10000*v+1/2)/10000);
SA: r4(sq("OA")); SV: r4(sq("VA")); SM: r4(sq("VM")); SC: r4(sq("AC"));
OA: dst("OA"); VA: dst("VA"); VM: dst("VM"); AC: dst("AC"); VN: dst("VN");
hl: nf(ll/2); hw: nf(ww/2);
b1: float(sqrt(AC^2+hh^2)); b4: OA+hh; c3: float(sqrt(ll^2+hh^2));
OAr: r2(OA); VAr: r2(VA); VMr: r2(VM); OAa: OA+0.02; VAa: VA+0.02; VMa: VM+0.02; VMg: VM+0.5; OAg: OA+0.5;
fa: OA+1; fb: float(sqrt(fa^2+hh^2));
]]></text>
