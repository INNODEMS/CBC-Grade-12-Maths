  <questionvariables>
    <text><![CDATA[/* Design: two dice, a conclusion and a reason. sw 0: die B is biased; sw 1: die A is biased. Curated tables. Source: adapted from SMP GCSE Foundation book 2, chapter 5, section C, C4. */
L: [[120,[18,19,22,20,19,22],[16,14,38,16,16,20],3,0],[180,[27,29,32,29,31,32],[60,26,21,22,21,30],1,1],[240,[37,43,37,43,44,36],[32,29,75,32,32,40],3,1],[300,[46,46,53,54,52,49],[40,35,42,100,41,42],4,0],[360,[59,56,61,63,58,63],[49,110,55,55,44,47],2,1],[600,[92,106,99,110,92,101],[194,88,74,71,85,88],1,0],[120,[22,21,20,19,19,19],[17,16,37,15,16,19],3,0],[240,[38,38,42,41,44,37],[29,72,31,37,29,42],2,1],[300,[47,52,54,48,51,48],[45,41,40,45,30,99],6,1],[600,[89,107,87,105,100,112],[89,75,85,78,93,180],6,0]];
ix: 1+rand(10);
nr: L[ix][1]; fair: L[ix][2]; bias: L[ix][3]; bf: L[ix][4]; sw: L[ix][5];
fA: if sw=0 then fair else bias;
fB: if sw=0 then bias else fair;
E: nr/6;
kb: if sw=1 then "dA" else "dB";
ko: if sw=1 then "dB" else "dA";
opts2: [["d0",false,"Neither: both sets of results are close to what a fair die gives."],["dA",is(sw=1),"Die A"],["dB",is(sw=0),"Die B"]];
opts3: [["r0",false,sconcat("A fair die gives exactly ",string(E)," of each score in ",string(nr)," rolls.")],["r1",true,sconcat("On that die one score came up about twice as often as expected, while every frequency of the other die is close to ",string(E),".")],["r2",false,sconcat("The frequencies of that die add up to more than ",string(nr),".")]];]]></text>
  </questionvariables>
