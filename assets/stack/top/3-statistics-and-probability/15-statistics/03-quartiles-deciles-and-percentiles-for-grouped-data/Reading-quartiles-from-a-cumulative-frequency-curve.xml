  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: quartiles and IQR from the graph. Continuous classes from a, width 10; n is 60 or 80, so every quartile position is on a grid line. prt3 (Q3) has no diagnostic node: 3n/4 as a time collides with Q3 on one list, and reading across from 75 is impossible when n = 60. Source: adapted from SMP AS/A2 Statistics 1, chapter 1, section D, D1. */
P: [[[11,21,16,14,13,5],20],[[8,8,8,14,19,3],10],[[8,9,12,20,17,14],20],[[2,5,11,18,21,23],30],[[3,22,16,16,15,8],30],[[3,11,18,10,10,8],30],[[7,9,18,23,17,6],30],[[5,6,14,15,14,6],20],[[12,19,21,14,12,2],0],[[11,14,18,21,13,3],30]];
ix: 1+rand(10);
f: P[ix][1];
a: P[ix][2];
w: 10;
L1: a;
cf: makelist(sum(f[i],i,1,t),t,1,length(f));
n: last(cf);
lcb: makelist(L1+(t-1)*w,t,1,length(f));
cb(p) := 1+length(sublist(cf,lambda([c],is(c<p))));
cfb(k) := if k=1 then 0 else cf[k-1];
gq(p) := lcb[cb(p)] + (p-cfb(cb(p)))/f[cb(p)]*w;
jx: makelist(a+10*t,t,0,6);
jy: append([0],cf);
xmin: if a=0 then 0 else a-10;
xmax: a+60;
dy: n/20;
cfat(v) := block([kk], kk: 1+floor((v-a)/10), cfb(kk)+(v-lcb[kk])/10*f[kk]);
q1: gq(n/4);
med: gq(n/2);
q3: gq(3*n/4);
iqr: q3-q1;
qd: iqr/2;
q1d: dispdp(float(floor(10^1*(q1)+1/2)/10^1),1);
medd: dispdp(float(floor(10^1*(med)+1/2)/10^1),1);
q3d: dispdp(float(floor(10^1*(q3)+1/2)/10^1),1);
iqrd: dispdp(float(floor(10^1*(iqr)+1/2)/10^1),1);
qdd: dispdp(float(floor(10^1*(qd)+1/2)/10^1),1);
/* diagnostics */
q1at25: gq(25); q1cf: n/4;
medat50: gq(50); medcf: n/2;
iqrcf: n/2; iqrsum: q3+q1;
qdiqr: q3-q1; qdavg: (q3+q1)/2;
/* test values */
r0(v) := float(floor(v+1/2));
q3m: q3-3;
ftq: q3-3-q1;
iqrw: -iqr-5;]]></text>
  </questionvariables>
