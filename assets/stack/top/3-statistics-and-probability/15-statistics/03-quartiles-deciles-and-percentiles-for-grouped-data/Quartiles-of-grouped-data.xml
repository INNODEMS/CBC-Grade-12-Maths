  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: all three quartiles of grouped data. Quartile classes are 2 to 5, and no cf equals a position. Source: adapted from SMP AS/A2 Statistics 1, chapter 1, Exercise C question 3. */
flist: [[4,9,15,18,10,9],[5,12,16,19,20,6],[3,11,13,11,7,4],[6,7,8,19,9,5],[5,19,20,12,11,3],[8,9,10,15,19,14],[16,12,11,10,10,6],[11,17,10,9,6,6],[14,13,12,12,12,4],[8,8,14,13,11,9]];
ix: 1+rand(10);
f: flist[ix];
lo1: rand([10,20,30]);
w: 10;
L1: lo1-1/2;
cf: makelist(sum(f[i],i,1,t),t,1,length(f));
n: last(cf);
lcb: makelist(L1+(t-1)*w,t,1,length(f));
cb(p) := 1+length(sublist(cf,lambda([c],is(c<p))));
cfb(k) := if k=1 then 0 else cf[k-1];
gq(p) := lcb[cb(p)] + (p-cfb(cb(p)))/f[cb(p)]*w;
lo: makelist(lo1+(t-1)*w,t,1,6);
hi: makelist(lo1+t*w-1,t,1,6);
p1: n/4;
p3: 3*n/4;
k1: cb(p1);
k3: cb(p3);
q1: gq(p1);
q3: gq(p3);
CF1: cfb(k1); F1: f[k1]; cfq1: cf[k1];
CF3: cfb(k3); F3: f[k3]; cfq3: cf[k3];
q1d: dispdp(float(floor(10^1*(q1)+1/2)/10^1),1);
q3d: dispdp(float(floor(10^1*(q3)+1/2)/10^1),1);
/* diagnostics */
p1n: (n+1)/4;
p3n: 3*(n+1)/4;
q1lim: q1+1/2; q1n1: gq(p1n); q1own: q1-w;
q3lim: q3+1/2; q3n1: gq(p3n); q3own: q3-w;
/* test values */
q1r: float(floor(10^1*(q1)+1/2)/10^1);
q3r: float(floor(10^1*(q3)+1/2)/10^1);
p1o: p1+1; p3o: p3+1;
q1o: q1r+1; q3o: q3r+1;
q1limr: float(floor(10^1*(q1lim)+1/2)/10^1);
q3limr: float(floor(10^1*(q3lim)+1/2)/10^1);
q1n1r: float(floor(10^1*(q1n1)+1/2)/10^1);
q3n1r: float(floor(10^1*(q3n1)+1/2)/10^1);
q1ownr: float(floor(10^1*(q1own)+1/2)/10^1);
q3ownr: float(floor(10^1*(q3own)+1/2)/10^1);]]></text>
