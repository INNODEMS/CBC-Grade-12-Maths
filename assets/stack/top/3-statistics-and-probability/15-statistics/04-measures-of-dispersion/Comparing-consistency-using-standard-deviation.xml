  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: compare data sets using measures, with radio buttons. Times stored in tenths of a second. The first set is always the consistent runner (sigma less than half the other's); case = 1 when the consistent runner is slower on average, so a lower mean never tracks the answer. With three radio options, the false branch of node 2 in prt3 and prt4 can only be the third option, so that leaf carries its feedback. Source: adapted from SMP AS/A2 Statistics 1, chapter 2, section F. */
P: [[[541,544,543,546,546,541],[551,554,555,549,552,534],0],[[519,521,526,520,519,526],[530,532,525,533,534,511],0],[[556,556,557,559,557,559],[545,545,566,564,562,545],1],[[509,509,508,508,513,514],[523,505,524,501,519,503],0],[[533,535,529,532,533,537],[536,532,527,527,524,544],1],[[553,553,553,560,554,555],[554,543,563,559,570,553],0],[[544,544,548,543,549,545],[559,531,537,553,544,540],1],[[557,562,561,559,561,562],[570,564,567,556,547,565],0],[[522,529,521,528,525,524],[528,511,514,513,533,518],1],[[507,509,515,507,515,512],[523,506,520,497,501,507],1]];
ix: 1+rand(10);
sw: rand(2);
cs: P[ix][3];
nms: rand([["Chebet","Kiprop"],["Jepkosgei","Rotich"],["Wanjiru","Kamau"]]);
nm1: nms[1];
nm2: nms[2];
t1: (if sw=0 then P[ix][1] else P[ix][2])/10;
t2: (if sw=0 then P[ix][2] else P[ix][1])/10;
m1: apply("+",t1)/6;
m2: apply("+",t2)/6;
S1: sum((t1[i]-m1)^2,i,1,6);
S2: sum((t2[i]-m2)^2,i,1,6);
vr1: S1/6; vr2: S2/6;
sd1: sqrt(vr1); sd2: sqrt(vr2);
t1d: makelist(dispdp(float(t1[i]),1),i,1,6);
t2d: makelist(dispdp(float(t2[i]),1),i,1,6);
m1d: dispdp(float(floor(10^2*(m1)+1/2)/10^2),2);
m2d: dispdp(float(floor(10^2*(m2)+1/2)/10^2),2);
dd4(v) := if integerp(1000*v) then exd(v) else dispdp(float(floor(10^4*v+1/2)/10^4),4);
vr1d: dd4(vr1);
vr2d: dd4(vr2);
sd1d: dispdp(float(floor(10^2*(sd1)+1/2)/10^2),2);
sd2d: dispdp(float(floor(10^2*(sd2)+1/2)/10^2),2);
opts3: [["c0",false,"They are equally consistent."],["c1",is(sw=0),nm1],["c2",is(sw=1),nm2]];
opts4: [["r0",false,"A lower mean time means the times are more consistent."],["r1",true,"A smaller standard deviation means the times stay closer to the runner's own mean."],["r2",false,"A larger standard deviation means the times are more consistent."]];
lc: if sw=0 then "c2" else "c1";
cnm: if sw=0 then nm1 else nm2;
/* diagnostics */
sdn11: sqrt(S1/5); sdn12: sqrt(S2/5);
/* test values */
sd1r: float(floor(10^2*(sd1)+1/2)/10^2);
sd2r: float(floor(10^2*(sd2)+1/2)/10^2);
sdn11r: float(floor(10^2*(sdn11)+1/2)/10^2);
sdn12r: float(floor(10^2*(sdn12)+1/2)/10^2);
vr1r: float(floor(10^2*(vr1)+1/2)/10^2);
vr2r: float(floor(10^2*(vr2)+1/2)/10^2);
dsp1: dd4(S1);
dsp2: dd4(S2);]]></text>
