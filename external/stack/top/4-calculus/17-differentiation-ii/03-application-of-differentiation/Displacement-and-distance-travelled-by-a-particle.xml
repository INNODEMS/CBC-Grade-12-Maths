  <questionvariables>
    <text><![CDATA[/* Design: distance travelled against final displacement when the direction reverses, as a calculus model with two reversals. Source: adapted from SMP AS/A2 Mechanics 1, chapter 1, section A, A5. */
L: [[1,1,5,6],[2,1,4,5],[1,2,6,7],[2,2,5,6],[1,1,7,8],[2,1,5,6],[1,3,7,8],[2,2,6,7],[2,1,6,7],[2,3,6,7]];
ix: 1+rand(10);
a0: L[ix][1]; p0: L[ix][2]; q0: L[ix][3]; T0: L[ix][4];
s: expand((a0)*t^3-3*(a0)*((p0)+(q0))/2*t^2+3*(a0)*(p0)*(q0)*t+(0));
v: diff(s,t);
sp: ev(s,t=p0); sq: ev(s,t=q0); sT: ev(s,t=T0);
dist: abs(sp)+abs(sq-sp)+abs(sT-sq);
tm: (p0+q0)/2; vT: ev(v,t=T0);
dabs: abs(sT); one: abs(sp)+abs(sT-sp); sab: abs(sp)+abs(sq)+abs(sT);
yr: max(sp,sT,0)-min(0,sq); yl: min(0,sq)-yr/5; yu: max(sp,sT,0)+yr/5;]]></text>
  </questionvariables>
