<question type="stack">
  <name><text>Which vertex is optimal</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>R is the feasible region shown, with vertices A\((0, 0)\), B\(({@vs[2][1]@}, {@vs[2][2]@})\), C\(({@vs[3][1]@}, {@vs[3][2]@})\), D\(({@vs[4][1]@}, {@vs[4][2]@})\) and E\(({@vs[5][1]@}, {@vs[5][2]@})\).</p><div style="text-align:center;" role="img" aria-label="{@arl@}">
[[jsxgraph width="420px" height="400px"]]
(function () {
  // static region board: the unwanted side of every boundary is shaded, R is left clear
  var J = {#JB#};
  var bb = J[0], Ls = J[1], Vs = J[2], R = J[3], st = J[4];
  var b = JXG.JSXGraph.initBoard(divid, {boundingbox: bb, axis: false, grid: false, keepAspectRatio: false,
    showNavigation: false, showCopyright: false, pan: {enabled: false}, zoom: {enabled: false}});
  var i, k;
  for (k = Math.ceil(bb[0]); k <= bb[2]; k++) {
    b.create('segment', [[k, bb[3]], [k, bb[1]]], {strokeColor: '#d9d9d9', strokeWidth: 1, fixed: true, highlight: false});
  }
  for (k = Math.ceil(bb[3]); k <= bb[1]; k++) {
    b.create('segment', [[bb[0], k], [bb[2], k]], {strokeColor: '#d9d9d9', strokeWidth: 1, fixed: true, highlight: false});
  }
  function clip(P, a, q, c, s) {
    var out = [], j, p, r, fp, fr, t;
    for (j = 0; j < P.length; j++) {
      p = P[j]; r = P[(j + 1) % P.length];
      fp = s * (a * p[0] + q * p[1] - c); fr = s * (a * r[0] + q * r[1] - c);
      if (fp >= 0) { out.push(p); }
      if ((fp >= 0) !== (fr >= 0)) { t = fp / (fp - fr); out.push([p[0] + t * (r[0] - p[0]), p[1] + t * (r[1] - p[1])]); }
    }
    return out;
  }
  function shade(a, q, c, s) {
    var P = clip([[bb[0], bb[3]], [bb[2], bb[3]], [bb[2], bb[1]], [bb[0], bb[1]]], a, q, c, s);
    if (P.length > 2) {
      b.create('polygon', P, {fillColor: '#808080', fillOpacity: 0.25, borders: {visible: false},
        vertices: {visible: false}, fixed: true, highlight: false, hasInnerPoints: false});
    }
  }
  shade(1, 0, 0, -1); shade(0, 1, 0, -1);
  b.create('axis', [[0, 0], [1, 0]], {name: 'x', withLabel: true, label: {position: 'rt', offset: [-12, 12]},
    ticks: {insertTicks: false, ticksDistance: st, minorTicks: st - 1, majorHeight: 8, minorHeight: 4, drawZero: true, label: {offset: [-4, -12]}}});
  b.create('axis', [[0, 0], [0, 1]], {name: 'y', withLabel: true, label: {position: 'rt', offset: [8, -6]},
    ticks: {insertTicks: false, ticksDistance: st, minorTicks: st - 1, majorHeight: 8, minorHeight: 4, drawZero: false, label: {offset: [-18, 0]}}});
  for (i = 0; i < Ls.length; i++) {
    var L = Ls[i];
    if (L[3] !== 0) { shade(L[0], L[1], L[2], L[3]); }
    b.create('line', [-L[2], L[0], L[1]], {strokeColor: (L[3] !== 0 ? '#000000' : '#1f4e9c'), strokeWidth: 2, dash: (L[4] ? 2 : 0), fixed: true, highlight: false});
    if (L[7] > 0) { b.create('text', [L[5], L[6], 'L<sub>' + L[7] + '</sub>'], {fontSize: 14, fixed: true, highlight: false}); }
    if (L[7] < 0) { b.create('text', [L[5], L[6], 'search line'], {fontSize: 13, color: '#1f4e9c', fixed: true, highlight: false}); }
  }
  for (i = 0; i < Vs.length; i++) {
    var V = Vs[i], nm = 'ABCDE'.charAt(V[2] - 1);
    if (V[3]) { nm = nm + '(' + V[0] + ', ' + V[1] + ')'; }
    b.create('point', [V[0], V[1]], {name: nm, fixed: true, size: 2, color: '#000000', highlight: false,
      label: {offset: [V[4], V[5]], fontSize: 13}});
  }
  if (R.length === 2) { b.create('text', [R[0], R[1], 'R'], {fontSize: 18, fixed: true, highlight: false}); }
})();
