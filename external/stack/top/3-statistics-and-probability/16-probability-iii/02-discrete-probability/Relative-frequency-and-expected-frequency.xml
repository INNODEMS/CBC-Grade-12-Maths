  <questionvariables>
    <text><![CDATA[/* pdec: exact decimal display of a value with at most 4 decimal places */
pdec(v) := if integerp(v) then v elseif integerp(10*v) then dispdp(float(v),1) elseif integerp(100*v) then dispdp(float(v),2) elseif integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
/* Design: relative frequency and expected number. [N, k, M, cx]: cx 0 bottle top, 1 drawing pin, 2 maize seed, 3 helmet. Source: adapted from SMP GCSE Foundation book 2, chapter 5, section D, D2 and D3. */
L: [[250,86,500,0],[200,95,2000,2],[80,34,400,1],[125,101,500,3],[125,73,2000,0],[250,172,2000,2],[100,23,1000,1],[50,15,500,3],[100,66,500,2],[80,55,2000,0]];
ix: 1+rand(10);
N: L[ix][1]; k: L[ix][2]; M: L[ix][3]; cx: L[ix][4];
rf: k/N;
ta1: rf; ta2: 1-rf; ta3: M*k/N;
tl1: min(1/200,ta1/20); tl2: min(1/200,ta2/20);
/* diagnostics */
ratio1: k/(N-k);
swap1: (N-k)/N;
same2: rf;
half3: M/2;
other3: M*(N-k)/N;
/* No follow-through node in (c): ans3 is a whole-number input and M times a wrong (a) is rarely whole; "used the not-happening frequency" is the other3 diagnostic. */]]></text>
  </questionvariables>
