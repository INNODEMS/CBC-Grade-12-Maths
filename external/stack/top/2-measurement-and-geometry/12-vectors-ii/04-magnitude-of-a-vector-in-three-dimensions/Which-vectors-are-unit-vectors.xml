  <questionvariables>
    <text><![CDATA[cv3(v) := matrix([v[1]],[v[2]],[v[3]]);
/* Design: decide which vectors are unit vectors; two fixed categories. Every set has a "components add to 1" trap. Source: original. */
ulist: [[["le1",[-1,0,1]],["u",[-2/3,-1/3,2/3]],["sum1",[1/5,3/10,1/2]],["u",[3/5,0,-4/5]]],[["u",[12/25,3/5,16/25]],["sum1",[1/2,1/4,1/4]],["u",[-4/9,1/9,8/9]],["u",[3/5,0,-4/5]]],[["u",[12/25,3/5,16/25]],["u",[-2/3,-1/3,2/3]],["sum1",[1/5,3/10,1/2]],["le1",[1,1,0]]],[["u",[1/3,2/3,-2/3]],["sum1",[1/3,1/3,1/3]],["u",[6/7,2/7,-3/7]],["u",[0,-1,0]]],[["sum1",[1/5,3/10,1/2]],["u",[1/3,2/3,-2/3]],["u",[12/25,3/5,16/25]],["sum1",[1/3,1/3,1/3]]],[["u",[2/7,-3/7,6/7]],["u",[3/5,0,-4/5]],["u",[-2/3,-1/3,2/3]],["sum1",[1/5,3/10,1/2]]],[["sum1",[1/3,1/3,1/3]],["sum1",[2/5,2/5,1/5]],["u",[2/7,-3/7,6/7]],["u",[-2/3,-1/3,2/3]]],[["u",[-2/3,-1/3,2/3]],["sum1",[1/2,1/4,1/4]],["sum1",[1/5,3/10,1/2]],["sum1",[1/3,1/3,1/3]]],[["sum1",[2/5,2/5,1/5]],["sum1",[1/2,1/4,1/4]],["u",[2/7,-3/7,6/7]],["u",[6/7,2/7,-3/7]]],[["u",[12/25,3/5,16/25]],["sum1",[1/2,1/4,1/4]],["u",[-4/9,1/9,8/9]],["u",[0,-1,0]]]];
ix: 1+rand(10);
S: ulist[ix];
v1: S[1][2]; c1: S[1][1]; is1: is(c1 = "u"); su1: is(c1 = "sum1"); le1: is(c1 = "le1");
sq1: v1[1]^2+v1[2]^2+v1[3]^2;
opt1: [["u1", is1, "a unit vector"], ["n1", not is1, "not a unit vector"]];
ta1: first(mcq_correct(opt1)); wa1: first(mcq_incorrect(opt1));
v2: S[2][2]; c2: S[2][1]; is2: is(c2 = "u"); su2: is(c2 = "sum1"); le2: is(c2 = "le1");
sq2: v2[1]^2+v2[2]^2+v2[3]^2;
opt2: [["u2", is2, "a unit vector"], ["n2", not is2, "not a unit vector"]];
ta2: first(mcq_correct(opt2)); wa2: first(mcq_incorrect(opt2));
v3: S[3][2]; c3: S[3][1]; is3: is(c3 = "u"); su3: is(c3 = "sum1"); le3: is(c3 = "le1");
sq3: v3[1]^2+v3[2]^2+v3[3]^2;
opt3: [["u3", is3, "a unit vector"], ["n3", not is3, "not a unit vector"]];
ta3: first(mcq_correct(opt3)); wa3: first(mcq_incorrect(opt3));
v4: S[4][2]; c4: S[4][1]; is4: is(c4 = "u"); su4: is(c4 = "sum1"); le4: is(c4 = "le1");
sq4: v4[1]^2+v4[2]^2+v4[3]^2;
opt4: [["u4", is4, "a unit vector"], ["n4", not is4, "not a unit vector"]];
ta4: first(mcq_correct(opt4)); wa4: first(mcq_incorrect(opt4));
cats: [c1, c2, c3, c4];
]]></text>
