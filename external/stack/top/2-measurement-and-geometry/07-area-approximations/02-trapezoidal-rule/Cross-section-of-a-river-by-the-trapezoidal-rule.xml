  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: cross section of a river by the trapezoidal rule. Entries [W, n, depths (exact tenths, without the zero at each bank), speed]. Source: original. */
L: [[24,6,[10,18,24,23,15]/10,1/2],[30,5,[14,23,25,16]/10,4/5],[16,4,[9,16,11]/10,3/5],[40,8,[8,15,21,26,28,24,16]/10,2/5],[18,6,[7,13,18,19,12]/10,6/5],[35,5,[16,29,31,20]/10,1/2],[12,4,[6,11,8]/10,9/10],[28,7,[10,19,24,27,21,13]/10,7/10],[20,5,[11,18,20,12]/10,11/10],[45,9,[9,17,23,28,30,26,19,10]/10,3/10]];
ix: 1+rand(10);
W: L[ix][1]; n: L[ix][2]; ds: L[ix][3]; v: L[ix][4];
hh: W/n;
A: hh*apply("+",ds);
Qf: A*v;
xs: makelist(j*hh,j,0,n);
dall: append([0],ds,[0]);
opts: [["r0",false,"The estimate is exact, because the depths were measured carefully."],["r1",true,"The estimate is too small: the straight lines between the measured depths lie above the curved bed, so some water is left out."],["r2",false,"The estimate is too big: the straight lines between the measured depths lie below the curved bed."]];
/* diagnostics */
A2: 2*A; Ahalf: A/2;
Ahs: (W/(n+1))*apply("+",ds);
Ahi: (W/(n-1))*apply("+",ds);
Qdiv: A/v; Qadd: A+v;]]></text>
  </questionvariables>
