  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: trapezoidal (T) and mid-ordinate (M) estimates checked against a given exact area E (one rule over, the other under). Entries [a, h, c0, c1, c2, c3]. Entries 1-5 bend upwards, 6-10 downwards on the whole interval; on every entry T and M lie on opposite sides of E and M is closer. Source: adapted from SMP AS/A2 Core 3, Chapter 9, Exercise C, Q5. */
L: [[0,2,3,0,1/4,0],[1,1/2,2,0,0,1],[0,3,10,-2,1/4,0],[2,1/2,3,2,2,0],[0,2,20,-3,0,1/8],[0,2,30,5,-1/2,0],[0,1/2,20,0,0,-1],[0,3,5,6,-1/4,0],[2,1/2,24,3,-2,0],[0,2,4,9,0,-1/8]];
ix: 1+rand(10);
a: L[ix][1]; hh: L[ix][2]; c0: L[ix][3]; c1: L[ix][4]; c2: L[ix][5]; c3: L[ix][6];
b: a+4*hh;
f(t) := c0+c1*t+c2*t^2+c3*t^3;
fx: c0+c1*x+c2*x^2+c3*x^3;
up: is(ix <= 5);
ys: makelist(f(a+j*hh),j,0,4);
ms: makelist(f(a+(j-1/2)*hh),j,1,4);
Ta: hh/2*(ys[1]+ys[5]+2*(ys[2]+ys[3]+ys[4]));
Ma: hh*apply("+",ms);
E: integrate(f(t),t,a,b);
Ed: dispdp(float(E),2);
ymx: lmax(append(ys,ms));
bxl: float(a-hh/2); bxr: float(b+hh/2); byt: float(1.15*ymx); byb: float(-0.12*ymx);
c3d: float(c3); c2d: float(c2); c1d: float(c1); c0d: float(c0);
o3: [["both",false,"both estimates"],["tr",up,"the trapezoidal estimate"],["mo",not up,"the mid-ordinate estimate"],["nei",false,"neither: both are exact"]];
o4: [["o0",false,"The estimate that uses more heights is always too big."],["o1",up,"The curve bends upwards, so the straight tops of the trapezia lie above it and each mid-ordinate rectangle leaves out more than it adds."],["o2",not up,"The curve bends downwards, so the straight tops of the trapezia lie below it and each mid-ordinate rectangle adds more than it leaves out."]];
k3: if up then "tr" else "mo";
k4: if up then "o1" else "o2";
w3: if up then "mo" else "tr";
w4: if up then "o2" else "o1";
/* diagnostics */
T2: 2*Ta; Thalf: hh/2*apply("+",ys);
Ml: hh*apply("+",rest(ys,-1)); Mr: hh*apply("+",rest(ys));]]></text>
  </questionvariables>
