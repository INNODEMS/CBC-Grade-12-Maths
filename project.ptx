<project ptx-version="2">
  <targets>
    <!-- Core Mathematics -->
    <target name="core-web" format="html" publication="publication-core-teacher.ptx" deploy-dir="core/teacher">
        <stringparams html.js.extra="external/review-button.js" />
    </target>
    <target name="core-student" format="html" publication="publication-core-student.ptx" deploy-dir="core/student">
    </target>
    <target name="core-print" format="pdf" publication="publication-core-teacher-print.ptx">
    </target>
    <target name="core-latex" format="latex" publication="publication-core-teacher-print.ptx">
    </target>
    <target name="core-plans-print" format="pdf" publication="publication-core-plans-print.ptx">
    </target>
    <target name="core-plans" format="html" publication="publication-core-plans.ptx" deploy-dir="core/plans">
      <stringparams html.js.extra="external/print-button.js" />
    </target>

    <!-- Essential Mathematics -->
    <target name="essential-web" format="html" publication="publication-essential-teacher.ptx" deploy-dir="essential/teacher">
        <stringparams html.js.extra="external/review-button.js" />
    </target>
    <target name="essential-student" format="html" publication="publication-essential-student.ptx" deploy-dir="essential/student">
    </target>
    <target name="essential-print" format="pdf" publication="publication-essential-teacher-print.ptx">
    </target>
    <target name="essential-latex" format="latex" publication="publication-essential-teacher-print.ptx">
    </target>
    <target name="essential-plans-print" format="pdf" publication="publication-essential-plans-print.ptx">
    </target>
    <target name="essential-plans" format="html" publication="publication-essential-plans.ptx" deploy-dir="essential/plans">
      <stringparams html.js.extra="external/print-button.js" />
    </target>
  </targets>
</project>


