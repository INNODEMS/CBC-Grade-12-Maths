  <questionvariables>
    <text><![CDATA[validate_x(ex) := if every(lambda([v], member(v, [x])), listofvars(ex)) then "" else "Use x as the only letter in your answer.";
/* Design: y = a0(x-m0)^2(x-n0) with n0 - m0 = 3k, so the stationary points are x = m0 (on the axis) and x = m0 + 2k, both integers. Source: original. */
L: [[1,-1,2],[-1,1,-2],[1,2,-1],[-1,-2,4],[1,-3,3],[-1,3,6],[1,1,-5],[-1,-1,-4],[1,2,5],[-1,-2,1]];
ix: 1+rand(10);
a0: L[ix][1]; m0: L[ix][2]; n0: L[ix][3];
ffac: a0*(x-m0)^2*(x-n0);
fexp: expand(ffac);
df: diff(fexp,x);
xs2: m0+2*(n0-m0)/3;
dfac: 3*a0*(x-m0)*(x-xs2);
y2: ev(fexp,x=xs2);
yint: ev(fexp,x=0);
mfirst: is(ev(diff(fexp,x,2),x=m0)<0);
xmax: if mfirst then m0 else xs2; ymax: ev(fexp,x=xmax);
xmin: if mfirst then xs2 else m0; ymin: ev(fexp,x=xmin);
wsq: expand(a0*(x^2+m0^2)*(x-n0));
/* sketch window */
xl: min(m0,n0,xs2,0)-1.5; xr: max(m0,n0,xs2,0)+1.5;
yl: min(0,yint,ymin); yu: max(0,yint,ymax); pd: (yu-yl)/5+1;]]></text>
  </questionvariables>
