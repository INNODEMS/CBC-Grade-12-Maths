  <questionvariables>
    <text><![CDATA[validate_x(ex) := if every(lambda([v], member(v, [x])), listofvars(ex)) then "" else "Use x as the only letter in your answer.";
/* Design: nature of stationary points by the second derivative, from a pool. Source: adapted from SMP AS/A2 Core 1, chapter 9, Exercise C questions 3 and 4. */
L: [[1,-3,3,5],[-1,-1,3,4],[2,1,3,-3],[-2,-1,1,2],[1,-1,5,3],[2,-2,1,1],[-1,-4,0,6],[1,0,6,-2],[-2,0,3,7],[2,-3,-1,4]];
ix: 1+rand(10);
a0: L[ix][1]; p0: L[ix][2]; q0: L[ix][3]; d0: L[ix][4];
f: expand((a0)*x^3-3*(a0)*((p0)+(q0))/2*x^2+3*(a0)*(p0)*(q0)*x+(d0));
df: diff(f,x); d2: diff(f,x,2);
vp: ev(d2,x=p0); vq: ev(d2,x=q0);
yp: ev(f,x=p0); yq: ev(f,x=q0);
d2nr: 2*coeff(df,x,2)*x^2+coeff(df,x,1)*x;
np: if vp<0 then 1 else 2; nq: if vq<0 then 1 else 2;
nat3: [["max3",is(np=1),"maximum point"],["min3",is(np=2),"minimum point"],["inf3",is(np=3),"point of inflection"]];
wa3: if np=1 then "min3" else "max3";
wb3: if np=3 then "min3" else "inf3";
nat5: [["max5",is(nq=1),"maximum point"],["min5",is(nq=2),"minimum point"],["inf5",is(nq=3),"point of inflection"]];
wa5: if nq=1 then "min5" else "max5";
wb5: if nq=3 then "min5" else "inf5";
]]></text>
  </questionvariables>
