  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* Design: stationary points of cubics. Source: adapted from SMP AS/A2 Core 1, chapter 9, Exercise A question 2. */
L: [[1,-3,1,4],[2,-1,2,3],[-1,-1,3,2],[1,-2,4,-5],[-2,-2,1,6],[2,1,3,-4],[1,-4,2,1],[-1,-3,1,-3],[2,-3,1,-2],[-2,1,4,5]];
ix: 1+rand(10);
a0: L[ix][1]; p0: L[ix][2]; q0: L[ix][3]; d0: L[ix][4];
f: expand((a0)*x^3-3*(a0)*((p0)+(q0))/2*x^2+3*(a0)*(p0)*(q0)*x+(d0));
df: diff(f,x);
dfac: 3*a0*(x-p0)*(x-q0);
yp: ev(f,x=p0); yq: ev(f,x=q0);]]></text>
  </questionvariables>
  <specificfeedback format="html"><text><![CDATA[]]></text></specificfeedback>
  <questionnote format="moodle_auto_format">
    <text>ix={@ix@}, f={@f@}, ({@p0@},{@yp@}), ({@q0@},{@yq@})</text>
  </questionnote>
