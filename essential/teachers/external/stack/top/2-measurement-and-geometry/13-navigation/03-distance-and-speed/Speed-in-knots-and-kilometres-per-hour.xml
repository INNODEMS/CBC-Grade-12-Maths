  <questionvariables>
    <text><![CDATA[cosd(x) := cos(x*%pi/180);
sind(x) := sin(x*%pi/180);
atand(x) := 180*atan(x)/%pi;
asind(x) := 180*asin(x)/%pi;
two(v) := if v < 10 then sconcat("0", string(v)) else string(v);
hm(m) := block([q], q: mod(m, 1440), sconcat(two(floor(q/60)), ":", two(mod(q, 60))));
dmx(m) := sconcat(string(floor(m/60)), "^\\circ", two(mod(m, 60)), "'");
/* Design: [latP deg, min, N/S, latQ deg, min, N/S, departure h, m, duration h, m]. The next-day node applies only on overnight entries; elsewhere dayw = -1, a value no speed takes (used only by its test). Source: original. */
L: [[2,10,"S",4,25,"S",6,0,11,15],[1,40,"N",3,5,"S",19,30,16,45],[8,5,"S",5,20,"S",22,15,13,30],[0,50,"S",3,35,"N",7,45,14,30],[4,15,"S",7,55,"S",20,0,18,45],[3,30,"N",6,45,"N",9,10,10,30],[5,0,"S",0,35,"N",21,40,20,45],[6,10,"S",9,0,"S",5,30,12,45],[2,20,"N",1,55,"S",18,45,15,15],[7,40,"S",4,50,"S",13,0,9,30]];
ix: 1+rand(10);
E: L[ix];
sP: (60*E[1]+E[2])*(if E[3]="N" then 1 else -1);
sQ: (60*E[4]+E[5])*(if E[6]="N" then 1 else -1);
north: is(sQ>sP);
same: is(E[3]=E[6]);
nm: abs(sP-sQ);
dep: 60*E[7]+E[8];
dh: E[9]; dm: E[10];
dur: 60*dh+dm;
arr: dep+dur;
nxt: is(arr>=1440);
kn: nm*60/dur;
kmh: kn*1.853;
/* diagnostics */
wr: if same then abs(sP)+abs(sQ) else abs(abs(sP)-abs(sQ));
dec: nm/(dh+dm/100);
dayw: if nxt then nm/(abs(mod(arr,1440)-dep)/60) else -1;
permin: nm/dur;
div: kn/1.853;
]]></text>
  </questionvariables>
