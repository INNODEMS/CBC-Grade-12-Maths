  <questionvariables>
    <text><![CDATA[/* Design: the point equidistant from three points (the centre of the circle through them), with a centroid diagnostic. Entries [[P, Q, R], O, r]: none right-angled, the centroid differs from O, and no entry repeats a chapter example or another entry. Source: adapted from SMP AS/A2 Core 1, Chapter 7, Exercise C, Q9. */
q62: [[[[4,12],[11,-5],[11,5]],[-1,0],13],[[[-5,-5],[2,2],[2,-4]],[-2,-1],5],[[[-5,4],[9,6],[13,-2]],[3,-2],10],[[[-6,-4],[1,3],[-5,3]],[-2,-1],5],[[[9,-7],[-5,7],[7,7]],[1,-1],10],[[[-6,-3],[1,4],[2,-3]],[-2,0],5],[[[-13,3],[11,3],[-6,10]],[-1,-2],13],[[[4,8],[-10,-6],[4,-8]],[-2,0],10],[[[-2,-9],[-2,15],[15,-2]],[3,3],13],[[[4,-13],[-13,4],[11,4]],[-1,-1],13]];
ix: 1+rand(10);
T3: q62[ix][1]; P: T3[1]; Qp: T3[2]; R: T3[3]; O: q62[ix][2]; r: q62[ix][3];
G: (P+Qp+R)/3;
mPQ: (P+Qp)/2; mQR: (Qp+R)/2; mRP: (R+P)/2;
dGP: sqrt((G[1]-P[1])^2+(G[2]-P[2])^2);
ta1: O[1]; ta2: O[2];]]></text>
  </questionvariables>
