<quiz>
<question type="stack">
  <name><text>Combining vectors in i j k form</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>\(\mathbf{a} = {@ta@}\) and \(\mathbf{b} = {@tb@}\).</p><p>(a) Find \(\mathbf{a} - \mathbf{b}\) as a column vector.</p><div>\(\mathbf{a} - \mathbf{b} =\) [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><p>(b) Find \({@p@}\mathbf{a}[[if test="is(q > 0)"]] + {@q@}\mathbf{b}[[else]] - {@-q@}\mathbf{b}[[/if]]\) in i, j, k form.</p><div>\({@p@}\mathbf{a}[[if test="is(q > 0)"]] + {@q@}\mathbf{b}[[else]] - {@-q@}\mathbf{b}[[/if]] =\) [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>Work component by component.</p><p>(a) \(\mathbf{a} - \mathbf{b} = {@cv3(va)@} - {@cv3(vb)@} = {@tm1@}\).</p><p>(b) A scalar multiplies every component; it never adds to them. \({@p@}\mathbf{a} = {@pa@}\) and \({@q@}\mathbf{b} = {@qb@}\), so \({@p@}\mathbf{a}[[if test="is(q > 0)"]] + {@q@}\mathbf{b}[[else]] - {@-q@}\mathbf{b}[[/if]] = {@t2@}\).</p>]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[ordergreat(i,j,k); texput(i,"\\mathbf{i}"); texput(j,"\\mathbf{j}"); texput(k,"\\mathbf{k}");
validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Type a number in each box, not a letter.");
validate_ijk(ex) := if listp(ex) or matrixp(ex) or listofvars(ex) = [] then "Write the vector with i, j and k, for example 3*i-2*k." else if every(lambda([vv], member(vv, [i,j,k])), listofvars(ex)) then "" else "Use only the letters i, j and k.";
cv3(v) := matrix([v[1]],[v[2]],[v[3]]);
e1: matrix([1],[0],[0]);
/* Design: combining vectors in i, j, k form. All components are non-zero and b differs from a in every component; |q| >= 2. Source: adapted from SMP AS/A2 Core 4, Chapter 9, Exercise C, Q5. */
a1: rand_with_prohib(-6,6,[0]); a2: rand_with_prohib(-6,6,[0]); a3: rand_with_prohib(-6,6,[0]);
b1: rand_with_prohib(-6,6,[0,a1]); b2: rand_with_prohib(-6,6,[0,a2]); b3: rand_with_prohib(-6,6,[0,a3]);
va: [a1,a2,a3]; vb: [b1,b2,b3];
ta: a1*i+a2*j+a3*k; tb: b1*i+b2*j+b3*k;
p: rand([2,3,4]); q: rand([-4,-3,-2,2,3,4]);
tm1: cv3(va-vb); revm: cv3(vb-va); plusm: cv3(va+vb);
t2: expand(p*ta+q*tb); nosz: expand(p*ta+signum(q)*tb); sgn: expand(p*ta-q*tb);
pa: expand(p*ta); qb: expand(q*tb);
tm1w: tm1+e1; t2w: t2+i;
]]></text>
  </questionvariables>
