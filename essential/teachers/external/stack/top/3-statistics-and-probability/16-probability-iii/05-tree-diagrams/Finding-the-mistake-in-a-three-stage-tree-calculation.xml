  <questionvariables>
    <text><![CDATA[/* Design: three independent stages, three named errors. [er, p]: er 1 one path only, er 2 included SSS, er 3 success probability on fail branches. One diagnostic only in (b), so every seed has the same route structure. Source: adapted from SMP AS/A2 Statistics 1, chapter 3, Exercise E question 3. */
L: [[1,3/5],[2,7/10],[3,2/5],[1,9/10],[2,3/4],[3,3/5],[1,7/10],[2,4/5],[3,2/3],[1,3/10]];
ix: 1+rand(10);
er: L[ix][1]; p: L[ix][2];
cx: mod(ix,4);
ta2: 3*p^2*(1-p);
v: [p^2*(1-p), 3*p^2*(1-p)+p^3, 3*p^3][er];
tl2: min(1/200,ta2/20);
rk: if er=1 then "r1" elseif er=2 then "r2" else "r3";
rw: if er=1 then "r2" else "r1";
opts1: [["r0",false,"He should have added the three paths instead of multiplying one path by 3."],["r1",is(er=1),"He used only one of the paths with exactly two successes."],["r2",is(er=2),"He included the path where all three succeed."],["r3",is(er=3),"He used the probability of success on branches where the item fails."]];]]></text>
  </questionvariables>
