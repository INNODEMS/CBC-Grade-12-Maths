  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
pad3(r) := if r<10 then sconcat("00",r) elseif r<100 then sconcat("0",r) else sconcat(r);
grpm(v) := if v<0 then sconcat("-",grpm(-v)) elseif v<10000 then sconcat(v) elseif v<1000000 then sconcat(floor(v/1000),"\\,",pad3(mod(v,1000))) else sconcat(floor(v/1000000),"\\,",pad3(mod(floor(v/1000),1000)),"\\,",pad3(mod(v,1000)));
/* Design: estimate using mid-interval values, extended to the standard deviation. Continuous classes from a, width w, 5 or 6 classes. Source: adapted from SMP AS/A2 Statistics 1, chapter 2, section D, D3. */
P: [[[5,5,10,15,14,6],10,20],[[9,14,15,10,3,2],20,40],[[2,7,15,12,7],20,40],[[2,3,10,15,5],20,0],[[3,4,4,15,9],20,40],[[3,8,12,15,8,2],10,0],[[4,5,8,14,9,8],20,40],[[5,11,14,9,5],10,0],[[5,8,14,10,10],20,40],[[6,8,9,10,15,12],20,0]];
ix: 1+rand(10);
f: P[ix][1];
w: P[ix][2];
a: P[ix][3];
k: length(f);
vl: if w=10 then "t" else "d";
mid: makelist(a+w/2+w*(i-1),i,1,k);
lo: makelist(a+w*(i-1),i,1,k);
n: apply("+",f);
fx: makelist(f[i]*mid[i],i,1,k);
fx2: makelist(f[i]*mid[i]^2,i,1,k);
Sfx: apply("+",fx);
Sfx2: apply("+",fx2);
mn: Sfx/n;
vr: Sfx2/n-mn^2;
sdv: sqrt(vr);
mnd: dispdp(float(floor(10^1*(mn)+1/2)/10^1),1);
mn3d: if integerp(1000*mn) then exd(mn) else dispdp(float(floor(10^3*(mn)+1/2)/10^3),3);
vrd: dispdp(float(floor(10^3*(vr)+1/2)/10^3),3);
sdd: dispdp(float(floor(10^2*(sdv)+1/2)/10^2),2);
/* diagnostics */
Sfxlow: sum(f[i]*lo[i],i,1,k);
fxsq: sum((f[i]*mid[i])^2,i,1,k);
Sfx2low: sum(f[i]*lo[i]^2,i,1,k);
byk: Sfx/k;
mnlow: mn-w/2;
sdn1: sqrt(vr*n/(n-1));
sdnosub: sqrt(Sfx2/n);
/* test values */
mn1: float(floor(10^1*(mn)+1/2)/10^1);
sd2: float(floor(10^2*(sdv)+1/2)/10^2);
byk1: float(floor(10^1*(byk)+1/2)/10^1);
mnlow1: float(floor(10^1*(mnlow)+1/2)/10^1);
sdn12: float(floor(10^2*(sdn1)+1/2)/10^2);
vr2: float(floor(10^2*(vr)+1/2)/10^2);
sdnosub2: float(floor(10^2*(sdnosub)+1/2)/10^2);
Sfx2p: Sfx2+2*n;
ft2: float(floor(10^2*(sqrt((Sfx2+2*n)/n-mn^2))+1/2)/10^2);
tcar: float(floor(10^2*(sqrt(Sfx2/n-mn1^2))+1/2)/10^2);
tcar4: if is(abs(tcar-sdn1)>0.00501) then tcar else sd2;]]></text>
  </questionvariables>
