  <prt><name>prt4</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[rad: ans2/n-(ans1/n)^2;
ft: if is(rad>=0) then sqrt(rad) else -1000;
okm: is(abs(ans3-mn)<=0.0501);
rc: Sfx2/n-ans3^2;
car: if okm and is(rc>=0) then sqrt(rc) else sdv;
far: is(abs(ans4-sdv)>0.00501);
carok: is(abs(ans4-car)<=0.00501) and is(abs(ans4-sdn1)>0.00501);
sdt: if far and carok then car else sdv;
carn: okm and is(abs(ans4-car)<=0.00501);
sq4: dispdp(float(ans4^2),3);]]></text></feedbackvariables>
