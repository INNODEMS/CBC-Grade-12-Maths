<quiz>
<question type="stack">
  <name><text>Restoring a distorted photo</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>A photo-editing app on a phone distorted a photo with the matrix \(M = {@Mt@}\). One corner of the distorted photo is at \(({@img[1]@},\,{@img[2]@})\), and the distorted photo has area \({@A1@}\) square units.</p><p>(a) Find the matrix that restores the photo.</p><div>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><p>(b) Find the original position of that corner.</p><div>( [[input:ans2]] , [[input:ans3]] ) [[validation:ans2]] [[validation:ans3]] [[feedback:prt2]]</div><p>(c) Find the area of the original photo.</p><div>[[input:ans4]] square units [[validation:ans4]] [[feedback:prt3]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>(a) The inverse undoes the transformation. \(\det M = {@dm@}\), so \(M^{-1} = \dfrac{1}{{@dm@}}{@dAdj@} = {@ta@}\).</p><p>(b) \({@ta@}{@ic@} = {@ta.ic@}\), so the corner was at \(({@to[1]@},\,{@to[2]@})\).</p><p>(c) The distortion multiplied every area by \(|\det M| = {@abs(dm)@}\). To go back, divide: \({@A1@} \div {@abs(dm)@} = {@A0@}\) square units.</p>]]></text>
  </generalfeedback>
  <defaultgrade>3</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Type a number in each box, not a letter.");
near(L,T) := is(abs(L[1]-T[1]) + abs(L[2]-T[2]) < 0.001);
/* Design: undo a transformation with the inverse matrix. Source: original. |det M| is 2 or 4, so M^-1 has entries in halves or quarters and the original corner has integer coordinates. */
mlist: [[matrix([1,-1],[3,-1]),[0,10],16],[matrix([-1,0],[4,-2]),[-2,4],8],[matrix([-2,3],[0,-1]),[5,-5],24],[matrix([0,-1],[2,4]),[-4,22],12],[matrix([0,-1],[4,-2]),[-4,12],16],[matrix([-5,-1],[4,0]),[-11,12],16],[matrix([4,2],[-2,0]),[10,-2],16],[matrix([-2,4],[-2,2]),[14,6],16],[matrix([4,-2],[1,-1]),[14,2],16],[matrix([0,2],[-1,4]),[4,6],24]];
ix: 1+rand(10);
Mt: mlist[ix][1]; img: mlist[ix][2]; A1: mlist[ix][3];
ic: transpose(matrix(img));
dm: determinant(Mt);
ta: invert(Mt); to: list_matrix_entries(ta.ic);
A0: A1/abs(dm);
/* diagnostics: not divided by det; M itself; M applied to the corner; areas multiplied, unchanged */
dAdj: matrix([Mt[2,2],-Mt[1,2]],[-Mt[2,1],Mt[1,1]]);
oAdj: list_matrix_entries(dAdj.ic); oM: list_matrix_entries(Mt.ic);
/* signs of b and c changed and divided by det, but a and d not swapped (a # d on every entry, so dNS # ta) */
dNS: (1/dm)*matrix([Mt[1,1],-Mt[1,2]],[-Mt[2,1],Mt[2,2]]); oNS: list_matrix_entries(dNS.ic);
aMul: A1*abs(dm); mA0: -A0;
tr: (1/(Mt[1,1]*Mt[2,2]-Mt[1,2]*Mt[2,1]))*dAdj; trd: float(tr);
tw: ta+matrix([1,0],[0,0]); tow: to+[0,1]; A0w: A0+1;
]]></text>
  </questionvariables>
