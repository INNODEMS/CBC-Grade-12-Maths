  <questionvariables>
    <text><![CDATA[validate_ab(ex) := block([s, ca, cb], if not every(lambda([vv], member(vv, [a,b])), listofvars(ex)) then "Use only the vectors a and b." else (s: ev(expand(ex), simp), ca: ev(coeff(s,a), simp), cb: ev(coeff(s,b), simp), if ev(is(s - ca*a - cb*b = 0), simp) and ev(numberp(float(ca)) and numberp(float(cb)), simp) then "" else "Write your answer as a number times a plus a number times b, for example 3/5*a+2/5*b."));
texput(a,"\\mathbf{a}"); texput(b,"\\mathbf{b}");
/* Design: where two lines meet in a triangle: two expressions for one point, equate coefficients. h # k, k # 1 - k and h # 1 - k on every entry. Source: adapted from SMP AS/A2 Core 4, Chapter 9, Exercise B, Q10. */
glist: [[1,4,3,1],[1,2,1,2],[1,1,1,4],[3,1,1,1],[2,3,2,1],[1,4,1,1],[1,1,4,1],[3,1,2,3],[2,1,1,1],[2,3,1,2]];
ix: 1+rand(10);
r1: glist[ix][1]; s1: glist[ix][2]; r2: glist[ix][3]; s2: glist[ix][4];
c1: r1/(r1+s1); al: s2/(r2+s2); be: r2/(r2+s2);
h: 1/(be+al/c1); kx: h*al/c1;
tOD: (s2*a+r2*b)/(r2+s2); vBC: c1*a-b;
cr1: s2*a+r2*b; rv2: b-c1*a; omk: 1-kx;
opts: [["mag", false, "a and b have the same magnitude"], ["np", true, "a and b are not zero and not parallel"], ["mult", false, "every vector is a multiple of a"], ["both", false, "both expressions for OX contain a and b"]];
ta5: first(mcq_correct(opts));
w1: tOD+a; w2: vBC+b; w3: h+1; w4: kx+1;
]]></text>
