<quiz>
<question type="stack">
  <name><text>First four terms of a binomial expansion</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>Find the first four terms of the expansion of \({@brs@}\) in ascending powers of \(x\).</p><div>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>The row for power \({@n@}\) starts 1, \({@C1@}\), \({@C2@}\), \({@C3@}\). With \(a = 1\) and \(b = {@kx@}\), every power of 1 is 1, so each term is a row number times a power of \({@kx@}\), with brackets:</p><p>\[1 + {@C1@}\left({@kx@}\right) + {@C2@}\left({@kx@}\right)^2 + {@C3@}\left({@kx@}\right)^3 + \cdots\]</p><p>\(\left({@kx@}\right)^2 = {@kx2@}\) and \(\left({@kx@}\right)^3 = {@kx3@}\), so the first four terms are \({@tad@}\).</p>]]></text>
  </generalfeedback>
  <defaultgrade>1</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_x(ex) := if every(lambda([v], is(v=x)), listofvars(ex)) then "" else "Use only the letter x.";
cstr(c) := if integerp(c) then string(abs(c)) else sconcat("\\frac{",num(abs(c)),"}{",denom(abs(c)),"}");
xstr(j) := if j=0 then "" else if j=1 then "x" else sconcat("x^{",j,"}");
tstr(c,j) := sconcat(if j>0 and abs(c)=1 then "" else cstr(c), xstr(j));
ascd(p) := block([cs,s,j,c,first], s:"", first:true, for j:0 thru hipow(expand(p),x) do (c: coeff(expand(p),x,j), if c#0 then (if first then s: sconcat(if c<0 then "-" else "", tstr(c,j)) else s: sconcat(s, if c<0 then " - " else " + ", tstr(c,j)), first:false)), s);
/* Design: first four terms of (1 + kx)^n. Source: adapted from SMP AS/A2 Core 2, Chapter 5, Exercise C, question 4. */
L: [[6,2],[7,3],[8,1/2],[9,-2],[10,-2],[6,-1/2],[7,2],[8,-3],[10,-1/2],[9,1/2]];
ix: 1+rand(10);
n: L[ix][1];
k: L[ix][2];
nm1: n-1;
kxs: if k=1/2 then "\\frac{1}{2}x" else if k=-1/2 then "-\\frac{1}{2}x" else sconcat(k,"x");
brs: sconcat("\\left(1",if k>0 then "+" else "",kxs,"\\right)^{",n,"}");
brs1: sconcat("\\left(1",if k>0 then "+" else "",kxs,"\\right)^{",n-1,"}");
ta: sum(binomial(n,r)*k^r*x^r,r,0,3);
notpow: 1+sum(binomial(n,r)*k*x^r,r,1,3);
flip: sum(binomial(n,r)*(-k)^r*x^r,r,0,3);
prv: sum(binomial(n-1,r)*k^r*x^r,r,0,3);
C1: n; C2: binomial(n,2); C3: binomial(n,3);
kx: k*x;
t1: n*k*x; t2: C2*k^2*x^2; t3: C3*k^3*x^3;
kx2: kx^2; kx3: kx^3;
tad: ascd(ta);]]></text>
  </questionvariables>
