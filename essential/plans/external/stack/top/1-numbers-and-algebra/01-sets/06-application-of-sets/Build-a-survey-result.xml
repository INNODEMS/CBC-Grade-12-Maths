N: L[ix][1]; a: L[ix][2]; u: L[ix][3]; lo: L[ix][4]; bo: L[ix][5]; nn: L[ix][6]; sa: L[ix][7]; sb: L[ix][8]; la: L[ix][9]; lb: L[ix][10]; ka: L[ix][11]; kb: L[ix][12]; am1: L[ix][13]; ap1: L[ix][14]; nn5: L[ix][15]; bo1: L[ix][16]; bo2: L[ix][17]; nn2: L[ix][18]; 
