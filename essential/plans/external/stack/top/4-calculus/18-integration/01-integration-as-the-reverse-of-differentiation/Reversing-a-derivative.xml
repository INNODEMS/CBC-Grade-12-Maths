  <questionvariables>
    <text><![CDATA[validate_xc(ex) := if every(lambda([v], member(v, [x, c, C])), listofvars(ex)) then "" else "Use x for the variable and c for the constant of integration.";
/* Design: single-term drill. [k, q, p, n]. Source: adapted from SMP AS/A2 Core 1, chapter 10, Exercise B questions 1 to 3. */
L: [[5,6,9,2],[7,3,8,3],[-4,10,4,2],[9,-8,12,3],[3,5,-6,2],[6,4,5,3],[-2,7,15,2],[8,-2,-20,3],[2,9,2,2],[10,12,6,3]];
ix: 1+rand(10);
kk: L[ix][1]; qq: L[ix][2]; pp: L[ix][3]; nn: L[ix][4];
F1: kk*x;
F2: qq*x^2/2;
F3: pp*x^(nn+1)/(nn+1);
/* diagnostics */
d2: qq;
nd2: qq*x^2;
d3: pp*nn*x^(nn-1);
pe3: pp*x^(nn+1);
po3: pp*x^(nn+1)/nn;
/* model answers for the inputs */
ta1: F1+c; ta2: F2+c; ta3: F3+c;]]></text>
  </questionvariables>
