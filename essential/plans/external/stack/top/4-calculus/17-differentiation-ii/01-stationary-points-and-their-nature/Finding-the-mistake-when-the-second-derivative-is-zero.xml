  <questionvariables>
    <text><![CDATA[/* Design: reading-comprehension layout. n = 4: a turning point with zero second derivative; n = 3: a point of inflection, where Kamau's conclusion is right but his reason is not. Source: original. */
L: [[4,1,2,5],[4,-1,-1,6],[3,1,2,-4],[4,2,1,-2],[3,-1,1,6],[4,-2,2,1],[4,1,-2,7],[3,2,-1,2],[4,-1,2,-6],[3,-2,-2,4]];
ix: 1+rand(10);
n: L[ix][1]; A: L[ix][2]; h: L[ix][3]; k: L[ix][4];
f: expand(A*(x-h)^n+k);
df: diff(f,x); d2: diff(f,x,2);
gL: ev(df,x=h-1); gR: ev(df,x=h+1);
yL: ev(f,x=h-1); yR: ev(f,x=h+1);
nt: (if gL>0 and gR<0 then 1 elseif gL<0 and gR>0 then 2 else 3);
nat3: [["max3",is(nt=1),"maximum point"],["min3",is(nt=2),"minimum point"],["inf3",is(nt=3),"point of inflection"]];
wa3: if nt=1 then "min3" else "max3";
wb3: if nt=3 then "min3" else "inf3";

opts: [["r2",false,sconcat("He should have substituted x = ",string(h)," into the equation of the curve, not into the second derivative.")],["r1",true,sconcat("When the second derivative is 0, the second-derivative test gives no conclusion, so he must test the gradient either side of x = ",string(h),".")],["r3",false,"Nothing: when the second derivative is 0, the point is always a point of inflection."],["r4",false,"The second derivative can never be 0 at a stationary point, so he has made an arithmetic slip."]];
wa3: if nt=3 then "max3" else "inf3";
wb3: if nt=3 then "min3" elseif nt=1 then "min3" else "max3";]]></text>
  </questionvariables>
