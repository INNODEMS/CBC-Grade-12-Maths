  <questionvariables>
    <text><![CDATA[cv3(v) := matrix([v[1]],[v[2]],[v[3]]);
/* Design: give a fourth vertex of a parallelogram, graded by property: any of the three fourth vertices scores. Source: original. */
tlist: [[[1,-4,5],[5,-4,-4],[4,-2,-2]],[[0,-3,1],[0,-1,-1],[4,1,-2]],[[4,4,5],[-1,-2,2],[-2,6,5]],[[-1,1,0],[2,-1,-3],[1,5,4]],[[-4,4,-4],[-1,6,2],[-3,6,0]],[[3,4,3],[3,6,-4],[-4,6,-2]],[[-2,4,1],[-3,3,5],[3,-2,-3]],[[5,-2,3],[2,1,-1],[-3,6,0]],[[-1,2,6],[2,2,1],[4,-4,0]],[[-3,-1,-2],[0,-4,-1],[-3,-2,-2]]];
ix: 1+rand(10);
A: tlist[ix][1]; B: tlist[ix][2]; C: tlist[ix][3];
/* D opposite B (ABCD), D opposite C (ACBD), D opposite A (ABDC) */
good: [A+C-B, A+B-C, B+C-A];
g1: good[1]; g2: good[2]; g3: good[3];
vecs: [C-B, B-C, B-A, A-B, C-A, A-C];
mids: [(A+B)/2, (A+C)/2, (B+C)/2];
cmb: C-B; mac: float((A+C)/2); off: g1+[1,0,0];
]]></text>
  </questionvariables>
