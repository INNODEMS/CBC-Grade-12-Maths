  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[L: [ans1,ans2,ans3];
hit(S) := sublist_indices(S, lambda([d], is(abs(L[1]-d[1])+abs(L[2]-d[2])+abs(L[3]-d[3]) < 0.001)));
gi: hit(good); vi: hit(vecs); mi: hit(mids);
