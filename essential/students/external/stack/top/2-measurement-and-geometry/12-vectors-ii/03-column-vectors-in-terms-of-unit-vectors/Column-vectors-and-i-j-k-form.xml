<quiz>
<question type="stack">
  <name><text>Column vectors and i j k form</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>(a) Write \({@cv3(v)@}\) in terms of \(\mathbf{i}\), \(\mathbf{j}\) and \(\mathbf{k}\).</p><div>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><p>(b) Write \({@w@}\) as a column vector.</p><div>[[input:ans2]] [[validation:ans2]] [[feedback:prt2]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>A column \(\begin{pmatrix} x \\ y \\ z \end{pmatrix}\) is \(x\mathbf{i} + y\mathbf{j} + z\mathbf{k}\): each unit vector is one step along an axis. A zero component is left out of the i, j, k form, but kept as 0 in a column.</p><p>(a) \({@cv3(v)@} = {@tv@}\).</p><p>(b) \({@w@} = {@tw@}\).</p>]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[ordergreat(i,j,k); texput(i,"\\mathbf{i}"); texput(j,"\\mathbf{j}"); texput(k,"\\mathbf{k}");
validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Type a number in each box, not a letter.");
validate_ijk(ex) := if listp(ex) or matrixp(ex) or listofvars(ex) = [] then "Write the vector with i, j and k, for example 3*i-2*k." else if every(lambda([vv], member(vv, [i,j,k])), listofvars(ex)) then "" else "Use only the letters i, j and k.";
cv3(v) := matrix([v[1]],[v[2]],[v[3]]);
e1: matrix([1],[0],[0]);
/* Design: column vectors and i, j, k form, with a zero component in a random place. complexno symi: i is a plain symbol. Source: adapted from SMP AS/A2 Core 4, Chapter 9, C12 and C13. */
p1: rand_with_prohib(-9,9,[0]); p3: rand_with_prohib(-9,9,[0,p1]); zp: 1+rand(2);
v: if zp = 1 then [0,p1,p3] else [p1,0,p3];
tv: v[1]*i+v[2]*j+v[3]*k;
dv: p1*i+p3*j;
q1: rand_with_prohib(-9,9,[0]); q3: rand_with_prohib(-9,9,[0,q1]); mz: 1+rand(2);
w: if mz = 1 then q1*j+q3*k else q1*i+q3*k;
wl: if mz = 1 then [0,q1,q3] else [q1,0,q3];
tw: cv3(wl);
dw: cv3([q1,q3,0]);
tv1: tv+i; tw1: tw+e1; vl: v;
]]></text>
  </questionvariables>
  <specificfeedback format="html"><text><![CDATA[]]></text></specificfeedback>
  <questionnote format="moodle_auto_format">
    <text>v={@v@}, w={@w@}</text>
  </questionnote>
  <questiondescription format="html"><text><![CDATA[<p id="concept">Vectors II: column vectors and i, j, k form</p><p id="description">Grade 12 CBE Core 2.6: Change a three-dimensional vector between column form and i, j, k form, including a zero component.</p><p id="edition">Core</p><p id="provenance">This question is adapted from Questions C12 and C13 in Section C of Chapter 9 of Instone, S., Ling, J., Scruton, P., Shilton, S. and West, H., SMP AS/A2 Mathematics: Core 4 for AQA, Cambridge University Press, 2005: both directions in one question with a zero component in a random place, new numbers, randomised, with named feedback.</p><p id="citation">INNODEMS CBC Grade 12 Mathematics, first draft by Ben Davies, 2026. Aligned to the KICD Senior School Curriculum Design, Core Mathematics Grade 12 (draft).</p>]]></text></questiondescription>
