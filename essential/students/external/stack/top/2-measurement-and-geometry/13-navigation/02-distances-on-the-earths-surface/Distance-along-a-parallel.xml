  <questionvariables>
    <text><![CDATA[cosd(x) := cos(x*%pi/180);
sind(x) := sin(x*%pi/180);
atand(x) := 180*atan(x)/%pi;
asind(x) := 180*asin(x)/%pi;
two(v) := if v < 10 then sconcat("0", string(v)) else string(v);
hm(m) := block([q], q: mod(m, 1440), sconcat(two(floor(q/60)), ":", two(mod(q, 60))));
dmx(m) := sconcat(string(floor(m/60)), "^\\circ", two(mod(m, 60)), "'");
/* Design: distance along a parallel, in km. [phi, N/S, l1, E/W, l2, E/W]. Source: adapted from SMP Book 5 (Metric), chapter 3, section 7, Example 2 and Exercise E question 1. */
L: [[35,"N",10,"E",48,"E"],[50,"S",15,"W",30,"E"],[20,"N",65,"W",20,"W"],[60,"S",25,"E",110,"E"],[40,"N",30,"W",45,"E"],[15,"S",40,"E",95,"E"],[55,"N",12,"W",38,"E"],[25,"S",70,"W",15,"W"],[65,"N",5,"W",70,"E"],[30,"S",50,"W",20,"E"]];
ix: 1+rand(10);
E: L[ix];
phi: E[1];
l1: E[3]; l2: E[5]; same: is(E[4]=E[6]);
dl: if same then abs(l1-l2) else l1+l2;
wr: if same then l1+l2 else abs(l1-l2);
nm: 60*dl*cosd(phi);
kmv: dl/360*40040*cosd(phi);
kmtol: max(1,kmv/1000);
/* diagnostics */
nocos: 60*dl; snm: 60*dl*sind(phi); dvc: 60*dl/cosd(phi); wrnm: 60*wr*cosd(phi);
kmnc: dl/360*40040; kms: kmnc*sind(phi); half: kmv/2; divnm: nm/1.853; wrkm: wr/360*40040*cosd(phi);
]]></text>
  </questionvariables>
