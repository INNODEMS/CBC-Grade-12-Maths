  <questionvariables>
    <text><![CDATA[dec(v) := block([k:0], while k<10 and not(integerp(ev(10^k*v,simp))) do k:k+1, if k=0 then string(v) else dispdp(float(v),k));
pad3(r) := if r<10 then sconcat("00",r) else if r<100 then sconcat("0",r) else sconcat(r);
grp(v) := if v<0 then sconcat("-",grp(-v)) else if v<10000 then sconcat(v) else sconcat(floor(v/1000),"\\,",pad3(mod(v,1000)));
money(v) := block([c], c: floor(100*v+1/2), if mod(c,100)=0 then grp(c/100) else sconcat(grp(floor(c/100)),".",if mod(c,100)<10 then sconcat("0",mod(c,100)) else sconcat(mod(c,100))));
/* Design: compound growth and depreciation (Grade 11 Chapter 11) read through the expansion. Source: original. */
L: [[45000,4,4,1],[140000,5,5,-1],[40000,2,8,1],[80000,4,5,-1],[60000,3,6,1],[200000,10,4,-1],[30000,5,5,1],[150000,4,6,-1],[70000,2,10,1],[90000,5,4,-1]];
ix: 1+rand(10);
P: L[ix][1];
r: L[ix][2];
n: L[ix][3];
g: L[ix][4];
itm: ["", "boda boda", "", "delivery van", "", "posho mill", "", "maize sheller", "", "water pump"][ix];
xv: g*r/100;
C2: binomial(n,2);
T2: P*n*xv;
T3: P*C2*xv^2;
E3: P+T2+T3;
ex: P*(1+xv)^n;
Pd: grp(P);
xd: dec(xv);
T2d: grp(T2);
T3d: grp(T3);
E3d: grp(E3);
exd: money(ex);
nT2: -T2; nT3: -T3; Px: P*xv; Pnx2: P*n*xv^2; PCx: P*C2*xv;]]></text>
  </questionvariables>
