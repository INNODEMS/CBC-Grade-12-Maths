  <questionvariables>
    <text><![CDATA[/* helpers: relation tokens, display strings, inequality builders */
relt(r) := if r="lt" then "\\lt" else if r="le" then "\\le" else if r="gt" then "\\gt" else "\\ge";
reluc(r) := if r="lt" then "<" else if r="le" then "≤" else if r="gt" then ">" else "≥";
relflip(r) := if r="lt" then "gt" else if r="le" then "ge" else if r="gt" then "lt" else "le";
relother(r) := if r="lt" then "le" else if r="le" then "lt" else if r="gt" then "ge" else "gt";
relcomp(r) := if r="lt" then "ge" else if r="le" then "gt" else if r="gt" then "le" else "lt";
strictp(r) := is(r="lt" or r="gt");
/* Typed answers must be one inequality; "and"/"or" statements are rejected at validation. */
vsingle(ex) := if not atom(ex) and member(op(ex), ["and", "or", "nounand", "nounor"]) then "Type a single inequality, without the words and or or." else "";
mkin(u, r, w) := if r="lt" then u<w else if r="le" then u<=w else if r="gt" then u>w else u>=w;
holds(u, r, w) := if r="lt" then is(u<w) else if r="le" then is(u<=w) else if r="gt" then is(u>w) else is(u>=w);
relopts(c) := [["lt",is(c="lt"),"<"],["le",is(c="le"),"≤"],["gt",is(c="gt"),">"],["ge",is(c="ge"),"≥"]];
termp(v) := block([dd], dd: denom(v), while is(mod(dd,2)=0) do dd: dd/2, while is(mod(dd,5)=0) do dd: dd/5, is(dd=1));
nd(v) := if integerp(v) then string(v) else if termp(v) then string(float(v))
  else sconcat(if is(v<0) then "-" else "", "\\frac{", string(abs(num(v))), "}{", string(denom(v)), "}");
ndm(v) := sconcat("\\(", nd(v), "\\)");
/* plain-text number for aria-labels (nd gives TeX fractions, which a screen reader reads raw) */
ndt(v) := if integerp(v) then string(v) else if termp(v) then string(float(v)) else sconcat(string(num(v)), "/", string(denom(v)));
trm(k, v, fst) := block([m, s], m: abs(k), s: if v="" then nd(m) else if m=1 then v else sconcat(nd(m), v),
  if fst then (if k<0 then sconcat("-", s) else s) else (if k<0 then sconcat(" - ", s) else sconcat(" + ", s)));
lfs(L) := block([s, t], s: "", for t in L do (if t[1]#0 then s: sconcat(s, trm(t[1], t[2], is(s="")))), if s="" then "0" else s);
ins(a, b, c, r) := sconcat(lfs([[a,"x"],[b,"y"]]), " ", relt(r), " ", nd(c));
ineqd(a, b, c, r) := sconcat("\\(", ins(a, b, c, r), "\\)");
lind(a, b, c) := sconcat("\\(", lfs([[a,"x"],[b,"y"]]), " = ", nd(c), "\\)");
ineqm(a, b, c, r) := mkin(a*x+b*y, r, c);
/* Design: draw an inequality step by step. Source: original. q31 [a,b,c,rel,option order]: |a|, |b| >= 2, so c is never a crossing;
   the correct option is never first. o1 solid + shade side with (0, 0); o2 solid + side without; o3 dashed + with; o4 dashed + without. */
q31: [[7,3,21,"le",["o4","o3","o2","o1"]],[5,7,-35,"lt",["o2","o4","o1","o3"]],[-8,7,-56,"le",["o2","o1","o4","o3"]],[7,4,28,"le",["o1","o3","o2","o4"]],[3,8,-24,"ge",["o3","o2","o4","o1"]],[-3,8,24,"gt",["o4","o2","o1","o3"]],[-5,7,35,"ge",["o3","o4","o2","o1"]],[8,3,-24,"gt",["o1","o3","o4","o2"]],[-6,5,30,"gt",["o1","o3","o2","o4"]],[-4,7,28,"lt",["o3","o2","o1","o4"]]];
ix: 1+rand(10);
a: q31[ix][1]; b: q31[ix][2]; c: q31[ix][3]; rel: q31[ix][4]; ord: q31[ix][5];
X: c/a; Y: c/b;
osat: holds(0, rel, c);
/* (0, 0) in R: shade the side without it; otherwise shade the side with it */
sty: if strictp(rel) then 2 else 0;
sid: if osat then 2 else 1;
okey(st, sd) := ["o1","o2","o3","o4"][st+sd];
cor: okey(sty, sid);
optS: okey(2-sty, sid); optH: okey(sty, 3-sid); optB: okey(2-sty, 3-sid);
otext(o) := if o="o1" then "Draw a solid line and shade the side that contains \\((0, 0)\\)."
  else if o="o2" then "Draw a solid line and shade the side that does not contain \\((0, 0)\\)."
  else if o="o3" then "Draw a dashed line and shade the side that contains \\((0, 0)\\)."
  else "Draw a dashed line and shade the side that does not contain \\((0, 0)\\).";
o3: makelist([ord[j], is(ord[j]=cor), otext(ord[j])], j, 1, 4);
id: ineqd(a, b, c, rel);
/* test values */
Xf: float(X); Yf: float(Y); mX: -X; mY: -Y; X1: X+1; Y1: Y+1;]]></text>
