  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
trap(fn, a, b, m) := block([h, ys], h: (b-a)/m, ys: makelist(subst(x=a+j*h, fn), j, 0, m), h/2*(ys[1]+ys[m+1]+2*sum(ys[j], j, 2, m)));
/* Design: [c0, c1, c2, c3, lo, hi]; the prediction exact + e4/4 equals the true T8 on every entry. Source: original. */
L: [[2,2,-3,1,2,4],[30,4,-6,-1,0,2],[6,0,0,1,0,2],[20,-2,-3,0,0,2],[6,4,6,2,1,3],[20,2,-3,-1,0,2],[6,4,-3,2,2,6],[20,2,-3,0,0,2],[6,-2,-3,2,1,3],[40,2,-6,0,0,2]];
ix: 1+rand(10);
cf: L[ix];
lo: cf[5]; hi: cf[6];
fx: cf[1]+cf[2]*x+cf[3]*x^2+cf[4]*x^3;
Fx: integrate(fx,x);
T2v: trap(fx, lo, hi, 2);
T4v: trap(fx, lo, hi, 4);
Ex: subst(x=hi,Fx)-subst(x=lo,Fx);
e2: T2v-Ex;
e4: T4v-Ex;
T8v: Ex+e4/4;
/* diagnostics */
half: Ex+e4/2;
wsign: Ex-e4/4;]]></text>
  </questionvariables>
