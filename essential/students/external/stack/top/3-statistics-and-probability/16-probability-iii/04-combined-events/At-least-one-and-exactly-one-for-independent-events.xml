  <questionvariables>
    <text><![CDATA[/* pdec: exact decimal display of a value with at most 4 decimal places */
pdec(v) := if integerp(v) then v elseif integerp(10*v) then dispdp(float(v),1) elseif integerp(100*v) then dispdp(float(v),2) elseif integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
/* Design: two independent events, both and at least one; four parts. Entries in hundredths [p, q]. Source: adapted from SMP AS/A2 Statistics 1, chapter 3, Exercise D question 2. */
L: [[60,55],[70,40],[50,30],[40,65],[55,85],[50,60],[35,80],[30,55],[55,50],[30,35]];
ix: 1+rand(10);
p: L[ix][1]/100; q: L[ix][2]/100;
cx: mod(ix,3);
ta1: p*q; ta2: (1-p)*(1-q); ta3: 1-ta2; ta4: p*(1-q)+(1-p)*q;
tl1: min(1/200,ta1/20); tl2: min(1/200,ta2/20); tl3: min(1/200,ta3/20); tl4: min(1/200,ta4/20);
/* diagnostics */
add1: p+q;
notboth2: 1-p*q;
add3: p+q;
notboth3: 1-p*q;
onepath4: p*(1-q);
alo4: ta3;]]></text>
  </questionvariables>
