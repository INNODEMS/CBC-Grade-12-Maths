<section xml:id="sec-loci-involving-chords" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Loci Involving Chords</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        2.0 Measurements and Geometry
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        2.3 Loci
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        [Learning Outcome] (TODO: not yet provided in the curriculum design)
                    </p>
                </li>
