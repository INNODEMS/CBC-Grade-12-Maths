    <title>Mixtures</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        1.0 Numbers and Algebra
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p component="core">
                        1.3 Compound Proportions, Rates of Work and Mixtures
                    </p>
                    <p component="essential">
                        1.2 Compound Proportions, Rates of Work and Mixtures
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p component="core">
                        Determine quantities in mixtures in different situations
                    </p>
                    <p component="essential">
                        Determine components of mixtures in different situations
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
