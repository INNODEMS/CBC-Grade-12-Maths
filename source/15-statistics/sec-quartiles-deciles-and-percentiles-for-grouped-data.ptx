<section xml:id="sec-quartiles-deciles-and-percentiles-for-grouped-data" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title component="core">Median, Quartiles, Deciles and Percentiles for Grouped Data</title>
    <title component="essential">Median and Quartiles for Grouped Data</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        3.0 Statistics and Probability
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p component="core">
                        3.1 Statistics II
                    </p>
                    <p component="essential">
                        3.1 Statistics III
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p component="core">
                        Calculate median, quartiles, deciles and percentiles for grouped data; Estimate median, quartiles, deciles and percentiles from a cumulative frequency curve
                    </p>
                    <p component="essential">
                        Calculate median and quartiles for ungrouped and grouped data; Estimate median, quartiles, interquartile range and quartile deviation from cumulative frequency curve
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- Planning notes (from the Combined Mathematics tab of the Grade 12 Book Structure Mapping sheet)
         Sheet title: Median, quartiles (and deciles, percentiles – Core) for grouped data
         Content summary: Median and quartiles for grouped data from calculation and the ogive. Core also covers deciles and percentiles.
         Suggested activity: Learners read the median, quartiles, deciles and percentiles from their ogive and compare with calculated values.
         Interactive (JSXGraph): Ogive with draggable horizontal lines at chosen percentiles; the matching x-values (median, quartiles, deciles) are read off and labelled. -->

