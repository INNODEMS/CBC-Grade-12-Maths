    <exercise xml:id="ex-reading-a-cumulative-frequency-table">
        <!--<title></title>-->
        <stack label="stk-reading-a-cumulative-frequency-table" source="stack/top/3-statistics-and-probability/15-statistics/02-cumulative-frequency-curves/Reading-a-cumulative-frequency-table.xml"/>
