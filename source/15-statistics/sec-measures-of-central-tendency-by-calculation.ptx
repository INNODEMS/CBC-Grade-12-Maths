<section xml:id="sec-measures-of-central-tendency-by-calculation" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title component="core">Mean, Median, Quartiles, Deciles and Percentiles by Calculation</title>
    <title component="essential">Mean, Median and Quartiles by Calculation</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        3.0 Statistics and Probability
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p component="core">
                        3.1 Statistics II
                    </p>
                    <p component="essential">
                        3.1 Statistics III
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p component="core">
                        Determine mean, variance and standard deviation using assumed mean for ungrouped data
                    </p>
                    <p component="essential">
                        Determine mean, variance and standard deviation for ungrouped data
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
