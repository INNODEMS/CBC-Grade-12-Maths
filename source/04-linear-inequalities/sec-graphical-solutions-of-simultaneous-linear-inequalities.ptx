    <exercise xml:id="ex-whole-number-points-in-a-required-region">
        <!--<title></title>-->
        <stack label="stk-whole-number-points-in-a-required-region" source="stack/top/1-numbers-and-algebra/04-linear-inequalities/04-graphical-solutions-of-simultaneous-linear-inequalities/Whole-number-points-in-a-required-region.xml"/>
