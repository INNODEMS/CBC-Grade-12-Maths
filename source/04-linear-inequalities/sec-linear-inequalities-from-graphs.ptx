    <exercises xml:id="exercises-inequalities-from-graphs">
        <introduction>
            <p><xref ref="ex-write-a-strip"/>, <xref ref="ex-write-dashed-sloping"/> and <xref ref="ex-write-through-origin"/> use the four panels of <xref ref="fig-exercise-regions"/>.</p>
            <figure xml:id="fig-exercise-regions">
                <caption>Four regions for the exercises. Key: shaded, not wanted; unshaded (<m>R</m>), the required region.</caption>
                <image width="80%">
                    <shortdescription>Four graphs in two rows. (a) A solid vertical line x = -1 and a dashed vertical line x = 4; left of x = -1 and right of x = 4 shaded; R the clear strip between them. (b) A dashed horizontal line y = 2; below it shaded; R above. (c) A dashed line through (7, 0) and (0, 3); the side containing the origin shaded; R away from the origin. (d) A solid line through (0, 0) and (2, 7); the side containing (1, 0) shaded; R contains (0, 1). Key: shaded, not wanted; unshaded (R), the required region.</shortdescription>
                    <latex-image>
\begin{tikzpicture}
\node at (0,0) {\begin{tikzpicture}[scale=0.5]
\draw[gray!40, very thin] (-3,-2) grid (6,4);
\fill[gray!45, fill opacity=0.6] (-3,-2) -- (-1,-2) -- (-1,4) -- (-3,4) -- cycle;
\fill[gray!45, fill opacity=0.6] (4,-2) -- (6,-2) -- (6,4) -- (4,4) -- cycle;
\draw[-stealth] (-3,0) -- (6+0.6,0) node[right] {$x$};
\draw[-stealth] (0,-2) -- (0,4+0.6) node[above] {$y$};
\node[below, font=\scriptsize] at (-3,0) {$-3$};
\node[below, font=\scriptsize] at (-2,0) {$-2$};
\node[below, font=\scriptsize] at (-1,0) {$-1$};
\node[below, font=\scriptsize] at (1,0) {$1$};
\node[below, font=\scriptsize] at (2,0) {$2$};
\node[below, font=\scriptsize] at (3,0) {$3$};
\node[below, font=\scriptsize] at (4,0) {$4$};
\node[below, font=\scriptsize] at (5,0) {$5$};
\node[below, font=\scriptsize] at (6,0) {$6$};
\node[left, font=\scriptsize] at (0,-2) {$-2$};
\node[left, font=\scriptsize] at (0,-1) {$-1$};
\node[left, font=\scriptsize] at (0,1) {$1$};
\node[left, font=\scriptsize] at (0,2) {$2$};
\node[left, font=\scriptsize] at (0,3) {$3$};
\node[left, font=\scriptsize] at (0,4) {$4$};
\draw[very thick] (-1,-2) -- (-1,4);
\draw[very thick, dashed] (4,-2) -- (4,4);
\node[font=\Large] at (1.5,1) {$R$};

\end{tikzpicture}};
\node at (0,-2.4) {(a)};
\node at (7,0) {\begin{tikzpicture}[scale=0.5]
\draw[gray!40, very thin] (-3,-2) grid (4,5);
\fill[gray!45, fill opacity=0.6] (-3,-2) -- (4,-2) -- (4,2) -- (-3,2) -- cycle;
\draw[-stealth] (-3,0) -- (4+0.6,0) node[right] {$x$};
\draw[-stealth] (0,-2) -- (0,5+0.6) node[above] {$y$};
\node[below, font=\scriptsize] at (-3,0) {$-3$};
\node[below, font=\scriptsize] at (-2,0) {$-2$};
\node[below, font=\scriptsize] at (-1,0) {$-1$};
\node[below, font=\scriptsize] at (1,0) {$1$};
\node[below, font=\scriptsize] at (2,0) {$2$};
\node[below, font=\scriptsize] at (3,0) {$3$};
\node[below, font=\scriptsize] at (4,0) {$4$};
\node[left, font=\scriptsize] at (0,-2) {$-2$};
\node[left, font=\scriptsize] at (0,-1) {$-1$};
\node[left, font=\scriptsize] at (0,1) {$1$};
\node[left, font=\scriptsize] at (0,2) {$2$};
\node[left, font=\scriptsize] at (0,3) {$3$};
\node[left, font=\scriptsize] at (0,4) {$4$};
\node[left, font=\scriptsize] at (0,5) {$5$};
\draw[very thick, dashed] (-3,2) -- (4,2);
\node[font=\Large] at (1,3.5) {$R$};

\end{tikzpicture}};
\node at (7,-2.4) {(b)};
\node at (0,-6.3) {\begin{tikzpicture}[scale=0.5]
\draw[gray!40, very thin] (-1,-1) grid (8,5);
\fill[gray!45, fill opacity=0.6] (-1,-1) -- (8,-1) -- (8,-0.4286) -- (-1,3.4286) -- cycle;
\draw[-stealth] (-1,0) -- (8+0.6,0) node[right] {$x$};
\draw[-stealth] (0,-1) -- (0,5+0.6) node[above] {$y$};
\node[below, font=\scriptsize] at (-1,0) {$-1$};
\node[below, font=\scriptsize] at (1,0) {$1$};
\node[below, font=\scriptsize] at (2,0) {$2$};
\node[below, font=\scriptsize] at (3,0) {$3$};
\node[below, font=\scriptsize] at (4,0) {$4$};
\node[below, font=\scriptsize] at (5,0) {$5$};
\node[below, font=\scriptsize] at (6,0) {$6$};
\node[below, font=\scriptsize] at (7,0) {$7$};
\node[below, font=\scriptsize] at (8,0) {$8$};
\node[left, font=\scriptsize] at (0,-1) {$-1$};
\node[left, font=\scriptsize] at (0,1) {$1$};
\node[left, font=\scriptsize] at (0,2) {$2$};
\node[left, font=\scriptsize] at (0,3) {$3$};
\node[left, font=\scriptsize] at (0,4) {$4$};
\node[left, font=\scriptsize] at (0,5) {$5$};
\draw[very thick, dashed] (-1,3.4286) -- (8,-0.4286);
\node[font=\Large] at (5,3) {$R$};

\end{tikzpicture}};
\node at (0,-9.6) {(c)};
\node at (7,-6.3) {\begin{tikzpicture}[scale=0.5]
\draw[gray!40, very thin] (-2,-1) grid (4,8);
\fill[gray!45, fill opacity=0.6] (-0.2857,-1) -- (4,-1) -- (4,8) -- (2.2857,8) -- cycle;
\draw[-stealth] (-2,0) -- (4+0.6,0) node[right] {$x$};
\draw[-stealth] (0,-1) -- (0,8+0.6) node[above] {$y$};
\node[below, font=\scriptsize] at (-2,0) {$-2$};
\node[below, font=\scriptsize] at (-1,0) {$-1$};
\node[below, font=\scriptsize] at (1,0) {$1$};
\node[below, font=\scriptsize] at (2,0) {$2$};
\node[below, font=\scriptsize] at (3,0) {$3$};
\node[below, font=\scriptsize] at (4,0) {$4$};
\node[left, font=\scriptsize] at (0,-1) {$-1$};
\node[left, font=\scriptsize] at (0,1) {$1$};
\node[left, font=\scriptsize] at (0,2) {$2$};
\node[left, font=\scriptsize] at (0,3) {$3$};
\node[left, font=\scriptsize] at (0,4) {$4$};
\node[left, font=\scriptsize] at (0,5) {$5$};
\node[left, font=\scriptsize] at (0,6) {$6$};
\node[left, font=\scriptsize] at (0,7) {$7$};
\node[left, font=\scriptsize] at (0,8) {$8$};
\draw[very thick] (-0.2857,-1) -- (2.2857,8);
\node[font=\Large] at (0.8,6.5) {$R$};

\end{tikzpicture}};
\node at (7,-9.6) {(d)};
\fill[gray!45, fill opacity=0.6] (-2,-10.6) rectangle (-1.4,-10.2); \draw (-2,-10.6) rectangle (-1.4,-10.2); \node[right, font=\small] at (-1.4,-10.4) {Shaded, not wanted; unshaded ($R$), the required region.};
\end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </introduction>
        <exercise xml:id="ex-write-a-strip">
            <statement><p>Write the inequalities for <m>R</m> in panels (a) and (b).</p></statement>
            <answer><p>(a) <m>-1 \le x \lt 4</m>; (b) <m>y \gt 2</m>.</p></answer>
        </exercise>
        <exercise xml:id="ex-write-dashed-sloping">
            <statement><p>Write the inequality for <m>R</m> in panel (c).</p></statement>
            <answer><p><m>3x + 7y \gt 21</m></p></answer>
            <solution><p>The line through <m>(7, 0)</m> and <m>(0, 3)</m> is <m>3x + 7y = 21</m>, dashed. <m>R</m> is away from the origin; the origin gives <m>0</m>, which is less than <m>21</m>, so <m>R</m> has <m>3x + 7y \gt 21</m>.</p></solution>
        </exercise>
        <exercise xml:id="ex-write-through-origin">
            <statement><p>Write the inequality for <m>R</m> in panel (d).</p></statement>
            <answer><p><m>7x - 2y \le 0</m>, or <m>2y \ge 7x</m>.</p></answer>
            <solution><p>The line through <m>(0, 0)</m> and <m>(2, 7)</m> is <m>y = \tfrac{7}{2}x</m>, that is <m>2y = 7x</m>, solid. <m>(0, 1)</m> is in <m>R</m>: <m>2 \ge 0</m>, so <m>2y \ge 7x</m>.</p></solution>
        </exercise>
        <exercise xml:id="ex-write-a-triangle">
            <statement>
                <p>Write the three inequalities for <m>R</m> in <xref ref="fig-ex-triangle-region"/>.</p>
                <figure xml:id="fig-ex-triangle-region">
                    <caption>A clear triangle for the exercise.</caption>
                    <image width="65%">
                        <shortdescription>x = 1 solid, y = 0 dashed, and a solid line through (9, 0) and (0, 2); the unwanted sides shaded; R the clear triangle with corners (1, 0), (9, 0), (1, 16/9). Key: shaded, not wanted; unshaded (R), the required region.</shortdescription>
                        <latex-image>
\begin{tikzpicture}[scale=0.55]
\draw[gray!40, very thin] (-1,-1) grid (10,3);
\fill[gray!45, fill opacity=0.6] (-1,-1) -- (1,-1) -- (1,3) -- (-1,3) -- cycle;
\fill[gray!45, fill opacity=0.6] (-1,-1) -- (10,-1) -- (10,0) -- (-1,0) -- cycle;
\fill[gray!45, fill opacity=0.6] (10,-0.2222) -- (10,3) -- (-1,3) -- (-1,2.2222) -- cycle;
\draw[-stealth] (-1,0) -- (10+0.6,0) node[right] {$x$};
\draw[-stealth] (0,-1) -- (0,3+0.6) node[above] {$y$};
\node[below, font=\scriptsize] at (-1,0) {$-1$};
\node[below, font=\scriptsize] at (1,0) {$1$};
\node[below, font=\scriptsize] at (2,0) {$2$};
\node[below, font=\scriptsize] at (3,0) {$3$};
\node[below, font=\scriptsize] at (4,0) {$4$};
\node[below, font=\scriptsize] at (5,0) {$5$};
\node[below, font=\scriptsize] at (6,0) {$6$};
\node[below, font=\scriptsize] at (7,0) {$7$};
\node[below, font=\scriptsize] at (8,0) {$8$};
\node[below, font=\scriptsize] at (9,0) {$9$};
\node[below, font=\scriptsize] at (10,0) {$10$};
\node[left, font=\scriptsize] at (0,-1) {$-1$};
\node[left, font=\scriptsize] at (0,1) {$1$};
\node[left, font=\scriptsize] at (0,2) {$2$};
\node[left, font=\scriptsize] at (0,3) {$3$};
\draw[very thick] (1,-1) -- (1,3);
\draw[very thick, dashed] (-1,0) -- (10,0);
\draw[very thick] (-1,2.2222) -- (10,-0.2222);
\node[font=\Large] at (2.6,0.6) {$R$};

\fill[gray!45, fill opacity=0.6] (-1,-2.6) rectangle (-1+0.8,-2.6+0.6); \draw (-1,-2.6) rectangle (-1+0.8,-2.6+0.6);
\node[right, font=\small] at (-1+0.8,-2.6+0.3) {Shaded, not wanted; unshaded ($R$), the required region.};
\end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </statement>
            <answer><p><m>x \ge 1</m>, <m>y \gt 0</m>, <m>2x + 9y \le 18</m>.</p></answer>
            <solution><p>The vertical line is <m>x = 1</m>, solid, with the left side shaded: <m>x \ge 1</m>. The <m>x</m>-axis is dashed with the side below shaded: <m>y \gt 0</m>. The sloping line through <m>(9, 0)</m> and <m>(0, 2)</m> is <m>\tfrac{x}{9} + \tfrac{y}{2} = 1</m>, that is <m>2x + 9y = 18</m>, solid. The origin is on the clear side and <m>0 \le 18</m>, so <m>2x + 9y \le 18</m>.</p></solution>
        </exercise>
        <exercise xml:id="ex-boda-boda-rules">
            <statement><p>A graph has a boda boda rider's age <m>a</m> years across (<m>0</m> to <m>60</m>) and the rider's speed in town <m>s\,\text{km/h}</m> up (<m>0</m> to <m>80</m>). <m>R</m> is a clear rectangle: on the left the solid line <m>a = 18</m>, on top the solid line <m>s = 50</m>, at the bottom <m>s = 0</m>. Write the inequalities and say what rules they show.</p></statement>
            <answer><p><m>a \ge 18</m> and <m>0 \le s \le 50</m>: riders must be at least <m>18</m> years old, and must keep to <m>50\,\text{km/h}</m> or less in town.</p></answer>
        </exercise>
        <exercise xml:id="ex-clear-square">
            <title>Challenge: A Clear Square</title>
            <statement><p><m>R</m> is the square with corners <m>(1, 3)</m>, <m>(5, 3)</m>, <m>(5, 7)</m> and <m>(1, 7)</m>. Its left and bottom edges are solid and the other two edges are dashed. Write the inequalities that define <m>R</m>.</p></statement>
            <hint><p>Use two compound inequalities.</p></hint>
            <answer><p><m>1 \le x \lt 5</m> and <m>3 \le y \lt 7</m>.</p></answer>
        </exercise>
    </exercises>

    <axiom component="lesson-plan">
        <title>Differentiation</title>
        <table xml:id="table-differentiation-inequalities-from-graphs">
            <title>Differentiation Strategies</title>
            <tabular halign="left" top="minor" bottom="minor" left="minor" right="minor">
                <row header="yes" bottom="medium"><cell>Learner Group</cell><cell>Strategy and Learning Experience</cell></row>
                <row><cell>Struggling Learners (Support)</cell><cell>Give a card with the three steps: equation, line style, direction. Work <xref ref="example-one-boundary"/>. Assign <xref ref="ex-write-a-strip"/> to <xref ref="ex-write-through-origin"/>.</cell></row>
                <row><cell>On-Level Learners (Core)</cell><cell>Full activity and all examples. Assign <xref ref="ex-write-a-strip"/> to <xref ref="ex-boda-boda-rules"/>.</cell></row>
                <row><cell>Advanced Learners (Challenge)</cell><cell>All exercises including <xref ref="ex-clear-square"/>. Extension: draw a clear region of your own with three boundaries and swap with a partner, who writes its inequalities and checks them with a test point.</cell></row>
            </tabular>
        </table>
    </axiom>

