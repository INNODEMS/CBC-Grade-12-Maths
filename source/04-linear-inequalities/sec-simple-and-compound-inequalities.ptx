            <stack label="stk-solving-a-compound-inequality" source="stack/top/1-numbers-and-algebra/04-linear-inequalities/01-simple-and-compound-inequalities/Solving-a-compound-inequality.xml"/>
        </exercise>

        <exercise xml:id="ex-reading-a-compound-inequality-from-a-number-line">
