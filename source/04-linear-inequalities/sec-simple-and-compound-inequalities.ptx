        </exercise>

        <exercise xml:id="ex-finding-the-mistake-in-solving-an-inequality">
            <!--<title></title>-->
            <stack label="stk-finding-the-mistake-in-solving-an-inequality" source="stack/top/1-numbers-and-algebra/04-linear-inequalities/01-simple-and-compound-inequalities/Finding-the-mistake-in-solving-an-inequality.xml"/>
        </exercise>

        <exercises xml:id="exercises-compound-inequalities">
            <exercise xml:id="ex-read-two-number-lines">
                <statement>
                    <p>Write the inequality shown on each number line in <xref ref="fig-two-compound-number-lines"/>.</p>
                    <figure xml:id="fig-two-compound-number-lines">
                        <caption>Two compound inequalities on number lines.</caption>
                        <image width="65%">
                            <shortdescription>Two number lines from -5 to 5. (a) An open circle at -4 and a filled circle at 2, joined by a thick line. (b) Filled circles at 0 and 4, joined by a thick line.</shortdescription>
                            <latex-image>
\begin{tikzpicture}[scale=0.6]
\draw[stealth-stealth] (-5-0.5,1.8) -- (5+0.5,1.8);
\draw (-5,1.8-0.1) -- (-5,1.8+0.1) node[below=6pt, font=\small] {$-5$};
\draw (-4,1.8-0.1) -- (-4,1.8+0.1) node[below=6pt, font=\small] {$-4$};
\draw (-3,1.8-0.1) -- (-3,1.8+0.1) node[below=6pt, font=\small] {$-3$};
\draw (-2,1.8-0.1) -- (-2,1.8+0.1) node[below=6pt, font=\small] {$-2$};
\draw (-1,1.8-0.1) -- (-1,1.8+0.1) node[below=6pt, font=\small] {$-1$};
\draw (0,1.8-0.1) -- (0,1.8+0.1) node[below=6pt, font=\small] {$0$};
\draw (1,1.8-0.1) -- (1,1.8+0.1) node[below=6pt, font=\small] {$1$};
\draw (2,1.8-0.1) -- (2,1.8+0.1) node[below=6pt, font=\small] {$2$};
\draw (3,1.8-0.1) -- (3,1.8+0.1) node[below=6pt, font=\small] {$3$};
\draw (4,1.8-0.1) -- (4,1.8+0.1) node[below=6pt, font=\small] {$4$};
\draw (5,1.8-0.1) -- (5,1.8+0.1) node[below=6pt, font=\small] {$5$};
\draw[line width=2.5pt] (-4,1.8) -- (2,1.8);
\filldraw[fill=white, thick] (-4,1.8) circle (5pt);
\filldraw[fill=black, thick] (2,1.8) circle (5pt);
\node[left] at (-5-0.7,1.8) {(a)};
\draw[stealth-stealth] (-5-0.5,0) -- (5+0.5,0);
\draw (-5,0-0.1) -- (-5,0+0.1) node[below=6pt, font=\small] {$-5$};
\draw (-4,0-0.1) -- (-4,0+0.1) node[below=6pt, font=\small] {$-4$};
\draw (-3,0-0.1) -- (-3,0+0.1) node[below=6pt, font=\small] {$-3$};
\draw (-2,0-0.1) -- (-2,0+0.1) node[below=6pt, font=\small] {$-2$};
\draw (-1,0-0.1) -- (-1,0+0.1) node[below=6pt, font=\small] {$-1$};
\draw (0,0-0.1) -- (0,0+0.1) node[below=6pt, font=\small] {$0$};
\draw (1,0-0.1) -- (1,0+0.1) node[below=6pt, font=\small] {$1$};
\draw (2,0-0.1) -- (2,0+0.1) node[below=6pt, font=\small] {$2$};
\draw (3,0-0.1) -- (3,0+0.1) node[below=6pt, font=\small] {$3$};
\draw (4,0-0.1) -- (4,0+0.1) node[below=6pt, font=\small] {$4$};
\draw (5,0-0.1) -- (5,0+0.1) node[below=6pt, font=\small] {$5$};
\draw[line width=2.5pt] (0,0) -- (4,0);
\filldraw[fill=black, thick] (0,0) circle (5pt);
\filldraw[fill=black, thick] (4,0) circle (5pt);
\node[left] at (-5-0.7,0) {(b)};
\end{tikzpicture}
                            </latex-image>
                        </image>
                    </figure>
                </statement>
                <answer><p>(a) <m>-4 \lt x \le 2</m>; (b) <m>0 \le x \le 4</m>.</p></answer>
            </exercise>
            <exercise xml:id="ex-solve-compound-add">
                <statement><p>Solve <m>5 \lt x + 7 \le 12</m>.</p></statement>
                <answer><p><m>-2 \lt x \le 5</m></p></answer>
                <solution><p>Subtract <m>7</m> from every part: <m>-2 \lt x \le 5</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-solve-compound-and-list">
                <statement><p>Solve <m>-6 \le 4x + 2 \lt 18</m> and list the integers that satisfy it.</p></statement>
                <answer><p><m>-2 \le x \lt 4</m>; the integers are <m>-2, -1, 0, 1, 2, 3</m> (six integers).</p></answer>
                <solution><p>Subtract <m>2</m>: <m>-8 \le 4x \lt 16</m>. Divide by <m>4</m>: <m>-2 \le x \lt 4</m>. <m>-2</m> is included and <m>4</m> is not.</p></solution>
            </exercise>
            <exercise xml:id="ex-solve-compound-negative">
                <statement><p>Solve <m>1 \le 7 - 2x \lt 9</m>.</p></statement>
                <answer><p><m>-1 \lt x \le 3</m></p></answer>
                <solution><p>Subtract <m>7</m>: <m>-6 \le -2x \lt 2</m>. Divide by <m>-2</m>, turning both signs: <m>3 \ge x \gt -1</m>. Smaller number first: <m>-1 \lt x \le 3</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-bus-hire">
                <statement><p>Hiring a bus for a school trip costs Ksh <m>4000</m> plus Ksh <m>150</m> for each learner. The class wants the total cost to be between Ksh <m>7000</m> and Ksh <m>9000</m>, including both amounts. How many learners can go?</p></statement>
                <answer><p>From <m>20</m> to <m>33</m> learners.</p></answer>
                <solution><p><m>7000 \le 4000 + 150n \le 9000</m>. Subtract <m>4000</m>: <m>3000 \le 150n \le 5000</m>. Divide by <m>150</m>: <m>20 \le n \le 33\tfrac{1}{3}</m>. <m>n</m> is a whole number, so <m>20 \le n \le 33</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-integers-satisfying-both">
                <title>Challenge: Integers Satisfying Both</title>
                <statement><p>Find every integer <m>x</m> with <m>5x - 4 \lt 26</m> and <m>1 - x \le 4</m>.</p></statement>
                <hint><p>Solve each inequality first.</p></hint>
                <answer><p><m>-3, -2, -1, 0, 1, 2, 3, 4, 5</m> (nine integers)</p></answer>
                <solution><p><m>5x \lt 30</m>, so <m>x \lt 6</m>. <m>1 \le 4 + x</m>, so <m>x \ge -3</m>. Together <m>-3 \le x \lt 6</m>: the integers from <m>-3</m> to <m>5</m>.</p></solution>
            </exercise>
        </exercises>

        <axiom component="lesson-plan">
            <title>Differentiation</title>
            <table xml:id="table-differentiation-compound-inequalities">
                <title>Differentiation Strategies</title>
                <tabular halign="left" top="minor" bottom="minor" left="minor" right="minor">
                    <row header="yes" bottom="medium"><cell>Learner Group</cell><cell>Strategy and Learning Experience</cell></row>
                    <row><cell>Struggling Learners (Support)</cell><cell>Give a three-column card, <q>left part, middle, right part</q>, so that every step is done to all three. Work <xref ref="example-solving-a-compound-inequality"/>. Assign <xref ref="ex-read-two-number-lines"/> to <xref ref="ex-solve-compound-and-list"/>.</cell></row>
                    <row><cell>On-Level Learners (Core)</cell><cell>Full activity and all examples. Assign <xref ref="ex-read-two-number-lines"/> to <xref ref="ex-bus-hire"/>.</cell></row>
                    <row><cell>Advanced Learners (Challenge)</cell><cell>All exercises including <xref ref="ex-integers-satisfying-both"/>. Extension: find <m>p</m> and <m>q</m> if <m>p \lt 3x - 1 \le q</m> has the solution <m>2 \lt x \le 5</m>. (Answer: <m>p = 5</m>, <m>q = 14</m>.)</cell></row>
                </tabular>
            </table>
        </axiom>

