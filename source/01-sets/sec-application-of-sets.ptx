        </exercise>

        <exercise xml:id="ex-build-a-survey-result">
            <!--<title></title>-->
            <stack label="stk-build-a-survey-result" source="stack/top/1-numbers-and-algebra/01-sets/06-application-of-sets/Build-a-survey-result.xml"/>
        </exercise>

        <exercises xml:id="exercises-surveys-with-two-sets">
            <exercise xml:id="ex-reflector-jackets">
                <statement><p>Of <m>55</m> boda boda riders in Nakuru, <m>38</m> wear a reflector jacket, <m>29</m> have a phone holder and <m>4</m> have neither. How many have both?</p></statement>
                <answer><p><m>16</m></p></answer>
            </exercise>
            <exercise xml:id="ex-business-and-computer">
                <statement><p>In a class of <m>72</m>, the number who take Business Studies only is <m>2x</m>, Computer Studies only <m>x + 6</m>, both <m>x</m>, and <m>10</m> take neither. Find <m>x</m>.</p></statement>
                <answer><p><m>x = 14</m></p></answer>
                <solution><p><m>2x + (x + 6) + x + 10 = 72</m>, so <m>4x + 16 = 72</m> and <m>x = 14</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-sixty-twelve-none">
                <statement><p>Of <m>60</m> learners, <m>12</m> take neither Geography nor History, <m>31</m> take Geography and <m>26</m> take History. How many take both?</p></statement>
                <answer><p><m>9</m></p></answer>
            </exercise>
            <exercise xml:id="ex-impossible-report">
                <statement><p>A report on <m>36</m> learners says <m>21</m> are in the choir, <m>19</m> in the drama club, <m>3</m> in both and <m>2</m> in neither. Is this possible?</p></statement>
                <answer><p>No: <m>n(C \cup D) = 21 + 19 - 3 = 37 \gt 36</m>.</p></answer>
            </exercise>
            <exercise xml:id="ex-solar-check">
                <statement><p>Check the answer to <xref ref="example-solar-lamps-and-water-tanks"/> by adding the four regions.</p></statement>
                <answer><p><m>32 + 9 + 24 + 5 = 70</m></p></answer>
            </exercise>
        </exercises>

        <exercises xml:id="exercises-overlap-challenge" component="core">
            <title>Challenge for Core</title>
            <exercise xml:id="ex-rice-and-chapati-overlap">
                <statement><p>In a class of <m>50</m>, <m>36</m> learners like rice and <m>29</m> like chapati. Find the greatest and least possible numbers who like both.</p></statement>
                <answer><p>Greatest <m>29</m>; least <m>36 + 29 - 50 = 15</m></p></answer>
            </exercise>
        </exercises>

        <axiom component="lesson-plan">
            <title>Differentiation</title>
            <table xml:id="table-differentiation-surveys-with-two-sets">
                <title>Differentiation Strategies</title>
                <tabular halign="left" top="minor" bottom="minor" left="minor" right="minor">
                    <row header="yes" bottom="medium"><cell>Learner Group</cell><cell>Strategy and Learning Experience</cell></row>
                    <row><cell>Struggling Learners (Support)</cell><cell>Work through the activity and <xref ref="example-solar-lamps-and-water-tanks"/>. Assign <xref ref="ex-reflector-jackets"/> and <xref ref="ex-solar-check"/>.</cell></row>
                    <row><cell>On-Level Learners (Core)</cell><cell>Full activity and all examples. Assign all the exercises.</cell></row>
                    <row><cell>Advanced Learners (Challenge)</cell><cell><xref ref="ex-impossible-report"/>, then change one number in it to make the report possible.</cell></row>
                </tabular>
            </table>
            <p component="core">Core: advanced learners also work through <xref ref="ex-rice-and-chapati-overlap"/>.</p>
        </axiom>

        <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />
