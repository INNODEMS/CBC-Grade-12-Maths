        <exercise xml:id="ex-find-the-mistake-in-a-three-set-diagram">
            <!--<title></title>-->
            <stack label="stk-find-the-mistake-in-a-three-set-diagram" source="stack/top/1-numbers-and-algebra/01-sets/05-venn-diagrams/Find-the-mistake-in-a-three-set-diagram.xml"/>
