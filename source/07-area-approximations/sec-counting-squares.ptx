  \node[below, font=\small] at (0,0) {$0$};
  \node[below, font=\small] at (1,0) {$1$};
  \node[below, font=\small] at (2,0) {$2$};
  \node[below, font=\small] at (3,0) {$3$};
  \node[below, font=\small] at (4,0) {$4$};
  \node[below, font=\small] at (5,0) {$5$};
  \node[below, font=\small] at (6,0) {$6$};
  \node[left, font=\small] at (0,0) {$0$};
  \node[left, font=\small] at (0,1) {$1$};
  \node[left, font=\small] at (0,2) {$2$};
  \node[left, font=\small] at (0,3) {$3$};
  \node[left, font=\small] at (0,4) {$4$};
  \node[left, font=\small] at (0,5) {$5$};
  \node[left, font=\small] at (0,6) {$6$};
