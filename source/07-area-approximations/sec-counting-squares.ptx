        <exercises xml:id="exercises-counting-squares-under-a-curve">
            <exercise xml:id="ex-count-under-curve">
                <statement>
                    <p>Estimate the area of the region bounded by the curve <m>y = 4 + 0.3x - 0.1x^2</m>, the <m>x</m>-axis and the lines <m>x = 0</m> and <m>x = 6</m>, by counting the unit squares.</p>
                    <figure xml:id="fig-exercise-under-curve">
                        <caption>The region under <m>y = 4 + 0.3x - 0.1x^2</m> from <m>x = 0</m> to <m>x = 6</m>.</caption>
                        <image width="60%">
                            <shortdescription>A region under a curve from x = 0 to x = 6 on unit squares. The curve starts at height 4, rises a little, then falls to 2.2 at x = 6.</shortdescription>
                            <latex-image>
