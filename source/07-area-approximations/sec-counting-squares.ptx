  \node[rotate=90] at (-1.3,3) {$y$};
\end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </statement>
            <solution>
                <p>Count column by column. The full squares are <m>4 + 5 + 5 + 5 + 4 + 3 = 26</m> and the part squares <m>2 + 1 + 1 + 1 + 2 + 2 = 9</m>. So
                    <md>\text{estimate} = 26 + \tfrac{1}{2} \times 9 = 30.5 \text{ square units}</md></p>
            </solution>
        </example>

        <example xml:id="example-flower-bed-nakuru">
            <title>A Flower Bed in Nakuru</title>
            <statement>
                <p>A flower bed in a park in Nakuru lies between a straight path and a curved hedge. On the plan, each square stands for <m>5\,\text{m}</m> along the path and <m>2\,\text{m}</m> across it. Estimate the area of the flower bed.</p>
                <figure xml:id="fig-flower-bed-grid">
                    <caption>The flower bed on squares <m>5\,\text{m}</m> wide and <m>2\,\text{m}</m> tall. Full squares are shaded; part squares are dotted.</caption>
                    <image width="60%">
                        <shortdescription>A flower bed between a straight path along the bottom and a curved hedge, 35 m long, on squares 5 m wide and 2 m tall: 22 full squares shaded and 9 part squares dotted.</shortdescription>
                        <description><p>Full squares: 22. Part squares: 9. Each square is 5 m along the path and 2 m across.</p></description>
                        <latex-image>
\begin{tikzpicture}[x=0.7cm,y=0.7cm]
  \fill[gray!45] (0,0) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (0,1) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (0,2) rectangle ++(1,1);
  \fill[gray!45] (1,0) rectangle ++(1,1);
  \fill[gray!45] (1,1) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (1,2) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (1,3) rectangle ++(1,1);
  \fill[gray!45] (2,0) rectangle ++(1,1);
  \fill[gray!45] (2,1) rectangle ++(1,1);
  \fill[gray!45] (2,2) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (2,3) rectangle ++(1,1);
  \fill[gray!45] (3,0) rectangle ++(1,1);
  \fill[gray!45] (3,1) rectangle ++(1,1);
  \fill[gray!45] (3,2) rectangle ++(1,1);
  \fill[gray!45] (3,3) rectangle ++(1,1);
  \fill[pattern=dots, pattern color=gray] (3,4) rectangle ++(1,1);
  \fill[gray!45] (4,0) rectangle ++(1,1);
  \fill[gray!45] (4,1) rectangle ++(1,1);
