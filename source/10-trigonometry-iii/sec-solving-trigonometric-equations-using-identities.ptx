        </exercise>

        <exercise xml:id="ex-equations-in-sin-squared-and-cos-squared">
            <!--<title></title>-->
            <stack label="stk-equations-in-sin-squared-and-cos-squared" source="stack/top/2-measurement-and-geometry/10-trigonometry-iii/03-solving-trigonometric-equations-using-identities/Equations-in-sin-squared-and-cos-squared.xml"/>
        </exercise>

        <exercise xml:id="ex-constructing-an-equation-with-given-solutions">
            <!--<title></title>-->
            <stack label="stk-constructing-an-equation-with-given-solutions" source="stack/top/2-measurement-and-geometry/10-trigonometry-iii/03-solving-trigonometric-equations-using-identities/Constructing-an-equation-with-given-solutions.xml"/>
        </exercise>

        <exercises xml:id="exercises-further-trigonometric-equations">
            <introduction><p>Solve each equation for <m>0^\circ \le x \le 360^\circ</m>.</p></introduction>
            <exercise xml:id="ex-tan-squared-four-thirds">
                <statement><p><m>3\sin^2 x = 4\cos^2 x</m></p></statement>
                <answer><p><m>\{49.1^\circ, 130.9^\circ, 229.1^\circ, 310.9^\circ\}</m></p></answer>
            </exercise>
            <exercise xml:id="ex-tan-squared-nine-quarters">
                <statement><p><m>4\sin^2 x = 9\cos^2 x</m></p></statement>
                <answer><p><m>\{56.3^\circ, 123.7^\circ, 236.3^\circ, 303.7^\circ\}</m></p></answer>
            </exercise>
            <exercise xml:id="ex-formula-cos-squared-plus-two-sin">
                <statement><p><m>\cos^2 x + 2\sin x = 1.5</m></p></statement>
                <answer><p><m>\{17.0^\circ, 163.0^\circ\}</m></p></answer>
                <solution><p><m>\sin^2 x - 2\sin x + 0.5 = 0</m>, so <m>\sin x = 1 \pm \sqrt{0.5}</m>. <m>1 + \sqrt{0.5}</m> is rejected; <m>\sin x = 1 - \sqrt{0.5} = 0.2929</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-factorise-two-cos-squared">
                <statement><p><m>2\cos^2 x - 3\sin x = 0</m></p></statement>
                <answer><p><m>\{30^\circ, 150^\circ\}</m></p></answer>
                <solution><p><m>2\sin^2 x + 3\sin x - 2 = (2\sin x - 1)(\sin x + 2) = 0</m>; <m>\sin x = -2</m> is impossible.</p></solution>
            </exercise>
            <exercise xml:id="ex-sin-equals-tan">
                <statement><p><m>\sin x = \tan x</m></p></statement>
                <answer><p><m>\{0^\circ, 180^\circ, 360^\circ\}</m></p></answer>
                <solution><p><m>\sin x\cos x = \sin x</m>, so <m>\sin x(\cos x - 1) = 0</m>: <m>\sin x = 0</m> or <m>\cos x = 1</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-two-cos-squared-minus-sin-squared">
                <statement><p><m>2\cos^2 x - \sin^2 x = 0.5</m></p></statement>
                <answer><p><m>\{45^\circ, 135^\circ, 225^\circ, 315^\circ\}</m></p></answer>
                <solution><p><m>2 - 3\sin^2 x = 0.5</m>, so <m>\sin^2 x = 0.5</m> and <m>\sin x = \pm 0.7071</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-no-solution-proof">
                <title>Challenge: No Solutions</title>
                <statement><p>Show that <m>2\sin^2 x + \cos x = 3</m> has no solutions.</p></statement>
                <hint><p>Write the equation as a quadratic in <m>\cos x</m> and look at its discriminant.</p></hint>
                <answer><p><m>2\cos^2 x - \cos x + 1 = 0</m> has discriminant <m>1 - 8 = -7 \lt 0</m>, so there is no value of <m>\cos x</m>. (Also: the left side is never more than <m>2.125</m>.)</p></answer>
            </exercise>
        </exercises>

        <axiom component="lesson-plan">
            <title>Differentiation</title>
            <table xml:id="table-differentiation-further-trigonometric-equations">
                <title>Differentiation Strategies</title>
                <tabular halign="left" top="minor" bottom="minor" left="minor" right="minor">
                    <row header="yes" bottom="medium"><cell>Learner Group</cell><cell>Strategy and Learning Experience</cell></row>
                    <row><cell>Struggling Learners (Support)</cell><cell>Provide a method chooser: squares of both ratios, divide; a common factor, factorise; otherwise the identity, then a quadratic. Work through <xref ref="example-dividing-by-cos-squared"/> and <xref ref="example-using-the-formula"/>. Assign <xref ref="ex-tan-squared-four-thirds"/> and <xref ref="ex-factorise-two-cos-squared"/>.</cell></row>
                    <row><cell>On-Level Learners (Core)</cell><cell>Full activity and all examples. Assign <xref ref="ex-tan-squared-four-thirds"/> to <xref ref="ex-two-cos-squared-minus-sin-squared"/>.</cell></row>
                    <row><cell>Advanced Learners (Challenge)</cell><cell>All exercises including <xref ref="ex-no-solution-proof"/>. Extension: solve <m>\sin^2 x = 3\cos^2 x</m> for <m>0^\circ \le x \le 720^\circ</m> and describe the pattern. (Answer: <m>\{60^\circ, 120^\circ, 240^\circ, 300^\circ, 420^\circ, 480^\circ, 600^\circ, 660^\circ\}</m>: add <m>360^\circ</m> to each of the first four.)</cell></row>
                </tabular>
            </table>
        </axiom>

        <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />
