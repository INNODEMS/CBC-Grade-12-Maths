\draw[dashed] (D) -- (A); \draw[dashed] (D) -- (C); \draw[dashed] (D) -- (V);
\draw (A) -- (B) -- (C) -- (V) -- (B);
\draw[very thick] (A) -- (V); \draw[very thick] (V) -- (M);
\draw[dotted, very thick] (V) -- (O); \draw[thick, dashed] (O) -- (A); \draw[thick, dashed] (O) -- (M);
\fill (O) circle (1.5pt); \fill (M) circle (1.5pt);
\node[anchor=north east] at (A) {$A$};
\node[anchor=north west] at (B) {$B$};
\node[anchor=west] at (C) {$C$};
\node[anchor=east] at (D) {$D$};
\node[anchor=south] at (V) {$V$};
\node[anchor=north] at (O) {$O$};
\node[anchor=west] at (M) {$M$};
\node[anchor=north] at (10,5,0) {$10$};
\end{scope}
\begin{scope}[shift={(4.2,-1.4)}, scale=0.25]
\draw[thick] (0,0) node[anchor=north east]{$A$} -- (7.071,0) node[anchor=north west]{$O$} -- (7.071,12) node[anchor=south]{$V$} -- cycle;
\draw (6.271,0) -- (6.271,0.8) -- (7.071,0.8);
\node[anchor=north] at (3.5,0) {$\sqrt{50}$}; \node[anchor=west] at (7.071,6) {$12$}; \node[anchor=south east] at (3.5,6) {$\sqrt{194}$};
\end{scope}
\begin{scope}[shift={(7.6,-1.4)}, scale=0.25]
\draw[thick] (0,0) node[anchor=north east]{$M$} -- (5,0) node[anchor=north west]{$O$} -- (5,12) node[anchor=south]{$V$} -- cycle;
\draw (4.2,0) -- (4.2,0.8) -- (5,0.8);
\node[anchor=north] at (2.5,0) {$5$}; \node[anchor=west] at (5,6) {$12$}; \node[anchor=south east] at (2.5,6) {$13$};
\end{scope}
\end{tikzpicture}
            </latex-image>
        </image>
    </figure>

    <figure xml:id="fig-cuboid-diagonals">
        <caption>Move the sliders to change the cuboid. The two right-angled triangles give the base diagonal and then the space diagonal.</caption>
        <interactive xml:id="interactive-cuboid-diagonals" platform="jsxgraph" width="90%" aspect="16:12" source="jsxgraph/cuboid-diagonals.js">
            <slate xml:id="jsxgraph-cuboid-diagonals" surface="jsxboard" aspect="16:12"/>
            <instructions>
                <p>
                    <ul>
                        <li><p>Drag the <alert>l</alert>, <alert>w</alert> and <alert>h</alert> sliders. The dashed base diagonal <m>AC</m> is the hypotenuse of triangle <m>ABC</m>, and the space diagonal <m>AG</m> is the hypotenuse of triangle <m>ACG</m>.</p></li>
                        <li><p>Set <alert>l</alert> to <m>6</m>, <alert>w</alert> to <m>2</m> and <alert>h</alert> to <m>1.5</m>. Check that <m>AG</m> is exactly <m>6.5</m>.</p></li>
                        <li><p>Keep <alert>l</alert> and <alert>w</alert> fixed and change <alert>h</alert>. Which length changes, and which does not? Turn the cuboid with the view sliders.</p></li>
                    </ul>
                </p>
            </instructions>
        </interactive>
    </figure>

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <example xml:id="example-diagonals-of-a-water-tank">
        <title>Diagonals of a Water Tank</title>
        <statement>
            <p>A water tank at a school in Machakos is a cuboid <m>ABCDEFGH</m> with <m>AB = 3.6\,\text{m}</m>, <m>BC = 2.4\,\text{m}</m> and <m>AE = 1.5\,\text{m}</m>. Find the length of the base diagonal <m>AC</m> and of the space diagonal <m>AG</m>.</p>
        </statement>
        <solution>
            <p><alert>Step 1:</alert> triangle <m>ABC</m> has a right angle at <m>B</m>:
                <md>AC^2 = 3.6^2 + 2.4^2 = 18.72, \quad AC = \sqrt{18.72} \approx 4.33 \,\text{m}</md>
                <m>AC</m> is the projection of <m>AG</m> on the base.</p>
            <p><alert>Step 2:</alert> triangle <m>ACG</m> has a right angle at <m>C</m>:
                <md>AG^2 = 18.72 + 1.5^2 = 20.97, \quad AG = \sqrt{20.97} \approx 4.58 \,\text{m}</md>
                We used <m>AC^2 = 18.72</m>, not the rounded <m>4.33^2</m>, so no accuracy was lost.</p>
        </solution>
    </example>

    <example xml:id="example-edges-of-a-pyramid">
        <title>Edges of a Pyramid</title>
        <statement>
            <p>A model of a right pyramid <m>VABCD</m> has a square base of side <m>10\,\text{cm}</m> and height <m>VO = 12\,\text{cm}</m> (<xref ref="fig-pyramid-lengths"/>). <m>M</m> is the midpoint of <m>BC</m>. Find the length of (a) <m>OA</m>, the projection of <m>VA</m> on the base; (b) the sloping edge <m>VA</m>; (c) the slant height <m>VM</m>.</p>
        </statement>
        <solution>
            <p>(a) <m>AC^2 = 10^2 + 10^2 = 200</m>, and <m>O</m> is the midpoint of <m>AC</m>, so <m>OA = \frac{1}{2}\sqrt{200} = \sqrt{50} \approx 7.07\,\text{cm}</m>.</p>
            <p>(b) Triangle <m>VOA</m> has a right angle at <m>O</m>: <m>VA^2 = 50 + 12^2 = 194</m>, so <m>VA = \sqrt{194} \approx 13.93\,\text{cm}</m>.</p>
            <p>(c) <m>OM</m> is half of <m>AB</m>, so <m>OM = 5\,\text{cm}</m>. Triangle <m>VOM</m> has a right angle at <m>O</m>: <m>VM = \sqrt{5^2 + 12^2} = \sqrt{169} = 13\,\text{cm}</m>.</p>
            <p>The sloping edge <m>VA</m> and the slant height <m>VM</m> are different lengths: <m>VA</m> runs to a corner, <m>VM</m> to the middle of a side.</p>
        </solution>
    </example>

    <example xml:id="example-line-across-a-tent">
        <title>A Line Across a Tent</title>
        <statement>
            <p>The tent <m>ABCDEF</m> in <xref ref="fig-tent-prism"/> has <m>AB = 2.4\,\text{m}</m>, <m>CA = CB = 1.5\,\text{m}</m> and <m>AD = 3\,\text{m}</m>, so its height <m>CN</m> is <m>0.9\,\text{m}</m>. Find the length of the line <m>AF</m> from a front corner to the back of the ridge.</p>
        </statement>
        <solution>
            <p><m>F</m> is directly above <m>P</m>, the midpoint of <m>DE</m>, so the projection of <m>AF</m> on the ground is <m>AP</m>. Triangle <m>ADP</m> has a right angle at <m>D</m>, with <m>DP = 1.2\,\text{m}</m>:
                <md>AP^2 = 1.2^2 + 3^2 = 10.44, \quad AP = \sqrt{10.44} \approx 3.23 \,\text{m}</md>
                Triangle <m>APF</m> has a right angle at <m>P</m>, with <m>PF = 0.9\,\text{m}</m>:
                <md>AF^2 = 10.44 + 0.9^2 = 11.25, \quad AF = \sqrt{11.25} \approx 3.35 \,\text{m}</md></p>
        </solution>
    </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />
    <xi:include href="../lesson-plan-templates/checkpoint.ptx" />

    <p>Type decimals with a point, for example <c>13.93</c>. A length may also be typed exactly, for example <c>sqrt(194)</c>. In the last question type whole numbers only.</p>

