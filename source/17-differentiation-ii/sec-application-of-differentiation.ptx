            <stack label="stk-greatest-area-of-a-pen-against-a-wall" source="stack/top/4-calculus/17-differentiation-ii/03-application-of-differentiation/Greatest-area-of-a-pen-against-a-wall.xml"/>
        </exercise>

        <exercise xml:id="ex-greatest-volume-of-an-open-box">
