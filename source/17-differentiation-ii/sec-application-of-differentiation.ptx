    <title>Application of Differentiation: Maxima, Minima and Kinematics</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        4.0 Calculus
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        4.1 Differentiation II
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p>
                        Apply differentiation to maxima and minima in different situations; Apply differentiation in kinematics
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        3 lessons of 40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
