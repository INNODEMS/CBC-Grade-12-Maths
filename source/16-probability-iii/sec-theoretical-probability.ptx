<section xml:id="sec-theoretical-probability" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Theoretical Probability</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        3.0 Statistics and Probability
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        3.2 Probability III
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p>
                        Determine discrete probabilities in different situations
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        2 lessons of 40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- Planning notes (from the Combined Mathematics tab of the Grade 12 Book Structure Mapping sheet)
         Content summary: Theoretical probability: P(E) = favourable outcomes ÷ total possible outcomes.
         Suggested activity: Learners list the outcomes of tossing a coin and rolling a die and find theoretical probabilities of given events. -->

    <!-- Section notes (2026-11)
