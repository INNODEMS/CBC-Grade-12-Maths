\draw (2.70,-2.40) -- (4.90,-1.20) node[pos=0.5, above=1pt, fill=white, inner sep=1pt] {$0.6$};
\node[anchor=west] at (4.95,-1.20) {G};
\draw (2.70,-2.40) -- (4.90,-3.60) node[pos=0.5, below=1pt, fill=white, inner sep=1pt] {$0.4$};
\node[anchor=west] at (4.95,-3.60) {R};
\draw (5.40,3.60) -- (7.60,4.20) node[pos=0.5, above=1pt, fill=white, inner sep=1pt] {$0.6$};
\node[anchor=west] at (7.65,4.20) {G};
\draw (5.40,3.60) -- (7.60,3.00) node[pos=0.5, below=1pt, fill=white, inner sep=1pt] {$0.4$};
\node[anchor=west] at (7.65,3.00) {R};
\draw (5.40,1.20) -- (7.60,1.80) node[pos=0.5, above=1pt, fill=white, inner sep=1pt] {$0.6$};
\node[anchor=west] at (7.65,1.80) {G};
\draw (5.40,1.20) -- (7.60,0.60) node[pos=0.5, below=1pt, fill=white, inner sep=1pt] {$0.4$};
\node[anchor=west] at (7.65,0.60) {R};
\draw (5.40,-1.20) -- (7.60,-0.60) node[pos=0.5, above=1pt, fill=white, inner sep=1pt] {$0.6$};
\node[anchor=west] at (7.65,-0.60) {G};
\draw (5.40,-1.20) -- (7.60,-1.80) node[pos=0.5, below=1pt, fill=white, inner sep=1pt] {$0.4$};
\node[anchor=west] at (7.65,-1.80) {R};
\draw (5.40,-3.60) -- (7.60,-3.00) node[pos=0.5, above=1pt, fill=white, inner sep=1pt] {$0.6$};
\node[anchor=west] at (7.65,-3.00) {G};
\draw (5.40,-3.60) -- (7.60,-4.20) node[pos=0.5, below=1pt, fill=white, inner sep=1pt] {$0.4$};
\node[anchor=west] at (7.65,-4.20) {R};
\node[anchor=west] at (8.45,4.20) {GGG: $0.216$};
\node[anchor=west] at (8.45,3.00) {GGR: $0.144$};
\node[anchor=west] at (8.45,1.80) {GRG: $0.144$};
\node[anchor=west] at (8.45,0.60) {GRR: $0.096$};
\node[anchor=west] at (8.45,-0.60) {RGG: $0.144$};
\node[anchor=west] at (8.45,-1.80) {RGR: $0.096$};
