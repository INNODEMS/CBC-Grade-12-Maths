<section xml:id="sec-combined-events" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Combined Events</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        3.0 Statistics and Probability
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        3.2 Probability III
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        Determine probability of mutually exclusive and independent events
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        2 lessons of 40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>


    <!-- Planning notes (from the Combined Mathematics tab of the Grade 12 Book Structure Mapping sheet)
         Sheet title: Combined events (mutually exclusive, independent events)
         Content summary: Combined events: mutually exclusive events and independent events.
         Suggested activity: Learners identify mutually exclusive and independent events from everyday examples, e.g. choosing safe means of transport. -->

    <!-- Section notes (2026-11)
