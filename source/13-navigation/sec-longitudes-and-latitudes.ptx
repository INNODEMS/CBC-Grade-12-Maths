% MARK: towns at their positions in degrees and minutes
\fill (36.817,-1.283) circle (2.5pt) node[below right, font=\small] {Nairobi};
\fill (39.667,-4.050) circle (2.5pt) node[below right, font=\small] {Mombasa};
