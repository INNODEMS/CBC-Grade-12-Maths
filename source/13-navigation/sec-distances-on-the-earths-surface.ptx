<section xml:id="sec-distances-on-the-earths-surface" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Distances on the Earth's Surface</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        2.0 Measurements and Geometry
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p component="core">
                        2.7 Navigation
                    </p>
                    <p component="essential">
                        2.3 Navigation
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p component="core">
                        Determine distance along parallels of longitude and latitude in nautical miles and in kilometres
                    </p>
                    <p component="essential">
                        Determine distance along parallels of longitude and latitude in kilometres and in nautical miles
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        12
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        2 lessons of 40 minutes
                    </p>
                </li>
            </dl>
            </p>
