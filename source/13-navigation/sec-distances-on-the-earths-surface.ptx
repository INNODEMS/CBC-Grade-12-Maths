        <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />
        <xi:include href="../lesson-plan-templates/checkpoint.ptx" />

        <p>Type decimals with a point, for example <c>36.8</c>. Type angles in degrees as numbers, without the degree sign. Choose N, S, E or W from each list. Take <m>\pi = \tfrac{22}{7}</m> and <m>R = 6370\,\text{km}</m>. Distances in km within 0.1% of the exact value are accepted.</p>

        <exercise xml:id="ex-distance-along-a-parallel">
            <!--<title></title>-->
            <stack label="stk-distance-along-a-parallel" source="stack/top/2-measurement-and-geometry/13-navigation/02-distances-on-the-earths-surface/Distance-along-a-parallel.xml"/>
        </exercise>

        <exercise xml:id="ex-over-the-pole-or-along-the-parallel">
            <!--<title></title>-->
            <stack label="stk-over-the-pole-or-along-the-parallel" source="stack/top/2-measurement-and-geometry/13-navigation/02-distances-on-the-earths-surface/Over-the-pole-or-along-the-parallel.xml"/>
        </exercise>

        <exercises xml:id="exercises-distance-along-a-parallel">
            <exercise xml:id="ex-parallel-30n">
                <statement><p>Find the distance along the parallel <m>30^\circ\,\text{N}</m> between the meridians <m>10^\circ\,\text{E}</m> and <m>50^\circ\,\text{E}</m>, in nautical miles and in kilometres.</p></statement>
                <answer><p><m>2078.5\,\text{nm}</m>; <m>3852.9\,\text{km}</m></p></answer>
                <solution><p>Difference in longitude <m>40^\circ = 2400'</m>. <m>2400 \cos 30^\circ = 2078.5\,\text{nm}</m>; <m>\tfrac{40}{360} \times 40\,040 \times \cos 30^\circ = 3852.9\,\text{km}</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-parallel-52s">
                <statement><p>Find the distance along the parallel <m>52^\circ\,\text{S}</m> between the meridians <m>20^\circ\,\text{W}</m> and <m>35^\circ\,\text{E}</m>, in nautical miles and in kilometres.</p></statement>
                <answer><p><m>2031.7\,\text{nm}</m>; <m>3766.1\,\text{km}</m></p></answer>
                <solution><p>Opposite sides of Greenwich: <m>20^\circ + 35^\circ = 55^\circ = 3300'</m>. <m>3300 \cos 52^\circ = 2031.7\,\text{nm}</m>; <m>\tfrac{55}{360} \times 40\,040 \times \cos 52^\circ = 3766.1\,\text{km}</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-lodwar-towards-mandera">
                <statement><p>Take Lodwar <m>(35^\circ 36'\,\text{E})</m> and Mandera <m>(41^\circ 52'\,\text{E})</m> both to be on the parallel <m>3^\circ\,\text{N}</m>. Find the distance between them along the parallel in nautical miles and in kilometres.</p></statement>
                <answer><p><m>375.5\,\text{nm}</m>; <m>696.0\,\text{km}</m></p></answer>
                <solution><p><m>41^\circ 52' - 35^\circ 36' = 6^\circ 16' = 376'</m>. <m>376 \cos 3^\circ = 375.5\,\text{nm}</m>; <m>6\tfrac{16}{60} \div 360 \times 40\,040 \times \cos 3^\circ = 696.0\,\text{km}</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-ship-west-from-port-louis">
                <statement><p>A ship leaves Port Louis in Mauritius, taken to be at <m>(20^\circ\,\text{S},\ 57^\circ 30'\,\text{E})</m>, and sails <m>600\,\text{nm}</m> due west along the parallel. Find its new longitude, to the nearest minute.</p></statement>
                <answer><p><m>46^\circ 51'\,\text{E}</m></p></answer>
                <solution><p>Each degree of longitude on <m>20^\circ\,\text{S}</m> is <m>60\cos 20^\circ = 56.38\,\text{nm}</m>. Change in longitude <m>= 600 \div (60 \cos 20^\circ) = 10.642^\circ = 10^\circ 39'</m>. Sailing west from an east longitude decreases it: <m>57^\circ 30' - 10^\circ 39' = 46^\circ 51'\,\text{E}</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-pole-or-parallel-70s">
                <statement><p>P is at <m>(70^\circ\,\text{S},\ 25^\circ\,\text{E})</m> and Q at <m>(70^\circ\,\text{S},\ 155^\circ\,\text{W})</m>. Compare the distance from P to Q along the parallel with the distance over the South Pole.</p></statement>
                <answer><p>Parallel <m>3693.8\,\text{nm}</m>; over the pole <m>2400\,\text{nm}</m>; the route over the pole is shorter.</p></answer>
                <solution><p><m>25 + 155 = 180</m>: opposite meridians. Along the parallel: <m>10\,800 \cos 70^\circ = 3693.8\,\text{nm}</m>. Over the pole: <m>2 \times (90^\circ - 70^\circ) = 40^\circ = 2400'</m>, so <m>2400\,\text{nm}</m>.</p></solution>
            </exercise>
            <exercise xml:id="ex-latitude-for-a-given-distance">
                <title>Challenge: Which Parallel?</title>
                <statement><p>Along which parallel of latitude is the distance between the meridians <m>0^\circ</m> and <m>60^\circ\,\text{E}</m> equal to <m>1800\,\text{nm}</m>?</p></statement>
                <hint><p>On the equator the distance is <m>3600\,\text{nm}</m>.</p></hint>
                <answer><p><m>60^\circ\,\text{N}</m> or <m>60^\circ\,\text{S}</m></p></answer>
                <solution><p><m>60^\circ = 3600'</m>, so <m>3600\cos\phi = 1800</m>, <m>\cos\phi = \tfrac{1}{2}</m> and <m>\phi = 60^\circ</m>. The parallel is <m>60^\circ\,\text{N}</m> or <m>60^\circ\,\text{S}</m>.</p></solution>
            </exercise>
        </exercises>

        <axiom component="lesson-plan">
            <title>Differentiation</title>
            <table xml:id="table-differentiation-distance-along-a-parallel">
                <title>Differentiation Strategies</title>
                <tabular halign="left" top="minor" bottom="minor" left="minor" right="minor">
                    <row header="yes" bottom="medium"><cell>Learner Group</cell><cell>Strategy and Learning Experience</cell></row>
                    <row><cell>Struggling Learners (Support)</cell><cell>The activity and <xref ref="example-mombasa-to-the-seychelles"/>. Give a card: <q>parallel: multiply by <m>\cos(\text{latitude})</m></q>. Assign <xref ref="ex-parallel-30n"/> and <xref ref="ex-lodwar-towards-mandera"/>.</cell></row>
                    <row><cell>On-Level Learners (Core)</cell><cell>Full activity and all examples. Assign <xref ref="ex-parallel-30n"/> to <xref ref="ex-pole-or-parallel-70s"/>.</cell></row>
                    <row><cell>Advanced Learners (Challenge)</cell><cell>All exercises including <xref ref="ex-latitude-for-a-given-distance"/>. Extension: why is the route along a parallel never the shortest unless the two points are on the equator? (Answer: of all the parallels, only the equator is a great circle.)</cell></row>
                </tabular>
            </table>
        </axiom>

        <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />
