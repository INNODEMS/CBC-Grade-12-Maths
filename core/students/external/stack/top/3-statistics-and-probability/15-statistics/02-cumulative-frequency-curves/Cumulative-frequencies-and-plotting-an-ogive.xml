  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: cumulative frequency table, plotted at upper class boundaries. Source: adapted from SMP AS/A2 Statistics 1, chapter 1, section D introduction. */
flist: [[2,4,12,15,12,12],[13,10,8,5,5,2],[5,14,15,14,7,4],[9,14,13,8,8,6],[5,7,13,9,7,3],[5,6,15,13,7,4],[6,14,9,9,7,4],[8,10,8,3,2,2],[4,4,10,14,15,3],[2,4,12,13,8,3]];
ix: 1+rand(10);
f: flist[ix];
w: rand([5,10]);
lo1: if w=5 then rand([10,15,20]) else rand([10,20,30]);
j: 2+rand(4);
lo: makelist(lo1+(t-1)*w,t,1,6);
hi: makelist(lo1+t*w-1,t,1,6);
cf: makelist(sum(f[i],i,1,t),t,1,6);
n: cf[6];
lcb1: lo1-1/2;
ucbj: lo1+j*w-1/2;
ucb: makelist(lo1+t*w-1/2,t,1,6);
/* diagnostics */
hij: lo1+j*w-1;
midj: lo1+(j-1)*w+(w-1)/2;
lcbj: lo1+(j-1)*w-1/2;
ucb1: lo1+w-1/2;
/* test values */
cfp: cf+1;
lcbm: lcb1-1;
ucbp: ucbj+1;]]></text>
  </questionvariables>
