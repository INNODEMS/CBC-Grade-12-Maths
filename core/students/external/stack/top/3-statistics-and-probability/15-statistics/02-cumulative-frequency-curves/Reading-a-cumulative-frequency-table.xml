  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: only the cumulative frequencies are shown. Source: original. */
P: [[[5,15,13,9,9,3],3,3,5],[[2,3,4,6,13,12],3,5,3],[[5,9,9,11,14,3],3,5,5],[[10,10,13,15,8,5],4,5,3],[[7,13,15,14,7,7],3,5,3],[[4,7,8,8,14,9],4,4,4],[[10,10,13,10,9,8],3,3,3],[[4,7,11,11,15,11],3,3,3],[[12,12,12,14,10,7],2,5,5],[[4,6,8,9,10,11],2,5,5]];
ix: 1+rand(10);
f: P[ix][1];
k: P[ix][2];
j: P[ix][3];
m: P[ix][4];
lo: makelist(10*t,t,1,6);
hi: makelist(10*t+9,t,1,6);
ucb: makelist(10*t+19/2,t,1,6);
cf: makelist(sum(f[i],i,1,t),t,1,6);
n: cf[6];
ta1: cf[k];
ta2: n-cf[j];
ta3: cf[m]-cf[m-1];
/* diagnostics */
d1a: f[k];
d1b: cf[k+1];
d2a: cf[j];
d2b: n-cf[j-1];
d3a: cf[m];]]></text>
  </questionvariables>
