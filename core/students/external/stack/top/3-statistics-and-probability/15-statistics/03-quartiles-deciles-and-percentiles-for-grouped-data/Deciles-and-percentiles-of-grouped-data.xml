  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: the diagnostic checks position k against k% of n. n is never 100 and no variant asks for a decile and an equal percentile (j is never 10k). Entries 4 and 8 use j = 45 and j = 65, since j = 85 would exceed n there. Source: original. */
P: [[[19,20,15,10,10,6],2,15],[[7,17,22,14,6,4],7,65],[[3,8,8,12,16,13],8,35],[[3,6,6,10,15,11],1,45],[[10,12,13,13,17,14],9,15],[[5,10,10,20,9,9],8,35],[[8,22,18,18,10,10],3,35],[[7,16,17,20,11,4],2,65],[[9,20,17,11,5,5],8,65],[[7,8,21,20,20,14],2,85]];
ix: 1+rand(10);
f: P[ix][1];
k: P[ix][2];
j: P[ix][3];
lo1: rand([10,20,30]);
w: 10;
L1: lo1-1/2;
cf: makelist(sum(f[i],i,1,t),t,1,length(f));
n: last(cf);
lcb: makelist(L1+(t-1)*w,t,1,length(f));
cb(p) := 1+length(sublist(cf,lambda([c],is(c<p))));
cfb(k) := if k=1 then 0 else cf[k-1];
gq(p) := lcb[cb(p)] + (p-cfb(cb(p)))/f[cb(p)]*w;
lo: makelist(lo1+(t-1)*w,t,1,6);
hi: makelist(lo1+t*w-1,t,1,6);
pd: k*n/10;
pp: j*n/100;
kD: cb(pd); kP: cb(pp);
Dk: gq(pd);
Pj: gq(pp);
Dd: dispdp(float(floor(10^1*(Dk)+1/2)/10^1),1);
Pd: dispdp(float(floor(10^1*(Pj)+1/2)/10^1),1);
/* diagnostics */
Dlim: Dk+1/2; Dposk: gq(k); DasP: gq(k*n/100);
Plim: Pj+1/2; Pposj: gq(j);
/* test values */
Dr: float(floor(10^1*(Dk)+1/2)/10^1);
Pr: float(floor(10^1*(Pj)+1/2)/10^1);
Do: Dr+1; Po: Pr+1;
Dlimr: float(floor(10^1*(Dlim)+1/2)/10^1);
Plimr: float(floor(10^1*(Plim)+1/2)/10^1);
Dposkr: float(floor(10^1*(Dposk)+1/2)/10^1);
Pposjr: float(floor(10^1*(Pposj)+1/2)/10^1);
DasPr: float(floor(10^1*(DasP)+1/2)/10^1);]]></text>
  </questionvariables>
