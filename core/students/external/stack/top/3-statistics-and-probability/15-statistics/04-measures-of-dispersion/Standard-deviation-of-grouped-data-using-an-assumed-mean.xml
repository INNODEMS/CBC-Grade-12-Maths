  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
pad3(r) := if r<10 then sconcat("00",r) elseif r<100 then sconcat("0",r) else sconcat(r);
grpm(v) := if v<0 then sconcat("-",grpm(-v)) elseif v<10000 then sconcat(v) elseif v<1000000 then sconcat(floor(v/1000),"\\,",pad3(mod(v,1000))) else sconcat(floor(v/1000000),"\\,",pad3(mod(floor(v/1000),1000)),"\\,",pad3(mod(v,1000)));
/* Design: coded grouped mean and SD, subtraction only. Six continuous classes from a, width w; A is the midpoint of class P[ix][4]. Source: adapted from SMP AS/A2 Statistics 1, chapter 2, section D, Example 4. */
P: [[[5,8,15,7,5,3],200,200,4],[[2,4,8,13,10,2],10,30,3],[[2,11,15,11,10,3],200,200,4],[[11,9,8,8,5,2],20,40,3],[[11,13,9,7,5,2],20,60,3],[[5,10,13,8,7,5],10,30,4],[[7,9,15,11,10,7],20,60,3],[[2,9,12,11,11,2],10,40,3],[[6,11,11,14,8,3],10,40,3],[[6,11,4,4,4,2],10,20,3]];
ix: 1+rand(10);
f: P[ix][1];
w: P[ix][2];
a: P[ix][3];
A: a+w/2+w*(P[ix][4]-1);
vl: if w=10 then "t" elseif w=20 then "m" else "e";
mid: makelist(a+w/2+w*(i-1),i,1,6);
lo: makelist(a+w*(i-1),i,1,6);
dv: mid-A;
n: apply("+",f);
fd: makelist(f[i]*dv[i],i,1,6);
fd2: makelist(f[i]*dv[i]^2,i,1,6);
Sfd: apply("+",fd);
Sfd2: apply("+",fd2);
mn: A+Sfd/n;
vr: Sfd2/n-(Sfd/n)^2;
sdv: sqrt(vr);
aSfd: abs(Sfd);
mnd: dispdp(float(floor(10^1*(mn)+1/2)/10^1),1);
sdd: dispdp(float(floor(10^2*(sdv)+1/2)/10^2),2);
/* variance to 3 d.p., integer part grouped with thin spaces from five digits (house locale rule) */
vr3: floor(1000*vr+1/2);
vrd: sconcat(grpm(floor(vr3/1000)),".",pad3(mod(vr3,1000)));
/* diagnostics */
negSfd: -Sfd;
fdsq: sum((f[i]*dv[i])^2,i,1,6);
unsq: sum(abs(f[i]*dv[i]),i,1,6);
dbar: Sfd/n;
mnsign: A-Sfd/n;
sdplusA: sdv+A;
sdnosub: sqrt(Sfd2/n);
sdn1: sqrt(vr*n/(n-1));
/* test values */
mn1: float(floor(10^1*(mn)+1/2)/10^1);
sd2: float(floor(10^2*(sdv)+1/2)/10^2);
dbar1: float(floor(10^1*(dbar)+1/2)/10^1);
mnsign1: float(floor(10^1*(mnsign)+1/2)/10^1);
sdplusA2: float(floor(10^2*(sdplusA)+1/2)/10^2);
sdnosub2: float(floor(10^2*(sdnosub)+1/2)/10^2);
sdn12: float(floor(10^2*(sdn1)+1/2)/10^2);
vr2: float(floor(10^2*(vr)+1/2)/10^2);
Sfd2p: Sfd2+2*n*(w/10)^2;
ft2: float(floor(10^2*(sqrt((Sfd2+2*n*(w/10)^2)/n-(Sfd/n)^2))+1/2)/10^2);
tcar: float(floor(10^2*(sqrt(Sfd2/n-(mn1-A)^2))+1/2)/10^2);
tcar4: if is(abs(tcar-sdn1)>0.00501) then tcar else sd2;]]></text>
