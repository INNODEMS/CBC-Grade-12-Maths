  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: subtract a constant to find the mean and SD, as a frequency table. Source: adapted from SMP AS/A2 Statistics 1, chapter 2, section C, C7. */
P: [[[3,4,8,14,10,2],63,3],[[2,2,14,9,5,3],48,3],[[6,6,11,13,6,5],47,3],[[2,2,6,9,13,7],48,2],[[10,12,5,3,3,2],65,2],[[5,5,5,11,10,9],45,2],[[2,2,6,8,13,8],62,3],[[14,12,7,6,2,2],63,3],[[3,3,4,7,14,8],65,2],[[8,13,7,12,6,4],47,3]];
/* Keep every list's carried-rounding value different from the n-1 slip value. */
ix: 1+rand(10);
f: P[ix][1];
x0: P[ix][2];
A: x0+P[ix][3];
xv: makelist(x0+k-1,k,1,6);
dv: xv-A;
n: apply("+",f);
Sfd: sum(f[k]*dv[k],k,1,6);
Sfd2: sum(f[k]*dv[k]^2,k,1,6);
mn: A+Sfd/n;
vr: Sfd2/n-(Sfd/n)^2;
sdv: sqrt(vr);
eggs: is(x0<=48);
mnd: dispdp(float(floor(10^1*(mn)+1/2)/10^1),1);
sdd: dispdp(float(floor(10^2*(sdv)+1/2)/10^2),2);
vrd: dispdp(float(floor(10^3*(vr)+1/2)/10^3),3);
/* diagnostics */
negSfd: -Sfd;
fdsq: sum((f[k]*dv[k])^2,k,1,6);
unsq: sum(abs(f[k]*dv[k]),k,1,6);
dbar: Sfd/n;
mnsign: A-Sfd/n;
sdplusA: sdv+A;
sdnosub: sqrt(Sfd2/n);
sdn1: sqrt(vr*n/(n-1));
/* test values */
mn1: float(floor(10^1*(mn)+1/2)/10^1);
sd2: float(floor(10^2*(sdv)+1/2)/10^2);
dbar1: float(floor(10^1*(dbar)+1/2)/10^1);
mnsign1: float(floor(10^1*(mnsign)+1/2)/10^1);
sdplusA2: float(floor(10^2*(sdplusA)+1/2)/10^2);
sdnosub2: float(floor(10^2*(sdnosub)+1/2)/10^2);
sdn12: float(floor(10^2*(sdn1)+1/2)/10^2);
vr2: float(floor(10^2*(vr)+1/2)/10^2);
Sfd2p: Sfd2+2*n;
ft2: float(floor(10^2*(sqrt((Sfd2+2*n)/n-(Sfd/n)^2))+1/2)/10^2);
tcar: float(floor(10^2*(sqrt(Sfd2/n-(mn1-A)^2))+1/2)/10^2);
tcar4: if is(abs(tcar-sdn1)>0.00501) then tcar else sd2;
aSfd: abs(Sfd);]]></text>
