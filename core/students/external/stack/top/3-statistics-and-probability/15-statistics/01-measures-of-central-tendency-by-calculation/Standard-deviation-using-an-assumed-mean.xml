  <prt><name>prt4</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[rad: ans2/n-(ans1/n)^2;
ft: if is(rad>=0) then sqrt(rad) else -1000;
okm: is(abs(ans3-mn)<=0.0501);
rc: Sfd2/n-(ans3-A)^2;
