  <questionvariables>
    <text><![CDATA[/* Design: three identical independent stages. p values are chosen so the answers stay well separated (2/3, 1/5 and 1/2 are not used). Source: original. */
PL: [1/4,1/3,3/4,3/10,3/5,7/10,4/5,9/10,2/5,1/4];
ix: 1+rand(10);
p: PL[ix];
ta1: p^3; ta2: 3*p^2*(1-p); ta3: 1-(1-p)^3;
tl1: min(1/200,ta1/20); tl2: min(1/200,ta2/20); tl3: min(1/200,ta3/20);
/* diagnostics */
add1: 3*p;
one2: p^2*(1-p);
two2: p^2;
add3: 3*p;
notall3: 1-p^3;]]></text>
  </questionvariables>
