  <questionvariables>
    <text><![CDATA[validate_x(ex) := if every(lambda([v], is(v=x)), listofvars(ex)) then "" else "Use only the letter x.";
/* Design: find-the-mistake pattern. Source: original. er 1: (x+b)^2 = x^2+bx+b^2 (line 2); er 2: cell b*2bx written 2bx (line 3); er 3: one b^2x term lost when collecting (line 4). */
L: [[2,1],[3,2],[4,3],[5,1],[6,2],[3,3],[4,1],[5,2],[6,3],[2,2]];
ix: 1+rand(10);
b: L[ix][1];
er: L[ix][2];
ta: expand((x+b)^3);
m2: if er=1 then b else 2*b;
sqd: x^2+m2*x+b^2;
c: [x^3, m2*x^2, b^2*x, b*x^2, if er=2 then m2*x else m2*b*x, b^3];
bar: if er=3 then x^3+3*b*x^2+2*b^2*x+b^3 else apply("+",c);
m2x: m2*x;
b2: b^2;
opts: [["l1",false,"Line 1"],["l2",is(er=1),"Line 2"],["l3",is(er=2),"Line 3"],["l4",is(er=3),"Line 4"]];
kq: first(mcq_correct(opts));
wrl: if er=3 then "l2" else "l4";
wline: if er=1 then 2 else if er=2 then 3 else 4;
sq: expand((x+b)^2);
t2: 2*b*x;
chk: (1+b)^3;
b1: 1+b;]]></text>
  </questionvariables>
