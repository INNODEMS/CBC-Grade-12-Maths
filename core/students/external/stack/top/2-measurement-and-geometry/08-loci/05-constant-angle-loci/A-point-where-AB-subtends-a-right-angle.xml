<quiz>
<question type="stack">
  <name><text>A point where AB subtends a right angle</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>\(A\) is \(({@A[1]@}, {@A[2]@})\) and \(B\) is \(({@B[1]@}, {@B[2]@})\). Give a point \(P\), not \(A\) or \(B\), with whole-number coordinates, such that angle \(APB = 90^{\circ}\).</p><div>\(P = \big(\)[[input:ans1]], [[input:ans2]]\(\big)\) [[validation:ans1]] [[validation:ans2]] [[feedback:prt1]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>Angle \(APB = 90^{\circ}\) exactly when \(P\) is on the circle with diameter \(AB\) (the angle in a semicircle), apart from \(A\) and \(B\). Its centre is the midpoint \(M({@M[1]@}, {@M[2]@})\) and its radius is \(\tfrac{1}{2}AB = {@r@}\).</p><p>So look for whole-number moves \((p, q)\) from \(M\) with \(p^2 + q^2 = {@r^2@}\). For example \(({@tp[1][1]@}, {@tp[1][2]@})\) and \(({@tp[2][1]@}, {@tp[2][2]@})\) both work.</p>]]></text>
  </generalfeedback>
  <defaultgrade>1</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* Design: give a point where AB subtends a right angle; any correct point scores. Entries [M, v]: A = M - v, B = M + v, radius |v|. Test points per entry: [on the circle 1, on the circle 2, on AB, on the perpendicular bisector, 2r from M]. Source: original. */
q53: [[[1,2],[3,4]],[[-2,1],[4,3]],[[0,-1],[5,0]],[[2,-2],[0,5]],[[-1,-3],[-3,4]],[[3,0],[4,-3]],[[-3,2],[6,8]],[[1,-1],[8,6]],[[-2,-2],[5,12]],[[2,3],[-4,3]]];
q53t: [[[-3,5],[4,-2],[10,14],[-11,11],[7,-6]],[[-5,5],[2,-2],[10,10],[-11,13],[6,-5]],[[0,4],[0,-6],[3,-1],[0,2],[6,7]],[[-3,-2],[7,-2],[2,1],[-1,-2],[8,6]],[[-5,-6],[-4,-7],[-10,9],[-13,-12],[-7,-11]],[[6,4],[7,3],[15,-9],[12,12],[11,6]],[[-11,8],[3,-6],[6,14],[-15,11],[9,-14]],[[-5,7],[9,-7],[13,8],[-8,11],[17,-13]],[[-14,3],[3,-14],[13,34],[-38,13],[8,-26]],[[-1,-1],[-2,0],[-10,12],[-7,-9],[-6,-3]]];
ix: 1+rand(10);
M: q53[ix][1]; v: q53[ix][2];
A: M-v; B: M+v;
r: sqrt(v.v);
tp: q53t[ix];
ta1: tp[1][1]; ta2: tp[1][2];]]></text>
  </questionvariables>
