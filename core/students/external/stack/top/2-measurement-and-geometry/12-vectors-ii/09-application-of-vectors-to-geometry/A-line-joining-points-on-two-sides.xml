  <questionvariables>
    <text><![CDATA[validate_ab(ex) := block([s, ca, cb], if not every(lambda([vv], member(vv, [a,b])), listofvars(ex)) then "Use only the vectors a and b." else (s: ev(expand(ex), simp), ca: ev(coeff(s,a), simp), cb: ev(coeff(s,b), simp), if ev(is(s - ca*a - cb*b = 0), simp) and ev(numberp(float(ca)) and numberp(float(cb)), simp) then "" else "Write your answer as a number times a plus a number times b, for example 3/5*a+2/5*b."));
texput(a,"\\mathbf{a}"); texput(b,"\\mathbf{b}");
/* Design: a line joining points on two sides of a triangle, in a general ratio; (1,1) is the midpoint theorem. Source: adapted from SMP AS/A2 Core 4, Chapter 9, Exercise A, Q5 (a line joining midpoints is parallel to a diagonal). */
rlist: [[1,1],[2,1],[1,2],[3,1],[1,3],[2,3],[3,2],[3,4],[4,1],[1,4]];
ix: 1+rand(10);
m: rlist[ix][1]; n: rlist[ix][2];
kq: m/(m+n); ta1: kq*a; ta2: kq*b-kq*a;
d1: m/n*a; d2: kq*a-kq*b; d31: m/n; d32: -kq;
wrongfrac: if kq = 1/3 then 1/2 else 1/3;
wfs: if kq = 1/3 then "\\(\\dfrac{1}{2}\\)" else "\\(\\dfrac{1}{3}\\)";
opts: [["meet", false, "PQ and AB meet at a point"], ["par", true, "PQ is parallel to AB"], ["col", false, "P, Q, A and B are collinear"], ["frac", false, sconcat("PQ is ", wfs, " of the length of AB")]];
ta4: first(mcq_correct(opts));
w1: ta1+b; w2: ta2+a; w3: kq+1;
f1: kq*a+a; f2: kq*b-f1; f3: kq+3;
]]></text>
