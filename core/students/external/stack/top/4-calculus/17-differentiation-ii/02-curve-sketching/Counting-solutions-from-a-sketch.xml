  <questionvariables>
    <text><![CDATA[/* Design: a0 > 0, so the maximum is at p0 and the minimum at q0. Case 3: k strictly between the stationary values (the integer below their mean); 1hi: ymax + 3; 1lo: ymin - 2; 2max: ymax; 2min: ymin. Source: original. */
L: [[1,-1,1,2,"3"],[2,-2,2,1,"1hi"],[1,-1,5,2,"2max"],[2,-1,2,4,"3"],[1,-3,1,0,"1lo"],[2,1,3,5,"2min"],[1,-4,0,-3,"3"],[2,-2,1,1,"1hi"],[1,1,5,2,"2max"],[2,-1,1,6,"3"]];
ix: 1+rand(10);
a0: L[ix][1]; p0: L[ix][2]; q0: L[ix][3]; d0: L[ix][4]; cs: L[ix][5];
f: expand((a0)*x^3-3*(a0)*((p0)+(q0))/2*x^2+3*(a0)*(p0)*(q0)*x+(d0));
df: diff(f,x);
ymax: ev(f,x=p0); ymin: ev(f,x=q0);
kq: if cs="3" then floor((ymax+ymin)/2) elseif cs="1hi" then ymax+3 elseif cs="1lo" then ymin-2 elseif cs="2max" then ymax else ymin;
ns: if cs="3" then 3 elseif cs="1hi" or cs="1lo" then 1 else 2;
hi: if cs="1hi" then 1 else 0;
diag3: if ns=3 then 2 else 3;
/* sketch window */
xl: p0-2; xr: q0+2; yl: min(ymin,kq,ev(f,x=xl)); yu: max(ymax,kq,ev(f,x=xr)); pd: (yu-yl)/8+1;]]></text>
  </questionvariables>
