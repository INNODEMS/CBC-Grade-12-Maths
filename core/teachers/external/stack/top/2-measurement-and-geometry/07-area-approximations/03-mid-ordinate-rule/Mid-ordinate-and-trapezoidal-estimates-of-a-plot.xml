  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
g3(v) := block([q,r], if v < 1000 then string(v) else (q: floor(v/1000), r: v - 1000*q, sconcat(g3(q), "\\,", if r < 10 then "00" elseif r < 100 then "0" else "", string(r))));
thou(v) := if v < 10000 then string(v) else g3(v);
/* Design: mid-ordinate and trapezoidal estimates of a plot. Entries [g, n, widths every g m (2n + 1 of them), price per m^2]. Edges at even positions, middles at odd. Source: original. */
L: [[5,4,[21,27,32,35,37,38,38,36,33],2000],[10,3,[38,43,46,47,46,42,36],1500],[5,3,[46,50,52,51,48,43,34],3000],[10,4,[39,43,47,48,49,48,46,43,38],1500],[4,4,[34,36,37,37,36,35,33,30,26],4000],[5,4,[24,26,27,27,26,25,23,20,16],2500],[10,3,[46,50,51,49,45,38,29],2000],[4,3,[39,43,45,44,41,34,26],3000],[5,3,[20,23,24,23,19,13,5],2500],[10,4,[9,13,16,18,19,20,20,19,17],1500]];
ix: 1+rand(10);
g: L[ix][1]; n: L[ix][2]; wl: L[ix][3]; p: L[ix][4];
hh: 2*g; Lr: 2*n*g;
xs: makelist(j*g,j,0,2*n);
wmid: makelist(wl[2*j],j,1,n);
wedge: makelist(wl[2*j-1],j,1,n+1);
Ma: hh*apply("+",wmid);
Ta: hh/2*(first(wedge)+last(wedge)+2*apply("+",rest(rest(wedge),-1)));
D: abs(Ma-Ta)*p;
NP: rand([["Wairimu","she"],["Kiptoo","he"],["Akinyi","she"],["Mwangi","he"]]);
nm: NP[1]; pr: NP[2];
Dd: thou(D); MVd: thou(Ma*p); TVd: thou(Ta*p);
/* diagnostics */
Ml: hh*apply("+",rest(wedge,-1)); Mr: hh*apply("+",rest(wedge));
Mall: g*apply("+",wl); Modd: g*apply("+",wmid);
Tfine: g/2*(first(wl)+last(wl)+2*apply("+",rest(rest(wl),-1)));
T2: 2*Ta; Thalf: g*apply("+",wedge);
Ddiff: abs(Ma-Ta); DM: Ma*p; DT: Ta*p;]]></text>
  </questionvariables>
