  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[cosd(x) := cos(x*%pi/180);
sind(x) := sin(x*%pi/180);
atand(x) := 180*atan(x)/%pi;
asind(x) := 180*asin(x)/%pi;
two(v) := if v < 10 then sconcat("0", string(v)) else string(v);
hm(m) := block([q], q: mod(m, 1440), sconcat(two(floor(q/60)), ":", two(mod(q, 60))));
dmx(m) := sconcat(string(floor(m/60)), "^\\circ", two(mod(m, 60)), "'");
/* Design: [phi, N/S, l1, l2 (signed, east positive), speed in knots]. Times in minutes. Source: original. */
L: [[32,"N",5,40,420],[50,"S",20,55,380],[20,"S",35,70,460],[60,"N",-10,30,360],[40,"S",-60,-25,480],[25,"N",-80,-40,500],[55,"S",15,40,340],[35,"N",50,85,420],[45,"S",100,130,400],[15,"N",-30,-5,440]];
ix: 1+rand(10);
E: L[ix];
phi: E[1]; v: E[5];
east: is(E[4]>E[3]);
dl: abs(E[4]-E[3]);
nm: 60*dl*cosd(phi);
hrs: nm/v;
tmin: hrs*60;
tr: floor(tmin+1/2);
/* diagnostics (entry 9 is at 45 degrees, where sin = cos: there the sin node takes the sentinel -1, used only by its test) */
nocos: 60*dl; snm: if phi=45 then -1 else 60*dl*sind(phi); dvc: 60*dl/cosd(phi);
nct: 3600*dl/v;
decm: 60*floor(hrs)+100*(hrs-floor(hrs));
]]></text>
  </questionvariables>
