  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[]]></text></feedbackvariables>
    <node><name>0</name><description>Ground speed</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>gs</tans><testoptions>0.0501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>1.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-1-T</trueanswernote><truefeedback format="html"><text><![CDATA[]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>1</falsenextnode><falseanswernote>prt1-1-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>1</name><description>Added speeds</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>sm</tans><testoptions>0.0501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-2-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>You added the speeds: \({@v@} + {@u@}\). Speeds add only when the current flows the same way as the boat. Here the current is at right angles to the course, so the two arrows are the shorter sides of a right-angled triangle and the track arrow is its hypotenuse.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>2</falsenextnode><falseanswernote>prt1-2-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>2</name><description>Subtracted speeds</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>df</tans><testoptions>0.0501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-3-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>You subtracted the speeds: \({@v@} - {@u@}\). Speeds subtract only when the current flows against the boat. Here the current is at right angles to the course, so the two arrows are the shorter sides of a right-angled triangle and the track arrow is its hypotenuse.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>3</falsenextnode><falseanswernote>prt1-3-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>3</name><description>Subtracted squares</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>py</tans><testoptions>0.0501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-4-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>The ground speed is the hypotenuse of the triangle, so add the squares.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>-1</falsenextnode><falseanswernote>prt1-4-F</falseanswernote><falsefeedback format="html"><text><![CDATA[<p>The course and current arrows are at right angles, and the track arrow is the hypotenuse. Test your answer with Pythagoras: \({@ans1@}^2 = {@dispdp(float(ans1^2),2)@}\). Compare that with \({@v@}^2 + {@u@}^2\).</p>]]></text></falsefeedback></node>
