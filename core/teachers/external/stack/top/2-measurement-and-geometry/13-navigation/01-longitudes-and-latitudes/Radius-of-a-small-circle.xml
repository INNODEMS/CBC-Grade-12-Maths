  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[yh: float(sqrt(ans1^2+d^2));]]></text></feedbackvariables>
    <node><name>0</name><description>Radius of the surface</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>r</tans><testoptions>0.00501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>1.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-1-T</trueanswernote><truefeedback format="html"><text><![CDATA[]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>1</falsenextnode><falseanswernote>prt1-1-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>1</name><description>Subtracted lengths</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>dRd</tans><testoptions>0.00501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-2-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>You subtracted the lengths: \({@exd(Rb)@} - {@exd(d)@}\). The radius of the surface, the distance \({@exd(d)@}\,\text{m}\) and the tank's radius \({@exd(Rb)@}\,\text{m}\) form a right-angled triangle with \({@exd(Rb)@}\,\text{m}\) as the hypotenuse.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>2</falsenextnode><falseanswernote>prt1-2-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>2</name><description>Added squares</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>dpl</tans><testoptions>0.00501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-3-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>You added the squares: \(\sqrt{ {@exd(Rb)@}^2 + {@exd(d)@}^2}\). That makes the water surface wider than the tank. The tank's radius \({@exd(Rb)@}\,\text{m}\) is the hypotenuse, the longest side of the triangle.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>3</falsenextnode><falseanswernote>prt1-3-F</falseanswernote><falsefeedback format="html"><text><![CDATA[]]></text></falsefeedback></node>
    <node><name>3</name><description>No square root</description><answertest>NumAbsolute</answertest><sans>ans1</sans><tans>dnr</tans><testoptions>0.00501</testoptions><quiet>0</quiet><truescoremode>=</truescoremode><truescore>0.0000000</truescore><truepenalty></truepenalty><truenextnode>-1</truenextnode><trueanswernote>prt1-4-T</trueanswernote><truefeedback format="html"><text><![CDATA[<p>That is \(r^2\). Take its square root.</p>]]></text></truefeedback><falsescoremode>=</falsescoremode><falsescore>0.0000000</falsescore><falsepenalty></falsepenalty><falsenextnode>-1</falsenextnode><falseanswernote>prt1-4-F</falseanswernote><falsefeedback format="html"><text><![CDATA[<p>Check with the right-angled triangle whose corners are the centre of the tank, the centre of the water surface and a point on its edge. That point is on the tank, so it must be \({@exd(Rb)@}\,\text{m}\) from the centre of the tank. With your radius it is \(\sqrt{ {@ans1@}^2 + {@exd(d)@}^2} = {@dispdp(yh,3)@}\,\text{m}\) from the centre.</p>]]></text></falsefeedback></node>
  </prt>
  <prt><name>prt2</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[ylat: if ans2>0 and ans2<=6370 then float(180*acos(ans2/6370)/%pi) else 0;]]></text></feedbackvariables>
