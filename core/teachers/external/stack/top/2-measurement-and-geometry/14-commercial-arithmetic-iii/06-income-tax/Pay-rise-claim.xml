  <questionvariables>
    <text><![CDATA[kgrp(n) := block([s, out, k], s: string(n), k: slength(s), if k < 5 then s else (out: "", while k > 3 do (out: sconcat("\\,", substring(s, k-2, k+1), out), k: k-3), sconcat(substring(s, 1, k+1), out)));
ksh(v) := block([c, w, f], c: floor(100*v+1/2), w: floor(c/100), f: c-100*w, if f = 0 then kgrp(w) else sconcat(kgrp(w), ".", if f < 10 then "0" else "", string(f)));
dd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else if integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
taxf(x) := min(x,24000)*10/100 + max(0,min(x,32333)-24000)*25/100 + max(0,min(x,500000)-32333)*30/100 + max(0,min(x,800000)-500000)*65/200 + max(0,x-800000)*35/100;
payef(x) := max(0, taxf(x)-2400);
ix: 1+rand(10);
/* Design: claim-to-criticise pattern. [X1, X2]: every pair crosses from the 25% band into the 30% band. Other deductions are unchanged, so take-home pay changes by the rise minus the extra PAYE. Source: original. */
L: [[26000,34000],[29500,35000],[31000,38500],[25400,33900],[30200,36800],[27800,40000],[32000,42500],[28600,33500],[24800,37000],[31500,34600]];
E: L[ix];
X1: E[1]; X2: E[2];
nm: ["Achieng","Kiprono","Wanjiru","Omondi","Nekesa","Mutua","Chebet","Barasa","Njeri","Hassan"][ix];
p1: payef(X1);
p2: payef(X2);
rs: X2-X1;
pc: p2-p1;
inc: rs-pc;
/* diagnostics */
t1: taxf(X1);
t2: taxf(X2);
f1: X1/4-2400;
f2: 3*X2/10-2400;
f30: 7*rs/10;
g1: p1+150;
g2: p2+150;
g4: inc+600;
h2: p2+500;
h4: inc-500;
opt3: [[1, false, sconcat(nm, " is right: all of the pay is now taxed at 30%, so take-home pay falls.")], [2, true, sconcat(nm, " is wrong: only the part of the pay above Ksh 32 333 is taxed at 30%, so take-home pay rises.")], [3, false, sconcat(nm, " is right: personal relief is lost on moving into a higher band.")], [4, false, sconcat(nm, " is wrong: the rate of tax does not depend on how much you earn.")]];
]]></text>
