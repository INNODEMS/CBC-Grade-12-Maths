  b.create('text', [-3.85, 2.5, 'ξ'], {fixed: true, highlight: false, fontSize: 18, anchorY: 'middle'});
  if (shd.length > 0) {
    for (j = -7; j <= 7; j += 0.22) {
      var run = null;
      for (i = -4; i <= 4.0001; i += 0.02) {
        var x = i, y = i - j, inside = shd.indexOf(region(x, y)) >= 0;
        if (inside && run === null) { run = [x, y]; }
        if ((!inside || i > 4) && run !== null) {
          b.create('segment', [run, [x - 0.02, y - 0.02]], {fixed: true, highlight: false, layer: 1, strokeColor: '#1f5fa8', strokeWidth: 1.2, withLabel: false, point1: {visible: false}, point2: {visible: false}});
          run = null;
        }
      }
    }
  }
  for (i = 0; i < CC.length; i++) {
    b.create('circle', [[CC[i][0], CC[i][1]], CC[i][2]], {fixed: true, highlight: false, strokeColor: '#000000', strokeWidth: 1.8, fillOpacity: 0, center: {visible: false}});
    b.create('text', [LL[i][0], LL[i][1], lab[i]], {fixed: true, highlight: false, fontSize: 18, anchorX: 'middle', anchorY: 'middle', cssStyle: 'font-style:italic;'});
  }
  for (i = 0; i < txt.length; i++) {
