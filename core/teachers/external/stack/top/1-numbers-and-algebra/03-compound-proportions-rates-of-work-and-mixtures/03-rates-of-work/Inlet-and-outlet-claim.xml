  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[kgrp(n) := block([s, out, k], s: string(n), k: slength(s), if k < 5 then s else (out: "", while k > 3 do (out: sconcat("\\,", substring(s, k-2, k+1), out), k: k-3), sconcat(substring(s, 1, k+1), out)));
ksh(v) := block([c, w, f], c: floor(100*v+1/2), w: floor(c/100), f: c-100*w, if f = 0 then kgrp(w) else sconcat(kgrp(w), ".", if f < 10 then "0" else "", string(f)));
dd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else if integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
fr(v) := if integerp(v) then string(v) else sconcat("\\frac{", string(num(v)), "}{", string(denom(v)), "}");
r1(v) := floor(10*v+1/2)/10;
ix: 1+rand(10);
hm(t) := block([mn], mn: 60*t, if integerp(mn) and not integerp(t) then sconcat(string(floor(t)), " h ", string(mn-60*floor(t)), " min") else "");
/* Design: claim pattern. Source: original. [a, b, order]: pump fills in a hours, taps empty in b hours (b < 2a), and the option display order (correct never first). Curated list, one seed per entry. */
L: [[4,6,[3,2,1,4]],[3,5,[3,1,4,2]],[6,11,[1,3,4,2]],[5,9,[4,2,1,3]],[8,15,[1,4,3,2]],[6,9,[1,2,3,4]],[10,18,[4,1,2,3]],[9,12,[3,4,2,1]],[4,7,[4,3,2,1]],[12,20,[3,4,1,2]]];
E: L[ix];
a: E[1]; b: E[2]; pm: E[3];
nm: ["Akinyi","Kiprop","Wambui","Otieno","Nafula","Mwangi","Jepkosgei","Wekesa","Nyokabi","Abdi"][ix];
net: 1/a-1/b;
tt: a*b/(b-a);
/* diagnostics */
cl: b-a;
ad: a*b/(a+b);
sm: a+b;
OT: [sconcat(nm, " is right: the taps take away the difference between the two times."),
  sconcat(nm, " is wrong: each hour the tank gains only \\(\\frac{1}{", string(a), "} - \\frac{1}{", string(b), "}\\) of its volume, so it takes longer than ", string(a), " hours."),
  sconcat(nm, " is wrong: with both on, the tank fills in ", string(a), " + ", string(b), " = ", string(a+b), " hours."),
  sconcat(nm, " is wrong: the tank never fills, because water leaves as fast as it comes in.")];
opt1: makelist([pm[i], is(pm[i]=2), OT[pm[i]]], i, 1, 4);
]]></text>
