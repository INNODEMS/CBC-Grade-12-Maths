  <questionvariables>
    <text><![CDATA[/* Design: two items drawn without replacement. [r, b]; context mod(ix,2): 1 pens, 0 mangoes. Source: adapted from SMP AS/A2 Statistics 1, chapter 3, section E, E2. */
L: [[8,3],[8,4],[3,6],[4,6],[5,3],[7,2],[4,2],[5,6],[7,5],[3,5]];
ix: 1+rand(10);
r: L[ix][1]; b: L[ix][2]; n: r+b;
cx: mod(ix,2);
ta1: (r-1)/(n-1); ta2: r*(r-1)/(n*(n-1)); ta3: 2*r*b/(n*(n-1)); ta4: 1-ta2;
tl1: min(1/200,ta1/20); tl2: min(1/200,ta2/20); tl3: min(1/200,ta3/20); tl4: min(1/200,ta4/20);
/* diagnostics */
rep1: r/n; num1: (r-1)/n; den1: r/(n-1);
rep2: (r/n)^2; half2: r*(r-1)/n^2;
one3: r*b/(n*(n-1)); rep3: 2*r*b/n^2;
rep4: 1-(r/n)^2; bb4: b*(b-1)/(n*(n-1));]]></text>
  </questionvariables>
