  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[ok1: is(abs(ans1 - xi) < 1/1000 and abs(ans2 - yi) < 1/1000); sw1: is(abs(ans1 - yi) < 1/1000 and abs(ans2 - xi) < 1/1000); cu1: is(abs(ans1 - cc) < 1/1000 or abs(ans2 - cc) < 1/1000);]]></text></feedbackvariables>
