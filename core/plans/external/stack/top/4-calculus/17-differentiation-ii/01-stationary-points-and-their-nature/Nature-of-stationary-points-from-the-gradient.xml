  <questionvariables>
    <text><![CDATA[/* Design: kind "C": cubic with dy/dx = 3c(x-u)(x-w); kind "Q": quartic with dy/dx = c(x-u)^2(x-w), so x = u is a point of inflection. Source: original. */
L: [["C",2,-1,2,3],["Q",4,0,3,1],["C",-2,-2,1,4],["Q",-4,1,-2,5],["C",2,-1,3,-6],["Q",4,-1,2,0],["Q",-4,2,-1,7],["C",-1,-3,1,2],["Q",4,2,-1,-3],["Q",-4,-2,1,6]];
ix: 1+rand(10);
kd: L[ix][1]; c: L[ix][2]; u: L[ix][3]; w: L[ix][4]; dd: L[ix][5];
f: if kd="C" then expand((c)*x^3-3*(c)*((u)+(w))/2*x^2+3*(c)*(u)*(w)*x+(dd)) else expand(c*(x^4/4-(2*u+w)*x^3/3+(u^2+2*u*w)*x^2/2-u^2*w*x)+dd);
df: diff(f,x);
dfac: if kd="C" then 3*c*(x-u)*(x-w) else c*(x-u)^2*(x-w);
s1: min(u,w); s2: max(u,w);
t1: s1-1; t2: s1+1; t3: s2+1;
g1: ev(df,x=t1); g2: ev(df,x=t2); g3: ev(df,x=t3);
y1: ev(f,x=t1); y2: ev(f,x=t2); y3: ev(f,x=t3);
n1: (if g1>0 and g2<0 then 1 elseif g1<0 and g2>0 then 2 else 3);
n2: (if g2>0 and g3<0 then 1 elseif g2<0 and g3>0 then 2 else 3);
nat4: [["max4",is(n1=1),"maximum point"],["min4",is(n1=2),"minimum point"],["inf4",is(n1=3),"point of inflection"]];
wa4: if n1=1 then "min4" else "max4";
wb4: if n1=3 then "min4" else "inf4";
nat5: [["max5",is(n2=1),"maximum point"],["min5",is(n2=2),"minimum point"],["inf5",is(n2=3),"point of inflection"]];
wa5: if n2=1 then "min5" else "max5";
wb5: if n2=3 then "min5" else "inf5";
]]></text>
  </questionvariables>
