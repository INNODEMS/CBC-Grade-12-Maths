<quiz>
<question type="stack">
  <name><text>The ratio theorem in terms of a and b</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>\(\overrightarrow{OA} = \mathbf{a}\) and \(\overrightarrow{OB} = \mathbf{b}\).</p><p>(a) P divides AB internally in the ratio \({@m1@} : {@n1@}\). Find \(\overrightarrow{OP}\).</p><div>\(\overrightarrow{OP} =\) [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><p>(b) Q divides AB externally in the ratio \({@m2@} : {@n2@}\). Find \(\overrightarrow{OQ}\).</p><div>\(\overrightarrow{OQ} =\) [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>(a) Internal ratio theorem: \(\overrightarrow{OP} = \dfrac{n\mathbf{a} + m\mathbf{b}}{m + n} = {@ta1e@}\).</p><p>(b) External ratio theorem: \(\overrightarrow{OQ} = \dfrac{m\mathbf{b} - n\mathbf{a}}{m - n} = {@ta2e@}\). The coefficients add to 1 in both.</p>]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_ab(ex) := block([s, ca, cb], if not every(lambda([vv], member(vv, [a,b])), listofvars(ex)) then "Use only the vectors a and b." else (s: ev(expand(ex), simp), ca: ev(coeff(s,a), simp), cb: ev(coeff(s,b), simp), if ev(is(s - ca*a - cb*b = 0), simp) and ev(numberp(float(ca)) and numberp(float(cb)), simp) then "" else "Write your answer as a number times a plus a number times b, for example 3/5*a+2/5*b."));
texput(a,"\\mathbf{a}"); texput(b,"\\mathbf{b}");
/* Design: the ratio theorem in terms of a and b. Diagnostics are distinct as coefficient pairs on every entry. Source: original. */
rlist: [[[2,3],[3,1]],[[3,1],[1,3]],[[1,4],[5,2]],[[3,2],[2,1]],[[1,2],[4,1]],[[2,1],[1,2]],[[4,1],[3,2]],[[3,4],[2,5]],[[5,2],[1,4]],[[1,3],[5,3]]];
ix: 1+rand(10);
m1: rlist[ix][1][1]; n1: rlist[ix][1][2]; m2: rlist[ix][2][1]; n2: rlist[ix][2][2];
ta1: (n1*a+m1*b)/(m1+n1); cr1: (m1*a+n1*b)/(m1+n1); nd1: n1*a+m1*b;
ta2: (m2*b-n2*a)/(m2-n2); in2: (n2*a+m2*b)/(m2+n2); sg2: (n2*a+m2*b)/(m2-n2); sw2: (n2*b-m2*a)/(n2-m2);
ta1e: expand(ta1); ta2e: expand(ta2);
w1: ta1+a; w2: ta2+b;
]]></text>
  </questionvariables>
