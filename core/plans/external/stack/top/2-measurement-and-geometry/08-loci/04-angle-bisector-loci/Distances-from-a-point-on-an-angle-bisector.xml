<quiz>
<question type="stack">
  <name><text>Distances from a point on an angle bisector</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>\(P\) is a point on the bisector of angle \(XOY\). \(F\) on \(OX\) and \(G\) on \(OY\) are the feet of the perpendiculars from \(P\). \(PF = {@a@}\) cm and \(OP = {@c@}\) cm.</p><div style="text-align:center;" role="img" aria-label="Angle XOY with vertex O and its bisector drawn dashed. P is on the bisector. F on OX and G on OY are the feet of the perpendiculars from P, with right-angle marks at F and G. PF = {#a#} cm and OP = {#c#} cm. The diagram is not to scale.">
[[jsxgraph width="360px" height="230px"]]
(function () {
  var ang = {#float(ang)#} * Math.PI / 180, h = ang / 2, R = 6.2, op = 4.2;
  var b = JXG.JSXGraph.initBoard(divid, {boundingbox: [-5, 6.4, 7.2, -1.2], keepAspectRatio: true, axis: false, grid: false,
    showNavigation: false, showCopyright: false, pan: {enabled: false}, zoom: {enabled: false}});
  var st = {fixed: true, highlight: false};
  var O = b.create('point', [0, 0], {name: 'O', fixed: true, size: 2, color: '#000000', label: {offset: [-6, -14]}});
  var X = b.create('point', [R, 0], {name: 'X', fixed: true, size: 0, label: {offset: [4, -10]}});
  var Y = b.create('point', [R * Math.cos(ang), R * Math.sin(ang)], {name: 'Y', fixed: true, size: 0, label: {offset: [-14, 6]}});
  b.create('segment', [O, X], {strokeColor: '#000000', strokeWidth: 2, fixed: true, highlight: false});
  b.create('segment', [O, Y], {strokeColor: '#000000', strokeWidth: 2, fixed: true, highlight: false});
  b.create('segment', [O, [R * Math.cos(h), R * Math.sin(h)]], {strokeColor: '#1f4e9c', strokeWidth: 1.5, dash: 2, fixed: true, highlight: false});
  var P = b.create('point', [op * Math.cos(h), op * Math.sin(h)], {name: 'P', fixed: true, size: 2, color: '#b00000', label: {offset: [6, 6]}});
  var fx = op * Math.cos(h), gd = op * Math.cos(h);
  var F = b.create('point', [fx, 0], {name: 'F', fixed: true, size: 2, color: '#000000', label: {offset: [-4, -14]}});
  var G = b.create('point', [gd * Math.cos(ang), gd * Math.sin(ang)], {name: 'G', fixed: true, size: 2, color: '#000000', label: {offset: [-14, 4]}});
  b.create('segment', [P, F], {strokeColor: '#b00000', strokeWidth: 1.5, fixed: true, highlight: false});
  b.create('segment', [P, G], {strokeColor: '#b00000', strokeWidth: 1.5, fixed: true, highlight: false});
  b.create('segment', [O, P], {strokeColor: '#b00000', strokeWidth: 1, fixed: true, highlight: false});
  b.create('angle', [X, F, P], {type: 'square', radius: 0.35, name: '', withLabel: false, fixed: true, fillOpacity: 0, strokeColor: '#000000'});
  b.create('angle', [P, G, O], {type: 'square', radius: 0.35, name: '', withLabel: false, fixed: true, fillOpacity: 0, strokeColor: '#000000'});
})();
