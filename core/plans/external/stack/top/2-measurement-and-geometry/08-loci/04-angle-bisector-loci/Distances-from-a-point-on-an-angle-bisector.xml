  <questionvariables>
    <text><![CDATA[/* Design: distances from a point on an angle bisector. Entries are triples [PF, OF, OP]; this chapter's (6, 8, 10) and (8, 15, 17) are excluded. PRT1 has no diagnostic: the only error is not using the bisector property, which the generic feedback names. Source: original. */
q41: [[3,4,5],[4,3,5],[5,12,13],[12,5,13],[7,24,25],[20,21,29],[21,20,29],[9,40,41],[12,35,37],[15,8,17]];
ix: 1+rand(10);
a: q41[ix][1]; bb: q41[ix][2]; c: q41[ix][3];
ang: 2*asin(a/c)*180/%pi;
/* diagnostics (c): angle XOP only; cosine used for the half-angle */
dh: ang/2;
dc: 2*acos(a/c)*180/%pi;]]></text>
  </questionvariables>
