<quiz>
<question type="stack">
  <name><text>Finding an object from its image</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>The matrix \(M = {@Mt@}\) maps a point P onto \(P'({@img[1]@},\,{@img[2]@})\).</p><p>(a) Find \(M^{-1}\).</p><div>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</div><p>(b) Find the coordinates of P.</p><div>( [[input:ans2]] , [[input:ans3]] ) [[validation:ans2]] [[validation:ans3]] [[feedback:prt2]]</div>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>(a) \(\det M = ad - bc = {@dm@}\). Swap a and d, change the signs of b and c, and divide by the determinant:</p><p>\(M^{-1} = \dfrac{1}{{@dm@}}{@dAdj@} = {@ta@}\)</p><p>(b) The inverse undoes the transformation, so it sends the image point back to where it came from: \(M^{-1}{@ic@} = {@ta.ic@}\). So P is \(({@tp[1]@},\,{@tp[2]@})\).</p><p>Check: \({@Mt@}{@ta.ic@} = {@ic@}\).</p>]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Type a number in each box, not a letter.");
near(L,T) := is(abs(L[1]-T[1]) + abs(L[2]-T[2]) < 0.001);
/* Design: find the inverse, then apply it to find the object. Source: adapted from SMP Book 5 (Metric), Chapter 14, Section 4.1 and Exercise B, question 5. det M = 2 or -2 (5 of each), so M^-1 has entries in halves and P has integer coordinates. */
mlist: [[matrix([-1,-1],[3,1]),[-3,5]],[matrix([0,-1],[-2,-1]),[0,-6]],[matrix([1,1],[-4,-2]),[7,-20]],[matrix([2,2],[2,3]),[8,10]],[matrix([2,-1],[2,-2]),[-9,-12]],[matrix([5,-1],[-2,0]),[14,-6]],[matrix([-2,2],[-4,5]),[4,9]],[matrix([-1,3],[-1,1]),[2,2]],[matrix([5,-2],[4,-2]),[26,22]],[matrix([-3,5],[1,-1]),[14,-4]]];
ix: 1+rand(10);
Mt: mlist[ix][1]; img: mlist[ix][2];
ic: transpose(matrix(img));
dm: determinant(Mt);
ta: invert(Mt);
tp: list_matrix_entries(ta.ic);
/* diagnostics: not divided by det; signs changed but a, d not swapped; all signs reversed; M applied to P' */
dAdj: matrix([Mt[2,2],-Mt[1,2]],[-Mt[2,1],Mt[1,1]]);
dNS: (1/dm)*matrix([Mt[1,1],-Mt[1,2]],[-Mt[2,1],Mt[2,2]]);
dSg: -ta;
pM: list_matrix_entries(Mt.ic); pAdj: list_matrix_entries(dAdj.ic); pSg: list_matrix_entries(dSg.ic);
/* tests: the inverse rebuilt from the formula; the same in decimals; generic offsets */
tr: (1/(Mt[1,1]*Mt[2,2]-Mt[1,2]*Mt[2,1]))*dAdj;
trd: float(tr);
tw: ta+matrix([1,0],[0,0]); tpw: tp+[0,1];
]]></text>
  </questionvariables>
