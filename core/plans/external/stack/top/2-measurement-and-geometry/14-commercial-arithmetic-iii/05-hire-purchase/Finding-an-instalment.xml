<quiz>
<question type="stack">
  <name><text>Finding an instalment</text></name>
  <questiontext format="html">
    <text><![CDATA[<p>A {@itm@} costs Ksh \({@ksh(C)@}\) cash. Its hire purchase price is Ksh \({@ksh(H)@}\): a deposit of Ksh \({@ksh(Dep)@}\) and then \({@k@}\) equal monthly instalments.</p><p>(a) Find the total of the instalments.</p><p>Ksh [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</p><p>(b) Find each instalment.</p><p>Ksh [[input:ans2]] [[validation:ans2]] [[feedback:prt2]]</p>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>(a) The instalments pay the hire purchase price after the deposit: \({@ksh(H)@} - {@ksh(Dep)@} = {@ksh(Ti)@}\).</p><p>(b) Each instalment is \({@ksh(Ti)@} \div {@k@} = {@ksh(m)@}\).</p>]]></text>
  </generalfeedback>
  <defaultgrade>2</defaultgrade>
  <penalty>0.1</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[kgrp(n) := block([s, out, k], s: string(n), k: slength(s), if k < 5 then s else (out: "", while k > 3 do (out: sconcat("\\,", substring(s, k-2, k+1), out), k: k-3), sconcat(substring(s, 1, k+1), out)));
ksh(v) := block([c, w, f], c: floor(100*v+1/2), w: floor(c/100), f: c-100*w, if f = 0 then kgrp(w) else sconcat(kgrp(w), ".", if f < 10 then "0" else "", string(f)));
dd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else if integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
ix: 1+rand(10);
/* Design: [item, cash C, HP price H, deposit, k]; every instalment is a whole number of shillings. Source: original. */
L: [["cooker",31000,36400,5200,12],["motorbike",152000,183000,30000,18],["fridge",39500,45900,6000,15],["television",28000,33300,3300,10],["laptop",58000,69000,9000,20],["posho mill",96000,112800,15000,12],["water pump",24500,28700,3500,9],["sofa set",47000,54600,7800,12],["phone",19600,23400,3000,8],["bed and mattress",33000,38750,5000,15]];
E: L[ix];
itm: E[1]; C: E[2]; H: E[3]; Dep: E[4]; k: E[5];
Ti: H-Dep;
m: Ti/k;
/* diagnostics */
cd: C-Dep;
X: H-C;
mc: (C-Dep)/k;
mh: H/k;
mk: Ti/(k-1);
t2: Ti+1200;
ft2v: (Ti+1200)/k;
]]></text>
  </questionvariables>
  <specificfeedback format="html"><text><![CDATA[]]></text></specificfeedback>
  <questionnote format="moodle_auto_format">
    <text>ix={@ix@}, m={@m@}</text>
  </questionnote>
