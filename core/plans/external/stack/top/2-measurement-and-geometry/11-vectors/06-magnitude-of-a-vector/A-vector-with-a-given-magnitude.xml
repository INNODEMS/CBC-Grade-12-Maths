good: is(abs(msq - M^2) < 10^-6);
nz: is(abs(float(u[1])) > 10^-9 and abs(float(u[2])) > 10^-9);
su: ev(u[1]^2+u[2]^2, simp);
]]></text></feedbackvariables>
