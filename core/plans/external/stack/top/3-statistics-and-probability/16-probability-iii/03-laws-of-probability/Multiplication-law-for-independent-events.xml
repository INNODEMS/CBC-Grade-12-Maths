  <stackversion><text>2026063000</text></stackversion>
  <questionvariables>
    <text><![CDATA[/* pdec: exact decimal display of a value with at most 4 decimal places */
pdec(v) := if integerp(v) then v elseif integerp(10*v) then dispdp(float(v),1) elseif integerp(100*v) then dispdp(float(v),2) elseif integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
/* Design: two independent events; three parts: both, neither, one but not the other. Entries in hundredths [p, q]. Source: adapted from SMP AS/A2 Statistics 1, chapter 3, Exercise D question 2. */
L: [[45,40],[30,90],[55,70],[55,35],[10,70],[10,30],[35,45],[10,40],[55,75],[60,55]];
ix: 1+rand(10);
p: L[ix][1]/100; q: L[ix][2]/100;
/* context per entry, chosen so the numbers are plausible (review): 0 machines need a repair in a month, 1 solar lamps fail in the first year, 2 tree seedlings survive the dry season */
CX: [0,2,2,0,1,1,0,1,2,2];
cx: CX[ix];
ta1: p*q; ta2: (1-p)*(1-q); ta3: p*(1-q);
tl1: min(1/200,ta1/20); tl2: min(1/200,ta2/20); tl3: min(1/200,ta3/20);
/* diagnostics */
add1: p+q;
notboth2: 1-p*q;
just3: p;
swap3: (1-p)*q;
both3: p*q;]]></text>
  </questionvariables>
