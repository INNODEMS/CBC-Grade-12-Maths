  <questionvariables>
    <text><![CDATA[/* pdec: exact decimal display of a value with at most 4 decimal places */
pdec(v) := if integerp(v) then v elseif integerp(10*v) then dispdp(float(v),1) elseif integerp(100*v) then dispdp(float(v),2) elseif integerp(1000*v) then dispdp(float(v),3) else dispdp(float(v),4);
/* Design: listing outcomes of coins, with "at least one" and "none" parts. [n, j, c, cx]: c 1 "at least one", 0 "none"; cx 0 coin, 1 spinner, 2 guessing. Source: adapted from SMP GCSE Foundation book 1, chapter 19, section B, B5 and B6. */
C: [[2,1,1,0],[2,1,0,1],[3,1,1,2],[3,2,1,0],[3,1,0,1],[3,2,0,2],[2,1,1,2],[3,2,1,1],[3,1,1,0],[2,1,0,0]];
ix: 1+rand(10);
n: C[ix][1]; j: C[ix][2]; c: C[ix][3]; cx: C[ix][4];
ta1: 2^n;
ta2: binomial(n,j)/2^n;
ta3: if c=1 then 1-1/2^n else 1/2^n;
tl2: min(1/200,ta2/20); tl3: min(1/200,ta3/20);
/* diagnostics */
cnt1: n+1;
dn1: n;
eqc2: 1/(n+1);
one2: 1/2^n;
eqc3: if c=1 then n/(n+1) else 1/(n+1);
oth3: if c=1 then 1/2^n else 1-1/2^n;
/* the outcome list for the worked solution */
lt: if cx=0 then ["H","T"] elseif cx=1 then ["B","W"] else ["R","W"];
outs: if n=2 then flatten(makelist(makelist(sconcat(u,v), v, lt), u, lt)) else flatten(makelist(makelist(makelist(sconcat(u,v,z), z, lt), v, lt), u, lt));
ol: simplode(outs, ", ");]]></text>
  </questionvariables>
