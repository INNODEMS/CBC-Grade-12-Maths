  <questionvariables>
    <text><![CDATA[/* exd: shortest exact decimal display of a terminating value (up to 3 d.p.) */
exd(v) := if integerp(v) then v else if integerp(10*v) then dispdp(float(v),1) else if integerp(100*v) then dispdp(float(v),2) else dispdp(float(v),3);
/* Design: using class limits for both quartiles gives the right IQR (the half-unit errors cancel). A learner who subtracts the 1 d.p. quartiles, or halves a rounded IQR, is marked right: prt3 tests against whichever of iqr and iqralt is nearer; prt4 against the nearest of qd, iqrr/2 and iqralt/2. All three alternatives are more than 0.1 from every diagnostic on all 10 lists. Source: original. */
flist: [[3,10,11,16,20,13],[3,9,20,18,14,7],[9,15,16,13,8,8],[4,9,9,18,12,6],[10,13,19,16,9,6],[5,17,19,20,8,6],[10,11,18,14,12,9],[8,15,19,10,7,6],[13,15,16,11,8,4],[14,14,19,15,11,6]];
ix: 1+rand(10);
f: flist[ix];
lo1: rand([10,20,30]);
w: 10;
L1: lo1-1/2;
cf: makelist(sum(f[i],i,1,t),t,1,length(f));
n: last(cf);
lcb: makelist(L1+(t-1)*w,t,1,length(f));
cb(p) := 1+length(sublist(cf,lambda([c],is(c<p))));
cfb(k) := if k=1 then 0 else cf[k-1];
gq(p) := lcb[cb(p)] + (p-cfb(cb(p)))/f[cb(p)]*w;
lo: makelist(lo1+(t-1)*w,t,1,6);
hi: makelist(lo1+t*w-1,t,1,6);
p1: n/4; p3: 3*n/4;
k1: cb(p1); k3: cb(p3);
q1: gq(p1); q3: gq(p3);
iqr: q3-q1;
qd: iqr/2;
q1d: dispdp(float(floor(10^1*(q1)+1/2)/10^1),1);
q3d: dispdp(float(floor(10^1*(q3)+1/2)/10^1),1);
iqrd: dispdp(float(floor(10^1*(iqr)+1/2)/10^1),1);
iqr2d: dispdp(float(floor(10^2*(iqr)+1/2)/10^2),2);
qdd: dispdp(float(floor(10^1*(qd)+1/2)/10^1),1);
/* diagnostics */
q1lim: q1+1/2; q1own: q1-w;
q3lim: q3+1/2; q3own: q3-w;
iqrsum: q3+q1;
qdavg: (q3+q1)/2;
/* test values */
q1r: float(floor(10^1*(q1)+1/2)/10^1);
q3r: float(floor(10^1*(q3)+1/2)/10^1);
iqrr: float(floor(10^1*(iqr)+1/2)/10^1);
qdr: float(floor(10^1*(qd)+1/2)/10^1);
iqralt: q3r-q1r;
iqraltd: dispdp(iqralt,1);
qdalts: [qd, iqrr/2, iqralt/2];
q1limr: float(floor(10^1*(q1lim)+1/2)/10^1);
q3limr: float(floor(10^1*(q3lim)+1/2)/10^1);
q1ownr: float(floor(10^1*(q1own)+1/2)/10^1);
iqrsumr: float(floor(10^1*(iqrsum)+1/2)/10^1);
qdavgr: float(floor(10^1*(qdavg)+1/2)/10^1);
gq1: -q1r; gq3: -q3r; giqr: -iqrr-1; gqd: -qdr-1;
fq1: q1r+1; fiqr: q3r-q1r-1; fqd: (q3r-q1r-1)/2;]]></text>
  </questionvariables>
